{ useState, useMemo } from react

export interface UserStats {
  id: string
  name: string
  score: number | undefined
  tags: string[]
}

export class ScoreTracker {
  count: number = 0

  increment(): number {
    @count += 1
    @count
  }

  getSnapshot(): { count: number } {
    return { @count }
  }
}

export function evaluateUser(user: UserStats, threshold: number): boolean {
  total .= user.tags#

  unless threshold {
    return false
  }

  for tag of user.tags {
    if tag# > 0
      total += tag#
  }

  tracker := new ScoreTracker()
  isString := typeof user.name is "string"
  isQualified := total >= threshold

  isQualified
}
