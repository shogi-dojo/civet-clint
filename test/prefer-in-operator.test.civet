import { describe, it, expect } from "vitest"
import { lintSource, compileSource } from "../src/engine.civet"

RULE := "style/prefer-in-operator"

function fix(source: string)
  lintSource(source, {
    rules: { [RULE]: "error", "style/prefer-word-operators": "off" }
    fix: true
  })

describe RULE, ->
  it "rewrites includes calls to positive and negated membership syntax", ->
    source := "x := values.includes(value)\ny := !values.includes(value)\n"
    res := fix(source)
    expect(res.fixedSource).toBe("x := value is in values\ny := value is not in values\n")
    expect(res.isEquivalencePreserved).toBe(true)
    expect(compileSource(source)).toBe(compileSource(res.fixedSource!))

  it "supports member expressions as receivers", ->
    res := fix("found := state.values.includes(item)\n")
    expect(res.fixedSource).toBe("found := item is in state.values\n")
    expect(res.isEquivalencePreserved).toBe(true)

  it "leaves optional chains, other methods, and multi-argument calls alone", ->
    source := "a := values?.includes(value)\nb := values.indexOf(value)\nc := values.includes(a, b)\n"
    res := fix(source)
    expect(res.fixedSource).toBeUndefined()
    expect(res.isEquivalencePreserved).toBe(true)


  it "preserves unless rather than consuming its synthetic negation", ->
    source := "f := (values, value) =>\n  return false unless values.includes(value)\n  true\n"
    result := fix(source)
    expect(result.fixedSource).toContain("return false unless value is in values")
    expect(result.isEquivalencePreserved).toBe(true)
    expect(compileSource(result.fixedSource!)).toBe(compileSource(source))


  it "does not move an argument's negation onto membership", ->
    source := "x := values.includes(!value)\n"
    expect(fix(source).fixedSource).toBeUndefined()


  it "preserves negation before an implicit call in a function tail", ->
    source := "f := (values, value) =>\n  return false unless values.includes value\n  not values.includes value\n"
    result := fix(source)
    expect(result.fixedSource).toContain("return false unless value is in values")
    expect(result.fixedSource).toContain("value is not in values")
    expect(result.isEquivalencePreserved).toBe(true)
    expect(compileSource(result.fixedSource!)).toBe(compileSource(source))

describe `${RULE} operand shapes`, ->
  it "gives an implicit-call operand its own parens", ->
    source := "f := (ids, item) => ids.includes(Number item.id) and item.ok\ng := (a, c) => c? and a.o.includes Number c\n"
    result := fix(source)
    expect(result.fixedSource).toBe("f := (ids, item) => Number(item.id) is in ids and item.ok\ng := (a, c) => c? and Number(c) is in a.o\n")
    expect(result.isEquivalencePreserved).toBe(true)
    expect(compileSource(result.fixedSource!)).toBe(compileSource(source))

  it "keeps every argument of an implicit call in its parens", ->
    source := "x := a.includes(f g, h)\n"
    result := fix(source)
    expect(result.fixedSource).toBe("x := f(g, h) is in a\n")
    expect(compileSource(result.fixedSource!)).toBe(compileSource(source))

  it "braces a bare JSX attribute value", ->
    source := "x := <b aria-checked=p.codes.includes(o.code) role=\"radio\">\n"
    result := lintSource(source, { rules: { [RULE]: "error" }, fix: true, civetOptions: { solid: true } })
    expect(result.fixedSource).toBe("x := <b aria-checked={o.code is in p.codes} role=\"radio\">\n")
    expect(result.isEquivalencePreserved).toBe(true)

  it "reports an operand looser than membership without a fix", ->
    for source of ["x := a.includes(b or c)\n", "x := a.includes(b ? c : d)\n", "x := a.includes(b is c)\n"]
      result := fix(source)
      expect(result.diagnostics.map (d) -> [d.ruleId, d.fix?]).toEqual([[RULE, false]])
      expect(result.fixedSource).toBeUndefined()

  it "still fixes an operand that binds tighter", ->
    result := fix("x := a.includes(b + c)\n")
    expect(result.fixedSource).toBe("x := b + c is in a\n")
    expect(result.isEquivalencePreserved).toBe(true)

  it "fixes a call whose argument is a string, but not one inside a string or comment", ->
    source := "f := (s) =>\n  return [25] if s.includes 'chiitoitsu'\n  s.includes(\"a\")\nx := 'a.includes(b)' // c.includes(d)\n"
    result := fix(source)
    expect(result.fixedSource).toBe("f := (s) =>\n  return [25] if 'chiitoitsu' is in s\n  \"a\" is in s\nx := 'a.includes(b)' // c.includes(d)\n")
    expect(result.isEquivalencePreserved).toBe(true)
    expect(compileSource(result.fixedSource!)).toBe(compileSource(source))
