import { describe, it, expect, beforeEach, afterEach } from "vitest"
import fs from "node:fs/promises"
import path from "node:path"
import os from "node:os"
import { parseCliArgs, findCivetFiles, formatTextReport, runCli } from "../src/cli.civet"

describe "CLI Suite", ->
  it "publishes the civet-clint package with the clint executable", async ->
    manifest := JSON.parse(await fs.readFile(path.join(process.cwd(), "package.json"), "utf8"))
    expect(manifest.name).toBe("civet-clint")
    expect(manifest.bin).toEqual({ clint: "./bin/civet-clint.js" })
    // Asserting the shape rather than a literal keeps release bumps from
    // breaking this test while still catching a malformed version field.
    expect(manifest.version).toMatch(/^\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?$/)

  it "prints version with --version", async ->
    manifest := JSON.parse(await fs.readFile(path.join(process.cwd(), "package.json"), "utf8"))
    originalLog := console.log
    captured: string[] := []
    console.log = (...args) -> captured.push(args.join(" "))
    var code = 2
    try
      code = await runCli(["--version"])
    finally
      console.log = originalLog
    expect(code).toBe(0)
    // The CLI must report the manifest version, not a hardcoded constant.
    expect(captured.join("\n")).toContain(manifest.version)

  it "parses command line arguments correctly", ->
    opts := parseCliArgs(["--write", "--config", "./custom.json", "--format=json", "src", "test/file.civet"])
    expect(opts.write).toBe(true)
    expect(opts.config).toBe("./custom.json")
    expect(opts.format).toBe("json")
    expect(opts.targets).toEqual(["src", "test/file.civet"])
    expect(opts.errors).toEqual([])

  it "rejects unknown options and missing targets", async ->
    expect(await runCli(["--wat"])).toBe(2)
    expect(await runCli(["/definitely/not/a/civet/path"])).toBe(2)

  it "discovers .civet files while ignoring node_modules and dist", async ->
    tmpDir := await fs.mkdtemp(path.join(os.tmpdir(), "civet-clint-disc-"))
    await fs.mkdir(path.join(tmpDir, "src"), { recursive: true })
    await fs.mkdir(path.join(tmpDir, "node_modules", "pkg"), { recursive: true })
    await fs.mkdir(path.join(tmpDir, "dist"), { recursive: true })

    f1 := path.join(tmpDir, "src", "a.civet")
    f2 := path.join(tmpDir, "src", "b.civet")
    ignored1 := path.join(tmpDir, "node_modules", "pkg", "c.civet")
    ignored2 := path.join(tmpDir, "dist", "d.civet")

    await fs.writeFile(f1, "x := 1")
    await fs.writeFile(f2, "y := 2")
    await fs.writeFile(ignored1, "z := 3")
    await fs.writeFile(ignored2, "w := 4")

    files := await findCivetFiles([tmpDir], tmpDir)
    expect(files).toContain(f1)
    expect(files).toContain(f2)
    expect(files).not.toContain(ignored1)
    expect(files).not.toContain(ignored2)

    await fs.rm(tmpDir, { recursive: true, force: true })

  it "runs CLI in check and write modes on temporary directories", async ->
    tmpDir := await fs.mkdtemp(path.join(os.tmpdir(), "civet-clint-run-"))
    testFile := path.join(tmpDir, "sample.civet")
    await fs.writeFile(testFile, "a === b and () => 123", "utf8")

    // Check mode
    codeCheck := await runCli(["--check", testFile])
    expect(codeCheck).toBe(1)

    // Write mode
    codeWrite := await runCli(["--write", testFile])
    expect(codeWrite).toBe(0)

    updatedContent := await fs.readFile(testFile, "utf8")
    expect(updatedContent).toBe("a is b and => 123")

    // Check again after write should be 0
    codeCheckAfter := await runCli(["--check", testFile])
    expect(codeCheckAfter).toBe(0)

    await fs.rm(tmpDir, { recursive: true, force: true })

  it "prints the resolved config and skips incompatible rules with --print-config", async ->
    tmpDir := await fs.mkdtemp(path.join(os.tmpdir(), "civet-clint-printcfg-"))
    await fs.writeFile(path.join(tmpDir, "civet.json"), JSON.stringify({
      parseOptions: { coffeeIsnt: true, coffeeEq: true }
    }))
    await fs.writeFile(path.join(tmpDir, "civet-clint.config.json"), JSON.stringify({
      preset: "default"
      civetConfig: "./civet.json"
      rules: {
        "style/prefer-jsx-shorthand": "error"
        "style/no-is-not": "warn"
      }
    }))

    // Capture stdout. runCli logs via console.log; hook it temporarily.
    originalLog := console.log
    captured: string[] := []
    console.log = (...args) -> captured.push(args.join(" "))
    var code = 2
    try
      code = await runCli(["--print-config", "--config", path.join(tmpDir, "civet-clint.config.json")])
    finally
      console.log = originalLog

    expect(code).toBe(0)
    payload := JSON.parse(captured.join("\n"))
    expect(payload.preset).toBe("default")
    expect(payload.civetOptions.coffeeIsnt).toBe(true)
    expect(payload.civetOptions.coffeeEq).toBe(true)
    expect(payload.rules["style/prefer-jsx-shorthand"]).toBe("error")
    // react is not in the dial, so the JSX rule must be skipped.
    skippedIds := payload.skippedRules.map (s) -> s.ruleId
    expect(skippedIds).toContain("style/prefer-jsx-shorthand")
    // no-is-not requires coffeeIsnt, which IS present, so it must not be skipped.
    expect(skippedIds).not.toContain("style/no-is-not")

    await fs.rm(tmpDir, { recursive: true, force: true })

  it "does not report stripped execution-mode options as active", async ->
    // The adapter refuses `sync`/`ast` from project config; printing them as
    // active would misreport what the compiler actually runs with.
    tmpDir := await fs.mkdtemp(path.join(os.tmpdir(), "civet-clint-stripped-"))
    await fs.writeFile(path.join(tmpDir, "civet.json"), JSON.stringify({
      parseOptions: { coffeeEq: true }
      js: true
      sync: false
      ast: "raw"
    }))
    await fs.writeFile(path.join(tmpDir, "civet-clint.config.json"), JSON.stringify({
      preset: "default"
      civetConfig: "./civet.json"
    }))

    originalLog := console.log
    captured: string[] := []
    console.log = (...args) -> captured.push(args.join(" "))
    var code = 2
    try
      code = await runCli(["--print-config", "--config", path.join(tmpDir, "civet-clint.config.json")])
    finally
      console.log = originalLog

    expect(code).toBe(0)
    payload := JSON.parse(captured.join("\n"))
    expect(payload.compileOptions.js).toBe(true)
    expect(payload.compileOptions.sync).toBeUndefined()
    expect(payload.compileOptions.ast).toBeUndefined()
    expect(payload.ignoredCompileOptions).toContain("sync")
    expect(payload.ignoredCompileOptions).toContain("ast")

    await fs.rm(tmpDir, { recursive: true, force: true })
