import { describe, it, expect } from "vitest"
import { lintSource } from "../src/engine.civet"

RULE := "style/prefer-postfix-conditional"
DIAL := { react: true }

function lint(source: string)
  lintSource(source, { rules: { [RULE]: "warn" }, fix: false, civetOptions: DIAL })

findings := (source: string) ->
  lint(source).diagnostics.filter (d) -> d.ruleId is RULE

describe "style/prefer-postfix-conditional", ->
  it "reports 'if (a) return' with suggestion 'return if a'", ->
    diags := findings("if (a) return\n")
    expect(diags).toHaveLength(1)
    expect(diags[0].message).toContain("return if a")
    expect(diags[0].message).toContain("autofix disabled")

  it "reports 'if a return x' with suggestion 'return x if a'", ->
    diags := findings("if a return x\n")
    expect(diags).toHaveLength(1)
    expect(diags[0].message).toContain("return x if a")

  it "reports 'if (a) return x + 1' with suggestion 'return x + 1 if a'", ->
    diags := findings("if (a) return x + 1\n")
    expect(diags).toHaveLength(1)
    expect(diags[0].message).toContain("return x + 1 if a")

describe "style/prefer-postfix-conditional guards", ->
  it "leaves multi-line if statement alone", ->
    expect(findings("if (a)\n  return\n")).toHaveLength(0)

  it "leaves already-postfix 'return if a' alone", ->
    expect(findings("return if a\n")).toHaveLength(0)

  it "leaves comments alone", ->
    expect(findings("// if (a) return\n")).toHaveLength(0)

  it "leaves strings alone", ->
    expect(findings("s := \"if (a) return\"\n")).toHaveLength(0)
