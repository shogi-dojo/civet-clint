import { describe, it, expect } from "vitest"
import { lintSource, compileSource, normalizeBlockBraceStyle } from "../src/engine.civet"

RULE := "style/prefer-postfix-conditional"
DIAL := { autoLet: true }

function fix(source: string)
  lintSource(source, { rules: { [RULE]: "error" }, fix: true, civetOptions: DIAL })

function expectEquivalent(source: string)
  res := fix(source)
  fixed := res.fixedSource ?? source
  expect(res.isEquivalencePreserved).toBe(true)
  expect(normalizeBlockBraceStyle(compileSource(fixed, DIAL)))
    .toBe(normalizeBlockBraceStyle(compileSource(source, DIAL)))
  fixed

function unchanged(source: string)
  res := fix(source)
  expect(res.fixedSource ?? source).toBe(source)

describe "normalizeBlockBraceStyle", ->
  it "strips a brace pair wrapping a single statement after ')'", ->
    expect(normalizeBlockBraceStyle("if (a) { return }")).toBe("if (a) return")
    expect(normalizeBlockBraceStyle("if (a) { return x }")).toBe("if (a) return x")

  it "leaves an object literal alone", ->
    // Anchored on `) {`, so a value position keeps its braces.
    expect(normalizeBlockBraceStyle("const o = { a: 1 }")).toBe("const o = { a: 1 }")

  it "leaves a multi-statement block alone", ->
    expect(normalizeBlockBraceStyle("if (a) { g(); h() }")).toBe("if (a) { g(); h() }")

  it "leaves a block spanning lines alone", ->
    expect(normalizeBlockBraceStyle("if (a) {\n  return\n}")).toBe("if (a) {\n  return\n}")

  it "leaves nested braces alone", ->
    expect(normalizeBlockBraceStyle("if (a) { { return } }")).toBe("if (a) { { return } }")

  it "leaves an empty block alone", ->
    expect(normalizeBlockBraceStyle("if (a) {  }")).toBe("if (a) {  }")

  it "does not reach inside strings or comments", ->
    expect(normalizeBlockBraceStyle('const s = ") { return }"')).toBe('const s = ") { return }"')
    expect(normalizeBlockBraceStyle("// if (a) { return }")).toBe("// if (a) { return }")

describe "style/prefer-postfix-conditional", ->
  it "rewrites a bare return", ->
    expect(expectEquivalent("f = =>\n  if (a) return\n  g()\n"))
      .toBe("f = =>\n  return if a\n  g()\n")

  it "rewrites a returned value", ->
    expect(expectEquivalent("f = =>\n  if (a) return x\n  g()\n"))
      .toBe("f = =>\n  return x if a\n  g()\n")

  it "is idempotent", ->
    once := fix("f = =>\n  if (a) return x\n  g()\n").fixedSource!
    twice := fix(once)
    expect(twice.fixedSource).toBeUndefined()
    expect(twice.diagnostics.filter((d) -> d.ruleId is RULE)).toHaveLength(0)

  it "names the byte-identical alternative in its message", ->
    res := lintSource("f = =>\n  if (a) return x\n  g()\n", { rules: { [RULE]: "error" }, civetOptions: DIAL })
    found := res.diagnostics.find (d) -> d.ruleId is RULE
    expect(found?.message).toContain("if a then return x")

describe "style/prefer-postfix-conditional exclusions", ->
  it "leaves an if/else one-liner", ->
    // The else branch has nowhere to go in the postfix form.
    unchanged("f = =>\n  if (a) return x else g()\n  h()\n")

  it "leaves a multi-line if", ->
    unchanged("f = =>\n  if (a)\n    return x\n  g()\n")

  it "leaves an if whose body is not a return", ->
    unchanged("f = =>\n  if (a) g()\n  h()\n")

  it "defers a negated condition to style/prefer-unless", ->
    // Both rules match `if (not x) return` and rewrite the same span in opposite
    // directions. Deferring here is what keeps a file containing both shapes
    // fixable: with a third rule also editing it, the combined replay diverges and
    // the engine rejects the entire batch.
    unchanged("f = =>\n  if (not a) return\n  g()\n")
    // The `!` spelling needs prefer-word-operators off, or that rule turns it into
    // `not a` first and the assertion measures the wrong rewrite.
    bang := "f = =>\n  if (!a) return\n  g()\n"
    res := lintSource(bang, {
      rules: { [RULE]: "error", "style/prefer-word-operators": "off" }
      fix: true
      civetOptions: DIAL
    })
    expect(res.fixedSource ?? bang).toBe(bang)

  it "still rewrites a condition that merely contains 'not' later on", ->
    // The guard is anchored, so `a is not b` is not mistaken for a negated head.
    expect(fix("f = =>\n  if (a isnt b) return\n  g()\n").fixedSource)
      .toBe("f = =>\n  return if a isnt b\n  g()\n")
