import { describe, it, expect } from "vitest"
import { lintSource } from "../src/engine.civet"
import { compileForOutput } from "../src/compiler.civet"

DIAL := { autoLet: true, coffeeComment: true, react: true }

lint := (input: string, fix = true) ->
  lintSource(input, {
    rules: { "style/prefer-walrus-declarations": "error" }
    civetOptions: DIAL
    fix
  })

findings := (input: string) ->
  lint(input, false).diagnostics.filter (d) ->
    d.ruleId is "style/prefer-walrus-declarations"

describe "style/prefer-walrus-declarations", ->
  it "rewrites a bare identifier declaration to ':='", ->
    res := lint("const row = 1\n")
    expect(res.fixedSource).toBe("row := 1\n")
    expect(res.isEquivalencePreserved).toBe(true)

  it "rewrites a destructuring declaration", ->
    res := lint("const { setRule } = make()\n")
    expect(res.fixedSource).toBe("{ setRule } := make()\n")
    expect(res.isEquivalencePreserved).toBe(true)

  it "rewrites an array destructuring declaration", ->
    res := lint("const [a, b] = pair()\n")
    expect(res.fixedSource).toBe("[a, b] := pair()\n")
    expect(res.isEquivalencePreserved).toBe(true)

  it "preserves the export keyword", ->
    res := lint("export const CATALOG = { rules: [] }\n")
    expect(res.fixedSource).toBe("export CATALOG := { rules: [] }\n")
    expect(res.isEquivalencePreserved).toBe(true)

  it "rewrites CONST_CASE names the same way", ->
    res := lint("const CORE_SECTION = { a: 1 }\n")
    expect(res.fixedSource).toBe("CORE_SECTION := { a: 1 }\n")

  it "emits byte-identical compiler output, so no OutputDelta is needed", ->
    input := "const a = 1\nconst { b } = o\nexport const C = 2\n"
    res := lint(input)
    before := compileForOutput(input, { dial: DIAL })
    after := compileForOutput(res.fixedSource!, { dial: DIAL })
    expect(before.output).toBe(after.output)
    expect(res.isEquivalencePreserved).toBe(true)

  it "leaves let and var untouched", ->
    expect(findings("let a = 1\nvar b = 2\n")).toHaveLength(0)

  it "does not fire inside a comment", ->
    expect(findings("# const a = 1\n")).toHaveLength(0)

  it "does not fire inside a string", ->
    expect(findings("s := 'const a = 1'\n")).toHaveLength(0)

  it "does not touch an equality comparison", ->
    expect(findings("if const_a == 1\n  x := 1\n")).toHaveLength(0)

  it "is idempotent", ->
    once := lint("const a = 1\n")
    twice := lint(once.fixedSource!)
    expect(twice.fixedSource ?? once.fixedSource).toBe(once.fixedSource)
