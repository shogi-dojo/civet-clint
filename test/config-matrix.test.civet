import { describe, it, expect } from "vitest"
import fs from "node:fs/promises"
import path from "node:path"
import os from "node:os"
import { lintSource } from "../src/engine.civet"
import { loadConfig, loadCivetConfig, computeSkippedRules, resolveConfigForFile, resolveRuleOptions, validateRuleConflicts, findConfigFile, findCivetConfigFile, PRESETS } from "../src/config.civet"
import { defaultRuleRegistry } from "../src/registry.civet"
import { parseSyntax, compileForOutput } from "../src/compiler.civet"
import type { ResolvedConfig } from "../src/types.civet"

// Configuration matrix: every supported dial × rule interaction must be covered. The
// core invariant is that an autofix is accepted only when baseline and candidate
// output are equivalent under the same compiler configuration; these tests pin that
// invariant across default Civet, Coffee options, React on/off, and deliberately
// incompatible rule/config combinations.

describe "Configuration matrix", ->
  describe "opposing rule directions", ->
    it "rejects conflicting rules before linting", ->
      registry := defaultRuleRegistry.clone()
      registry.register({
        id: "test/prefer-left"
        meta: {
          description: "Prefer left"
          fixable: false
          defaultSeverity: "error"
          conflictsWith: ["test/prefer-right"]
        }
        check: ->
      })
      registry.register({
        id: "test/prefer-right"
        meta: {
          description: "Prefer right"
          fixable: false
          defaultSeverity: "error"
          conflictsWith: ["test/prefer-left"]
        }
        check: ->
      })

      rules := {
        "test/prefer-left": "error"
        "test/prefer-right": "warn"
      }
      expect(() -> validateRuleConflicts(rules, registry))
        .toThrow('"test/prefer-left" conflicts with "test/prefer-right"')
      expect(() -> lintSource("x = 1", { rules, registry }))
        .toThrow("Conflicting rules enabled")

    it "allows either direction when the opposite rule is off", ->
      registry := defaultRuleRegistry.clone()
      registry.register({
        id: "test/prefer-left"
        meta: {
          description: "Prefer left"
          fixable: false
          defaultSeverity: "error"
          conflictsWith: ["test/prefer-right"]
        }
        check: ->
      })
      registry.register({
        id: "test/prefer-right"
        meta: {
          description: "Prefer right"
          fixable: false
          defaultSeverity: "error"
        }
        check: ->
      })

      expect(() -> validateRuleConflicts({
        "test/prefer-left": "error"
        "test/prefer-right": "off"
      }, registry)).not.toThrow()

  describe "default preset (neutral, no Coffee options)", ->
    it "ships an empty dial and only dial-independent rules", ->
      expect(PRESETS["default"].civetOptions).toEqual({})
      expect(PRESETS["default"].compileOptions).toEqual({})
      // prefer-word-operators rewrites === / && / || / !, all valid in vanilla Civet.
      expect(PRESETS["default"].rules["style/prefer-word-operators"]).toBe("error")
      // JSX shorthand and no-is-not are NOT in the default preset.
      expect(PRESETS["default"].rules["style/prefer-jsx-shorthand"]).toBeUndefined()
      expect(PRESETS["default"].rules["style/no-is-not"]).toBeUndefined()

    it "keeps the coffee-react dial and all enforced rules intact", ->
      preset := PRESETS["coffee-react"]
      expect(preset.civetOptions).toEqual({
        autoLet: true
        coffeeIsnt: true
        coffeeRange: true
        coffeeComment: true
        react: true
      })
      expect(preset.rules["style/prefer-bare-jsx-values"]).toBe("error")
      expect(preset.rules["style/prefer-hash-comments"]).toBe("error")
      expect(preset.rules["style/no-thin-arrow"]).toBe("warn")

    it "provides a conflict-free CoffeeScript-to-standard migration preset", ->
      preset := PRESETS["coffee-to-standard"]
      expect(preset.civetOptions).toEqual({
        autoLet: true
        coffeeIsnt: true
        coffeeRange: true
        coffeeComment: true
        react: true
      })
      expect(preset.rules["style/prefer-slash-comments"]).toBe("error")
      expect(preset.rules["style/prefer-is-not"]).toBe("error")
      expect(preset.rules["style/prefer-explicit-declarations"]).toBe("error")
      // The existing word-operator rule selects `isnt` while coffeeIsnt is active,
      // so it stays out of this preset to keep migration convergent in one pass.
      expect(preset.rules["style/prefer-word-operators"]).toBeUndefined()
      expect(preset.rules["style/prefer-hash-comments"]).toBeUndefined()
      expect(preset.rules["style/no-is-not"]).toBeUndefined()
      expect(preset.rules["style/prefer-bare-assignment"]).toBeUndefined()
      expect(() -> validateRuleConflicts(preset.rules)).not.toThrow()

    it "provides a standard Civet idiomatic preset without legacy Coffee options", ->
      preset := PRESETS["civet-idiomatic"]
      expect(preset.civetOptions).toEqual({
        react: true
      })
      expect(preset.compileOptions).toEqual({})
      expect(preset.rules["style/prefer-unless"]).toBe("error")
      expect(preset.rules["style/prefer-at-shorthand"]).toBe("error")
      expect(preset.rules["style/prefer-length-shorthand"]).toBe("error")
      expect(preset.rules["style/prefer-typeof-shorthand"]).toBe("error")
      expect(preset.rules["style/prefer-property-shorthand"]).toBe("error")
      // Deliberately absent: the rule still proposes gate-rejected fixes on real
      // code, which would make --check exit non-zero on conformant sources.
      expect(preset.rules["style/prefer-implicit-return"]).toBeUndefined()
      expect(preset.rules["style/prefer-bare-for"]).toBe("error")
      expect(preset.rules["style/prefer-bare-conditions"]).toBe("error")
      expect(preset.rules["style/prefer-walrus-declarations"]).toBe("error")
      expect(preset.rules["style/prefer-existential-check"]).toBe("warn")
      expect(preset.rules["style/prefer-optional-type"]).toBe("warn")
      expect(preset.rules["style/prefer-postfix-conditional"]).toBe("warn")
      expect(() -> validateRuleConflicts(preset.rules)).not.toThrow()

    it "uses the neutral preset when no Clint config exists", async ->
      tmpDir := await fs.mkdtemp(path.join(os.tmpdir(), "civet-clint-default-"))
      config := loadConfig(undefined, tmpDir)
      expect(config.preset).toBe("default")
      expect(config.civetOptions).toEqual({})
      await fs.rm(tmpDir, { recursive: true, force: true })

    it "rewrites === to is under the default (vanilla) dial", ->
      input := "a === b"
      res := lintSource(input, {
        config: neutralConfig()
        fix: true
      })
      expect(res.isEquivalencePreserved).toBe(true)
      expect(res.fixedSource).toBe("a is b")

    it "does not rewrite == to is under the default dial", ->
      // In vanilla Civet `a == b` emits `a == b`; rewriting to `is` would emit
      // `a === b`, so the option-aware rule does not propose that edit.
      input := "a == b"
      res := lintSource(input, {
        config: neutralConfig()
        fix: true
      })
      expect(res.fixedSource).toBeUndefined()
      expect(res.isEquivalencePreserved).toBe(true)

    it "keeps safe default-dial edits when an unsafe spelling shares the file", ->
      res := lintSource("a === b\nc !== d", {
        config: neutralConfig()
        fix: true
      })
      expect(res.isEquivalencePreserved).toBe(true)
      expect(res.fixedSource).toBe("a is b\nc !== d")

  describe "Coffee options dial", ->
    it "rewrites == to is when coffeeEq is enabled", ->
      input := "a == b"
      res := lintSource(input, {
        civetOptions: { coffeeEq: true }
        fix: true
      })
      expect(res.isEquivalencePreserved).toBe(true)
      expect(res.fixedSource).toBe("a is b")

    it "flags is not when isnt is available or coffeeNot makes it dangerous", ->
      // With neither option, `is not` safely emits !== while `isnt` is unavailable,
      // so the style rule is intentionally skipped.
      vanilla := lintSource("a isnt b", { config: neutralConfig() })
      expect(vanilla.diagnostics.filter((d) -> d.ruleId is "style/no-is-not")).toHaveLength(0)

      coffee := lintSource("a is not b", {
        civetOptions: { coffeeIsnt: true }
        rules: { "style/no-is-not": "warn" }
      })
      expect(coffee.diagnostics.filter((d) -> d.ruleId is "style/no-is-not")).toHaveLength(1)

      dangerous := lintSource("a is not b", {
        config: neutralConfig()
        civetOptions: { coffeeNot: true }
        rules: { "style/no-is-not": "warn" }
      })
      dangerousDiags := dangerous.diagnostics.filter((d) -> d.ruleId is "style/no-is-not")
      expect(dangerousDiags).toHaveLength(1)
      expect(dangerousDiags[0].message).toContain("coffeeNot")

    it "skips is-not migration when coffeeNot changes its parse", ->
      skipped := computeSkippedRules(
        { "style/prefer-is-not": "error" }
        { coffeeIsnt: true, coffeeNot: true }
      )
      expect(skipped).toEqual([{
        ruleId: "style/prefer-is-not"
        reason: "incompatible with coffeeNot in the compiler dial"
      }])

  describe "React on/off", ->
    it "skips prefer-jsx-shorthand when react is off, runs it when react is on", ->
      off := lintSource('<div className="btn">hi</div>', {
        config: neutralConfig()
        rules: { "style/prefer-jsx-shorthand": "error" }
        fix: true
      })
      // React is not in the dial, so the rule is skipped and reports nothing.
      expect(off.diagnostics.filter((d) -> d.ruleId is "style/prefer-jsx-shorthand")).toHaveLength(0)
      expect(off.fixedSource).toBeUndefined()

      onn := lintSource('<div className="btn">hi</div>', {
        civetOptions: { react: true }
        rules: { "style/prefer-jsx-shorthand": "error" }
        fix: true
      })
      expect(onn.isEquivalencePreserved).toBe(true)
      expect(onn.fixedSource).toBe('<div .btn>hi</div>')

  describe "typed / TS-preserving output", ->
    it "threads top-level compileOptions through baseline and candidate compiles", ->
      // `js: true` is a top-level CompileOption (not a dial key). Confirm the adapter
      // applies it to both baseline and candidate so equivalence is decided under the
      // same emitted-output pipeline the project uses.
      input := "a === b"
      res := lintSource(input, {
        config: neutralConfig()
        compileOptions: { js: true }
        fix: true
      })
      expect(res.isEquivalencePreserved).toBe(true)
      expect(res.fixedSource).toBe("a is b")

    it "honors output options through the adapter", ->
      baseline := compileForOutput("x := 1", { dial: {}, compileOptions: { js: true } })
      expect(baseline.ok).toBe(true)
      expect(baseline.output).toBe("const x = 1")

    it "keeps Clint control options synchronous and text-producing", ->
      raw := parseSyntax("x := 1", {
        dial: {}
        compileOptions: { sync: false, ast: false, filename: "wrong.civet" }
        filename: "right.civet"
      })
      expect(raw.ok).toBe(true)
      expect(raw.syntax).toBeDefined()
      // Clint intentionally keeps Civet's unpruned child arrays behind SyntaxTree.
      // `ast: true` collapses this single-child shape to an object.
      expect(Array.isArray(raw.syntax!.root.children)).toBe(true)

      output := compileForOutput("x := 1", {
        dial: {}
        compileOptions: { sync: false, ast: "raw", filename: "wrong.civet" }
        filename: "right.civet"
      })
      expect(output.ok).toBe(true)
      expect(output.output).toBe("const x = 1")

    it "compares generated code when sourceMap output is requested", ->
      output := compileForOutput("x := 1", {
        dial: {}
        compileOptions: { sourceMap: true }
        filename: "input.civet"
      })
      expect(output.ok).toBe(true)
      expect(output.output).toBe("const x = 1")

  describe "incompatible rule/config combinations", ->
    it "computeSkippedRules flags JSX rule without react", ->
      skipped := computeSkippedRules(
        { "style/prefer-jsx-shorthand": "error" }
        {}
      )
      expect(skipped).toHaveLength(1)
      expect(skipped[0].ruleId).toBe("style/prefer-jsx-shorthand")
      expect(skipped[0].reason).toContain("react")

    it "computeSkippedRules flags no-is-not without coffeeIsnt", ->
      skipped := computeSkippedRules(
        { "style/no-is-not": "warn" }
        {}
      )
      expect(skipped).toHaveLength(1)
      expect(skipped[0].ruleId).toBe("style/no-is-not")
      expect(skipped[0].reason).toContain("coffeeIsnt")

    it "computeSkippedRules enables no-is-not for coffeeNot alone", ->
      skipped := computeSkippedRules(
        { "style/no-is-not": "warn" }
        { coffeeNot: true }
      )
      expect(skipped).toEqual([])

    it "computeSkippedRules clears when the dial satisfies the requirement", ->
      skipped := computeSkippedRules(
        { "style/prefer-jsx-shorthand": "error", "style/no-is-not": "warn" }
        { react: true, coffeeIsnt: true }
      )
      expect(skipped).toEqual([])

    it "does not skip rules with no declared capabilities", ->
      skipped := computeSkippedRules(
        { "style/prefer-word-operators": "error" }
        {}
      )
      expect(skipped).toEqual([])

    it "loadConfig populates skippedRules for an incompatible default-preset override", ->
      tmpDir := await fs.mkdtemp(path.join(os.tmpdir(), "civet-clint-matrix-"))
      await fs.writeFile(path.join(tmpDir, "civet-clint.config.json"), JSON.stringify({
        preset: "default"
        rules: { "style/prefer-jsx-shorthand": "error" }
      }))

      config := loadConfig("civet-clint.config.json", tmpDir)
      expect(config.preset).toBe("default")
      expect(config.civetOptions).toEqual({})
      expect(config.skippedRules.map (s) -> s.ruleId).toContain("style/prefer-jsx-shorthand")

      await fs.rm(tmpDir, { recursive: true, force: true })

  describe "loadCivetConfig splits parseOptions and top-level options", ->
    for name of ["civet.json", "civetconfig.json", ".civetconfig.json"]
      it `discovers ${name}`, ->
        tmpDir := await fs.mkdtemp(path.join(os.tmpdir(), "civet-clint-civet-disco-"))
        await fs.writeFile(path.join(tmpDir, name), JSON.stringify({
          parseOptions: { coffeeEq: true }
        }))

        expect(findCivetConfigFile(tmpDir)).toBe(path.join(tmpDir, name))
        { dial, resolvedPath } := loadCivetConfig(undefined, tmpDir)
        expect(dial.coffeeEq).toBe(true)
        expect(resolvedPath).toBe(path.join(tmpDir, name))

        await fs.rm(tmpDir, { recursive: true, force: true })

    it "extracts the dial and retains top-level CompileOptions", ->
      tmpDir := await fs.mkdtemp(path.join(os.tmpdir(), "civet-clint-split-"))
      await fs.writeFile(path.join(tmpDir, "civet.json"), JSON.stringify({
        parseOptions: { coffeeEq: true, coffeeComment: true }
        js: true
      }))

      { dial, compileOptions, resolvedPath } := loadCivetConfig(undefined, tmpDir)
      expect(dial.coffeeEq).toBe(true)
      expect(dial.coffeeComment).toBe(true)
      expect(dial.js).toBeUndefined()
      expect(compileOptions.js).toBe(true)
      expect(resolvedPath).toBe(path.join(tmpDir, "civet.json"))

      await fs.rm(tmpDir, { recursive: true, force: true })

    it "splits a bare object into dial and recognized top-level options", ->
      tmpDir := await fs.mkdtemp(path.join(os.tmpdir(), "civet-clint-bare-"))
      await fs.writeFile(path.join(tmpDir, "civet.json"), JSON.stringify({
        coffeeEq: true
        js: true
      }))

      { dial, compileOptions } := loadCivetConfig(undefined, tmpDir)
      expect(dial.coffeeEq).toBe(true)
      expect(dial.js).toBeUndefined()
      expect(compileOptions).toEqual({ js: true })

      await fs.rm(tmpDir, { recursive: true, force: true })

  describe "autofix equivalence under each dial", ->
    // For every autofix fixture, compile original and fixed source through the same
    // adapter/options and assert exact output equality. This is the matrix variant of
    // the engine's internal check.
    cases := [
      {
        name: "default dial === -> is"
        input: "a === b"
        expected: "a is b"
        dial: {}
      }
      {
        name: "coffeeEq dial == -> is"
        input: "a == b"
        expected: "a is b"
        dial: { coffeeEq: true }
      }
      {
        name: "react dial concise arrow in JSX"
        input: "<button onClick={() => doSomething()} />"
        expected: "<button onClick={=> doSomething()} />"
        dial: { react: true }
      }
    ]

    for c of cases
      it "preserves emitted output: #{c.name}", ->
        res := lintSource(c.input, {
          civetOptions: c.dial
          config: neutralConfig()
          fix: true
        })
        expect(res.isEquivalencePreserved).toBe(true)
        expect(res.fixedSource).toBe(c.expected)

        // Independent cross-check through the adapter.
        baseline := compileForOutput(c.input, { dial: c.dial })
        candidate := compileForOutput(c.expected, { dial: c.dial })
        expect(baseline.ok).toBe(true)
        expect(candidate.ok).toBe(true)
        expect(candidate.output).toBe(baseline.output)

  describe "config file auto-discovery", ->
    // A config that is present but not discovered is worse than a missing one: the
    // run silently falls back to the default preset instead of failing.
    discoverable := [
      "clint.config.json"
      ".clintrc.json"
      ".clint.json"
    ]

    for name of discoverable
      it `discovers ${name}`, ->
        tmpDir := await fs.mkdtemp(path.join(os.tmpdir(), "civet-clint-disco-"))
        await fs.writeFile(path.join(tmpDir, name), JSON.stringify({
          preset: "coffee-react"
        }))
        expect(findConfigFile(tmpDir)).toBe(path.join(tmpDir, name))
        // Discovery must actually feed loadConfig, not just resolve a path.
        expect(loadConfig(undefined, tmpDir).preset).toBe("coffee-react")
        await fs.rm(tmpDir, { recursive: true, force: true })

    it "prefers clint.config.json over the dotfile variants", ->
      tmpDir := await fs.mkdtemp(path.join(os.tmpdir(), "civet-clint-disco2-"))
      await fs.writeFile(path.join(tmpDir, "clint.config.json"), JSON.stringify({ preset: "coffee-react" }))
      await fs.writeFile(path.join(tmpDir, ".clintrc.json"), JSON.stringify({ preset: "default" }))
      expect(findConfigFile(tmpDir)).toBe(path.join(tmpDir, "clint.config.json"))
      expect(loadConfig(undefined, tmpDir).preset).toBe("coffee-react")
      await fs.rm(tmpDir, { recursive: true, force: true })

    // The `civet-clint.*` names were discoverable through 0.1.0-alpha.4 and are
    // deliberately not any more. They must still work when passed explicitly.
    for name of ["civet-clint.config.json", ".civet-clintrc.json", ".civet-clint.json"]
      it `does not auto-discover ${name}`, ->
        tmpDir := await fs.mkdtemp(path.join(os.tmpdir(), "civet-clint-disco3-"))
        await fs.writeFile(path.join(tmpDir, name), JSON.stringify({ preset: "coffee-react" }))
        expect(findConfigFile(tmpDir)).toBeUndefined()
        expect(loadConfig(name, tmpDir).preset).toBe("coffee-react")
        await fs.rm(tmpDir, { recursive: true, force: true })

    it "returns undefined when no config file is present", ->
      tmpDir := await fs.mkdtemp(path.join(os.tmpdir(), "civet-clint-disco3-"))
      expect(findConfigFile(tmpDir)).toBeUndefined()
      await fs.rm(tmpDir, { recursive: true, force: true })

  describe "per-rule options", ->
    writeConfig := (rules: any) ->
      tmpDir := await fs.mkdtemp(path.join(os.tmpdir(), "civet-clint-opts-"))
      await fs.writeFile(path.join(tmpDir, "civet-clint.config.json"), JSON.stringify({
        preset: "default"
        rules
      }))
      tmpDir

    it "accepts the [level, options] array form", ->
      tmpDir := await writeConfig({
        "style/prefer-terse-imports": ["error", { unquoteSingleQuotes: true }]
      })
      config := loadConfig("civet-clint.config.json", tmpDir)
      expect(config.rules["style/prefer-terse-imports"]).toBe("error")
      expect(config.ruleOptions["style/prefer-terse-imports"]).toEqual({ unquoteSingleQuotes: true })
      await fs.rm(tmpDir, { recursive: true, force: true })

    it "keeps the bare level form working", ->
      tmpDir := await writeConfig({ "style/prefer-terse-imports": "error" })
      config := loadConfig("civet-clint.config.json", tmpDir)
      expect(config.rules["style/prefer-terse-imports"]).toBe("error")
      expect(config.ruleOptions["style/prefer-terse-imports"]).toBeUndefined()
      await fs.rm(tmpDir, { recursive: true, force: true })

    it "rejects an unknown option key", ->
      tmpDir := await writeConfig({
        "style/prefer-terse-imports": ["error", { unquoteSingleQuote: true }]
      })
      expect(-> loadConfig("civet-clint.config.json", tmpDir)).toThrow(/Unknown option/)
      await fs.rm(tmpDir, { recursive: true, force: true })

    it "rejects an option of the wrong type", ->
      tmpDir := await writeConfig({
        "style/prefer-terse-imports": ["error", { unquoteSingleQuotes: "yes" }]
      })
      expect(-> loadConfig("civet-clint.config.json", tmpDir)).toThrow(/expected boolean/)
      await fs.rm(tmpDir, { recursive: true, force: true })

    it "rejects options for a rule that declares none", ->
      tmpDir := await writeConfig({
        "style/prefer-word-operators": ["error", { whatever: true }]
      })
      expect(-> loadConfig("civet-clint.config.json", tmpDir)).toThrow(/does not accept options/)
      await fs.rm(tmpDir, { recursive: true, force: true })

    it "rejects a non-object options container", ->
      tmpDir := await writeConfig({
        "style/prefer-terse-imports": ["error", "nope"]
      })
      expect(-> loadConfig("civet-clint.config.json", tmpDir)).toThrow(/expected a JSON object/)
      await fs.rm(tmpDir, { recursive: true, force: true })

    it "still validates the level inside the array form", ->
      tmpDir := await writeConfig({
        "style/prefer-terse-imports": ["loud", { unquoteSingleQuotes: true }]
      })
      expect(-> loadConfig("civet-clint.config.json", tmpDir)).toThrow(/expected off, warn, or error/)
      await fs.rm(tmpDir, { recursive: true, force: true })

    it "resolves options declared in a glob override", ->
      tmpDir := await fs.mkdtemp(path.join(os.tmpdir(), "civet-clint-optov-"))
      await fs.writeFile(path.join(tmpDir, "civet-clint.config.json"), JSON.stringify({
        preset: "default"
        rules: { "style/prefer-terse-imports": "error" }
        overrides: [{
          files: "legacy/**/*.civet"
          rules: { "style/prefer-terse-imports": ["error", { unquoteSingleQuotes: true }] }
        }]
      }))
      base := loadConfig("civet-clint.config.json", tmpDir)
      expect(base.ruleOptions["style/prefer-terse-imports"]).toBeUndefined()

      scoped := resolveConfigForFile(base, path.join(tmpDir, "legacy", "a.civet"), tmpDir)
      expect(scoped.ruleOptions["style/prefer-terse-imports"]).toEqual({ unquoteSingleQuotes: true })

      other := resolveConfigForFile(base, path.join(tmpDir, "src", "a.civet"), tmpDir)
      expect(other.ruleOptions["style/prefer-terse-imports"]).toBeUndefined()
      await fs.rm(tmpDir, { recursive: true, force: true })

    it "merges declared defaults for options the config omits", ->
      expect(resolveRuleOptions("style/prefer-terse-imports", undefined))
        .toEqual({ unquoteSingleQuotes: false })

// Helper: a ResolvedConfig built from the default preset with an empty dial, so tests
// can pass it to lintSource without relying on the coffee-react default.
function neutralConfig(): ResolvedConfig
  preset := PRESETS["default"]
  {
    preset: "default"
    rules: { ...preset.rules }
    ruleOptions: {}
    civetOptions: {}
    compileOptions: {}
    skippedRules: computeSkippedRules({ ...preset.rules }, {})
  }
