import { describe, it, expect } from "vitest"
import { lintSource } from "../src/engine.civet"

describe "Rules Test Suite", ->
  describe "style/prefer-word-operators", ->
    it "replaces JS operators with Civet word operators", ->
      input := "a === b and c !== d or (e && f) || !flag"
      res := lintSource(input, {
        civetOptions: { coffeeIsnt: true }
        fix: true
      })
      expect(res.isEquivalencePreserved).toBe(true)
      expect(res.fixedSource).toBe("a is b and c isnt d or (e and f) or not flag")

    it "never edits inside a stripped comment", ->
      // Comments are dropped before codegen, so compiler equivalence cannot
      // catch a fix that lands inside one. The guard must reject it outright.
      input := "r := a === b  # keep x === y intact"
      res := lintSource(input, {
        civetOptions: { coffeeComment: true, coffeeEq: true }
        fix: true
      })
      expect(res.isEquivalencePreserved).toBe(true)
      expect(res.fixedSource).toBe("r := a is b  # keep x === y intact")

    it "leaves a comment-only line untouched", ->
      res := lintSource("// only a === b here\nr := 1", { fix: true })
      expect(res.fixedSource).toBeUndefined()

    it "replaces coffeeEq operators using their original source spelling", ->
      input := "a == b\nc != d"
      res := lintSource(input, {
        civetOptions: { coffeeEq: true, coffeeIsnt: true }
        fix: true
      })
      expect(res.isEquivalencePreserved).toBe(true)
      expect(res.fixedSource).toBe("a is b\nc isnt d")

    it "ignores null and undefined equality comparisons", ->
      input := "a === null\nb !== null"
      res := lintSource(input, { fix: true })
      expect(res.fixedSource).toBeUndefined()
      expect(res.diagnostics.filter((d) -> d.ruleId is "style/prefer-word-operators")).toHaveLength(0)

    it "still rewrites comparisons with undefined", ->
      res := lintSource("a === undefined\nb !== undefined", {
        civetOptions: { coffeeIsnt: true }
        fix: true
      })
      expect(res.fixedSource).toBe("a is undefined\nb isnt undefined")

    it "does not replace operators inside strings, comments, or JSX text", ->
      input := 's := "=== && || !"\n// comment with !== and ||\n<div>=== and &&</div>'
      res := lintSource(input, {
        civetOptions: { react: true }
        fix: true
      })
      expect(res.diagnostics.filter((d) -> d.ruleId is "style/prefer-word-operators")).toHaveLength(0)

    it "does not treat Object prototype property names as operators", ->
      input := "toString\nconstructor\n__proto__"
      res := lintSource(input, { fix: true })
      expect(res.diagnostics.filter((d) -> d.ruleId is "style/prefer-word-operators")).toHaveLength(0)
      expect(res.fixedSource).toBeUndefined()

    it "does not rewrite synthetic bang tokens produced by unless", ->
      res := lintSource("unless ready\n  start()", { fix: true })
      expect(res.diagnostics.filter((d) -> d.ruleId is "style/prefer-word-operators")).toHaveLength(0)
      expect(res.fixedSource).toBeUndefined()

    it "preserves double-bang boolean coercion", ->
      input := "isEditing := !!selectedEvent\nvisible := !!(a and b)"
      res := lintSource(input, { fix: true })
      expect(res.diagnostics.filter((d) -> d.ruleId is "style/prefer-word-operators")).toHaveLength(0)
      expect(res.fixedSource).toBeUndefined()

    it "handles unary ! on expressions cleanly", ->
      input := "!foo\n!(a && b)\n!isReady"
      res := lintSource(input, { fix: true })
      expect(res.isEquivalencePreserved).toBe(true)
      expect(res.fixedSource).toBe("not foo\nnot (a and b)\nnot isReady")

  describe "style/prefer-concise-arrow", ->
    it "replaces parameterless () => with =>", ->
      input := "fn := () => 42\nasyncFn := async () => 42"
      res := lintSource(input, { fix: true })
      expect(res.isEquivalencePreserved).toBe(true)
      expect(res.fixedSource).toBe("fn := => 42\nasyncFn := async => 42")

    it "replaces () => in callbacks and JSX props", ->
      input := "items.map(() => 0)\n<button onClick={() => doSomething()} />"
      res := lintSource(input, {
        civetOptions: { react: true }
        fix: true
      })
      expect(res.isEquivalencePreserved).toBe(true)
      expect(res.fixedSource).toBe("items.map(=> 0)\n<button onClick={=> doSomething()} />")

    it "does not touch arrow functions with parameters", ->
      input := "(x) => x * 2\n(a, b) => a + b"
      res := lintSource(input, { fix: true })
      expect(res.diagnostics.filter((d) -> d.ruleId is "style/prefer-concise-arrow")).toHaveLength(0)
      expect(res.fixedSource).toBeUndefined()

  describe "style/prefer-jsx-shorthand", ->
    it "replaces static className and id with JSX shorthand in React mode", ->
      input := '<div className="btn primary" id="main-card">hello</div>'
      res := lintSource(input, {
        civetOptions: { react: true }
        rules: { "style/prefer-jsx-shorthand": "error" }
        fix: true
      })
      expect(res.isEquivalencePreserved).toBe(true)
      expect(res.fixedSource).toBe('<div .btn.primary #main-card>hello</div>')

    it "works on self-closing tags and custom component tags", ->
      input := '<Button className="btn-save" id="save-btn" />'
      res := lintSource(input, {
        civetOptions: { react: true }
        rules: { "style/prefer-jsx-shorthand": "error" }
        fix: true
      })
      expect(res.isEquivalencePreserved).toBe(true)
      expect(res.fixedSource).toBe('<Button .btn-save #save-btn />')

    it "ignores dynamic, interpolated, or empty attributes", ->
      input := '<div className={dynamicClass} id="" className="" />'
      res := lintSource(input, {
        civetOptions: { react: true }
        rules: { "style/prefer-jsx-shorthand": "error" }
        fix: true
      })
      expect(res.diagnostics.filter((d) -> d.ruleId is "style/prefer-jsx-shorthand")).toHaveLength(0)
      expect(res.fixedSource).toBeUndefined()

    // Civet lowers the shorthand to the front of the tag, on the tag-name line.
    // Anything that would move is skipped, because the gate validates one batch per
    // file: a single rejected site used to discard every safe rewrite in that file.
    describe "only rewrites what lowers in place", ->
      jsxFix := (input: string) ->
        lintSource(input, {
          civetOptions: { react: true }
          rules: { "style/prefer-jsx-shorthand": "error" }
          fix: true
        })

      it "skips className that follows another attribute", ->
        // Rewriting would emit `className` before `size`, reordering the output.
        input := '<Icon size={16} className="i" />'
        expect(jsxFix(input).fixedSource ?? input).toBe(input)

      it "skips className that follows a spread", ->
        // Moving className ahead of the spread inverts precedence — a real
        // behavior change, not just reordering.
        input := '<div {...props} className="btn">x</div>'
        expect(jsxFix(input).fixedSource ?? input).toBe(input)

      it "rewrites className that precedes a spread", ->
        res := jsxFix '<div className="btn" {...props}>x</div>'
        expect(res.isEquivalencePreserved).toBe(true)
        expect(res.fixedSource).toBe('<div .btn {...props}>x</div>')

      it "rewrites a leading run of className and id", ->
        res := jsxFix '<div className="a" id="b" onClick={f}>x</div>'
        expect(res.isEquivalencePreserved).toBe(true)
        expect(res.fixedSource).toBe('<div .a #b onClick={f}>x</div>')

      it "skips an attribute written on its own line", ->
        // The shorthand collapses onto the tag line, changing emitted whitespace.
        input := '<button\n  className="a"\n  onClick={f}\n>\n  x\n</button>'
        expect(jsxFix(input).fixedSource ?? input).toBe(input)

      it "still fixes safe sites when an unsafe one shares the file", ->
        // The regression that made this rule unusable: one skipped site must not
        // suppress the safe rewrites around it.
        input := '<div className="a">x</div>\n<Icon size={16} className="b" />\n'
        res := jsxFix input
        expect(res.isEquivalencePreserved).toBe(true)
        expect(res.fixedSource).toBe('<div .a>x</div>\n<Icon size={16} className="b" />\n')

  describe "style/no-null-equality", ->
    it "reports warning diagnostics on null comparisons", ->
      input := "a === null\nb !== null\nc is null\nd isnt null"
      res := lintSource(input, {
        civetOptions: { coffeeIsnt: true }
        rules: { "style/no-null-equality": "warn" }
      })
      nullDiags := res.diagnostics.filter((d) -> d.ruleId is "style/no-null-equality")
      expect(nullDiags.length).toBe(4)
      expect(nullDiags.every((d) -> d.severity is "warn")).toBe(true)

    it "does not warn on non-null comparisons", ->
      input := "a === 5\nb !== 'hello'\nc is true"
      res := lintSource(input, { rules: { "style/no-null-equality": "warn" } })
      nullDiags := res.diagnostics.filter((d) -> d.ruleId is "style/no-null-equality")
      expect(nullDiags.length).toBe(0)

  describe "style/no-is-not", ->
    it "reports warning diagnostic on 'is not'", ->
      input := "a is not b"
      res := lintSource(input, {
        civetOptions: { coffeeIsnt: true }
        rules: { "style/no-is-not": "warn" }
      })
      isNotDiags := res.diagnostics.filter((d) -> d.ruleId is "style/no-is-not")
      expect(isNotDiags.length).toBe(1)
      expect(isNotDiags[0].severity).toBe("warn")

    it "does not warn on 'isnt'", ->
      input := "a isnt b"
      res := lintSource(input, {
        civetOptions: { coffeeIsnt: true }
        rules: { "style/no-is-not": "warn" }
      })
      isNotDiags := res.diagnostics.filter((d) -> d.ruleId is "style/no-is-not")
      expect(isNotDiags.length).toBe(0)

  describe "style/no-mixed-interpolation", ->
    it "reports warning on '${...}' inside string literals", ->
      input := 'msg := "Hello ${name}"'
      res := lintSource(input)
      interpDiags := res.diagnostics.filter((d) -> d.ruleId is "style/no-mixed-interpolation")
      expect(interpDiags.length).toBe(1)
      expect(interpDiags[0].severity).toBe("warn")

    it "does not warn on '#{...}' style interpolation", ->
      input := 'msg := "Hello #{name}"'
      res := lintSource(input)
      interpDiags := res.diagnostics.filter((d) -> d.ruleId is "style/no-mixed-interpolation")
      expect(interpDiags.length).toBe(0)

    it "reports warning on '#{...}' inside backtick templates", ->
      input := 'msg := `Hello #{name}`'
      res := lintSource(input)
      interpDiags := res.diagnostics.filter((d) -> d.ruleId is "style/no-mixed-interpolation")
      expect(interpDiags.length).toBe(1)
