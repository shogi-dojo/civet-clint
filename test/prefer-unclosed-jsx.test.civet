import { describe, it, expect } from "vitest"
import { lintSource, compileSource, normalizeWhitespaceStyle } from "../src/engine.civet"

RULE := "style/prefer-unclosed-jsx"
DIAL := { react: true }

function fix(source: string)
  lintSource(source, { rules: { [RULE]: "error" }, fix: true, civetOptions: DIAL })

function expectEquivalent(source: string)
  res := fix(source)
  fixed := res.fixedSource ?? source
  expect(res.isEquivalencePreserved).toBe(true)
  expect(normalizeWhitespaceStyle(compileSource(fixed, DIAL)))
    .toBe(normalizeWhitespaceStyle(compileSource(source, DIAL)))
  fixed

function unchanged(source: string)
  res := fix(source)
  expect(res.fixedSource ?? source).toBe(source)

describe "style/prefer-unclosed-jsx", ->
  it "drops a closing tag that ends its line", ->
    // Every closer in the element goes, including the outermost one: indentation
    // already delimits all of them.
    expect(expectEquivalent("x := <div>\n  <span>hi</span>\n</div>\n"))
      .toBe("x := <div>\n  <span>hi\n")

  it "drops closing tags from sibling elements", ->
    expect(expectEquivalent("x := <div>\n  <span>a</span>\n  <b>c</b>\n</div>\n"))
      .toBe("x := <div>\n  <span>a\n  <b>c\n")

  it "drops a closer that sits alone on its line, taking the line with it", ->
    expect(expectEquivalent("x := <div>\n  <b>\n    <i>y</i>\n  </b>\n</div>\n"))
      .toBe("x := <div>\n  <b>\n    <i>y\n")

  it "drops the closer of an element holding an expression container", ->
    expect(expectEquivalent("x := <div>\n  <span>{v}</span>\n</div>\n"))
      .toBe("x := <div>\n  <span>{v}\n")

  it "drops a closer inside a parenthesised group", ->
    expect(expectEquivalent("x := (\n  <div>\n    <span>a</span>\n  </div>\n)\n"))
      .toBe("x := (\n  <div>\n    <span>a\n)\n")

  it "is idempotent", ->
    once := fix("x := <div>\n  <span>hi</span>\n</div>\n").fixedSource!
    twice := fix(once)
    expect(twice.fixedSource).toBeUndefined()
    expect(twice.diagnostics.filter((d) -> d.ruleId is RULE)).toHaveLength(0)

describe "style/prefer-unclosed-jsx exclusions", ->
  it "keeps '</pre>'", ->
    // The style guide's one stated exception: an unclosed <pre> gains a newline in
    // the rendered output. The equivalence gate would accept the rewrite, so this
    // guard is the guide's, not the compiler's. The enclosing <div> still loses its
    // closer -- only <pre> is exempt.
    expect(expectEquivalent("x := <div>\n  <pre>code</pre>\n</div>\n"))
      .toBe("x := <div>\n  <pre>code</pre>\n")

  it "keeps '</textarea>'", ->
    expect(expectEquivalent("x := <div>\n  <textarea>v</textarea>\n</div>\n"))
      .toBe("x := <div>\n  <textarea>v</textarea>\n")

  it "keeps a closer with content after it on the line", ->
    // `<span>a</span> tail` -> `<span>a tail` pulls "tail" inside the span. The
    // outer </div> is still droppable.
    expect(expectEquivalent("x := <div>\n  <span>a</span> tail\n</div>\n"))
      .toBe("x := <div>\n  <span>a</span> tail\n")

  it "keeps a closer that is not at the end of an inline chain", ->
    unchanged("x := <div><span>a</span></div>\n")

  it "keeps a closer inside a comment", ->
    unchanged("// <span>a</span>\nx := 1\n")

  it "drops the outer closer and the inner slash together", ->
    expect(expectEquivalent("x := <div>\n  <Foo a=1 />\n</div>\n"))
      .toBe("x := <div>\n  <Foo a=1>\n")

describe "style/prefer-unclosed-jsx — self-closing slash", ->
  it "drops the slash from a nested self-closing tag", ->
    expect(expectEquivalent("x := <div>\n  <Foo a=1 />\n  <Bar />\n</div>\n"))
      .toBe("x := <div>\n  <Foo a=1>\n  <Bar>\n")

  it "drops the slash from a top-level self-closing tag", ->
    expect(expectEquivalent("x := <Foo a=1 />\n")).toBe("x := <Foo a=1>\n")

  it "drops the slash from an unspaced tag", ->
    // `<Foo/>` -> `<Foo>` re-emits as `<Foo />`: a single space, which is what the
    // declared whitespace-style delta covers.
    expect(expectEquivalent("x := <Foo/>\n")).toBe("x := <Foo>\n")

  it "keeps the indentation of a slash on its own line", ->
    expect(expectEquivalent("x := <div>\n  <Foo\n    a=1\n  />\n</div>\n"))
      .toBe("x := <div>\n  <Foo\n    a=1\n  >\n")

  it "sees past a '>' inside an attribute string", ->
    expect(expectEquivalent('x := <Foo a=">" />\n')).toBe('x := <Foo a=">">\n')

  it "handles a spread attribute", ->
    expect(expectEquivalent("x := <Foo {...p} />\n")).toBe("x := <Foo {...p}>\n")

describe "style/prefer-unclosed-jsx — self-closing exclusions", ->
  it "leaves an inline tag alone", ->
    // `<div><Foo /><Bar /></div>` -> `<div><Foo><Bar></div>` makes <Bar> a CHILD
    // of <Foo>. The slashless form is only self-closing when nothing follows it on
    // the line.
    unchanged("x := <div><Foo /><Bar /></div>\n")

  it "leaves a tag inside a ternary alone", ->
    // `{a ? <Foo> : <Bar />}` does not parse at all. Only the outer `</div>` goes.
    expect(expectEquivalent("x := <div>\n  {a ? <Foo /> : <Bar />}\n</div>\n"))
      .toBe("x := <div>\n  {a ? <Foo /> : <Bar />}\n")

  it "leaves a tag followed by text on the same line", ->
    // The <Icon/> slash stays -- " b" would become its child. The <span> closer
    // still goes: it ends its line and nothing follows.
    expect(expectEquivalent("x := <span>a <Icon /> b</span>\n"))
      .toBe("x := <span>a <Icon /> b\n")

  it "leaves a tag whose enclosing closer shares its name", ->
    // `</div>` would pair with the slashless `<div>`, so the outer element loses
    // its closer. Only the outer `</div>` is dropped, by the closing-tag half.
    expect(expectEquivalent("x := <div .outer>\n  <div .spot />\n</div>\n"))
      .toBe("x := <div .outer>\n  <div .spot />\n")

  it "leaves a tag followed by a group closer", ->
    // `{cond and (` ... `)}` -- the slashless form stops parsing once the group
    // closes after it. Only the outer `</div>` goes.
    expect(expectEquivalent("x := <div>\n  {c and (\n    b ? null : (\n      <Foo p=1 />\n    )\n  )}\n</div>\n"))
      .toBe("x := <div>\n  {c and (\n    b ? null : (\n      <Foo p=1 />\n    )\n  )}\n")

describe "style/prefer-unclosed-jsx — options", ->
  it "honours closingTags: false", ->
    res := lintSource("x := <div>\n  <span>hi</span>\n  <Foo />\n</div>\n", {
      rules: { [RULE]: "error" }
      ruleOptions: { [RULE]: { closingTags: false } }
      fix: true
      civetOptions: DIAL
    })
    expect(res.fixedSource).toBe("x := <div>\n  <span>hi</span>\n  <Foo>\n</div>\n")

  it "honours selfClosingSlash: false", ->
    res := lintSource("x := <div>\n  <span>hi</span>\n  <Foo />\n</div>\n", {
      rules: { [RULE]: "error" }
      ruleOptions: { [RULE]: { selfClosingSlash: false } }
      fix: true
      civetOptions: DIAL
    })
    expect(res.fixedSource).toBe("x := <div>\n  <span>hi\n  <Foo />\n")
