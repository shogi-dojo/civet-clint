import { describe, it, expect } from "vitest"
import { lintSource } from "../src/engine.civet"

isNotDiags := (input: string, opts: any = {}) ->
  res := lintSource(input, {
    civetOptions: { coffeeIsnt: true, ...opts }
    rules: { "style/no-is-not": "warn" }
  })
  res.diagnostics.filter (d) -> d.ruleId is "style/no-is-not"

describe "style/no-is-not", ->
  it "reports a plain 'is not' comparison", ->
    diags := isNotDiags("x := 1\nif x is not 2\n  y := 3")
    expect(diags).toHaveLength(1)
    expect(diags[0]!.line).toBe(2)

  // The rule scans token spans. These guard the boundary: text that merely
  // *looks* like the operator must never be reported.
  it "ignores 'is not' inside string literals", ->
    expect(isNotDiags('s := "a is not b"')).toHaveLength(0)
    expect(isNotDiags("t := 'x is not y'")).toHaveLength(0)

  it "ignores 'is not' inside comments", ->
    expect(isNotDiags("# this is not a finding\nx := 1", { coffeeComment: true })).toHaveLength(0)

  it "reports 'is not' nested in expressions and callbacks", ->
    diags := isNotDiags("fn := (a) -> a is not null")
    expect(diags).toHaveLength(1)

  it "reports each distinct 'is not' once", ->
    diags := isNotDiags("arr := [1 is not 2, 3 is not 4]")
    expect(diags).toHaveLength(2)

  it "leaves idiomatic 'isnt' alone", ->
    expect(isNotDiags("x := a isnt b")).toHaveLength(0)
