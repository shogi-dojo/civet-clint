import { describe, it, expect } from "vitest"
import { lintSource } from "../src/engine.civet"
import { noTrailingSemicolonsRule } from "../src/rules/no-trailing-semicolons.civet"

lint := (src: string) ->
  lintSource(src, {
    civetOptions: { coffeeComment: true }
    rules: { "style/no-trailing-semicolons": "error" }
    fix: true
  })

describe "style/no-trailing-semicolons baseline reuse", ->
  // The rule compares candidate compiles against unmodified output. It now takes
  // that baseline from the engine instead of recompiling. These pin the safety
  // decisions, which is what the reuse must not change.
  it "removes semicolons that do not affect the emitted program", ->
    res := lint("x := 1;\ny := 2;\n")
    expect(res.fixedSource).toBe("x := 1\ny := 2\n")

  it "keeps a semicolon that suppresses an implicit return", ->
    // Inside a function body the trailing `;` is load-bearing: dropping it makes
    // the last statement the return value.
    src := "f := ->\n  g()\n  h();\n"
    res := lint(src)
    expect(res.fixedSource).toBeUndefined()
    expect(res.diagnostics).toHaveLength(0)

  it "removes only the safe semicolons in a mixed file", ->
    src := "a := 1;\nuseEffect =>\n  doThing()\n  cleanup();\nb := 2;\n"
    res := lint(src)
    expect(res.fixedSource).toBe("a := 1\nuseEffect =>\n  doThing()\n  cleanup();\nb := 2\n")

  it "ignores semicolons inside comments and strings", ->
    src := "x := 1  # trailing ; here\ns := \"has ; inside\"\n"
    res := lint(src)
    expect(res.fixedSource).toBeUndefined()

  it "receives the engine's baseline compile on the rule context", ->
    var seen: string | undefined = undefined
    original := noTrailingSemicolonsRule.check
    noTrailingSemicolonsRule.check = (ctx) ->
      seen = ctx.baselineOutput
      original(ctx)
    try
      lint("x := 1;\n")
    finally
      noTrailingSemicolonsRule.check = original
    expect(seen).toBeTypeOf("string")
    expect(seen).toContain("x")

  it "still works when no baseline is supplied", ->
    // buildReference reaches safeSemicolons without a context; that path must
    // fall back to compiling rather than silently reporting nothing.
    res := lintSource("x := 1;\ny := 2;\n", {
      civetOptions: {}
      rules: { "style/no-trailing-semicolons": "error" }
    })
    expect(res.diagnostics.length).toBeGreaterThan(0)
