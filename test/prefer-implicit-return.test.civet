import { describe, it, expect } from "vitest"
import { lintSource, compileSource, normalizeSemicolonStyle } from "../src/engine.civet"

RULE := "style/prefer-implicit-return"
DIAL := { autoLet: true, react: true }

function fix(source: string)
  lintSource(source, { rules: { [RULE]: "error" }, fix: true, civetOptions: DIAL })

function expectReturnEquivalent(source: string)
  res := fix(source)
  fixed := res.fixedSource ?? source
  expect(res.isEquivalencePreserved).toBe(true)
  expect(compileSource(fixed, DIAL)).toBe(compileSource(source, DIAL))
  fixed

function unchanged(source: string)
  res := fix(source)
  expect(res.fixedSource ?? source).toBe(source)

describe "style/prefer-implicit-return", ->
  it "drops trailing return in a function declaration", ->
    expect(expectReturnEquivalent("function f(x) {\n  const y = x + 1\n  return y\n}\n"))
      .toBe("function f(x) {\n  const y = x + 1\n  y\n}\n")

  it "drops trailing return in a thin arrow function", ->
    expect(expectReturnEquivalent("const f = (x) ->\n  y := x + 1\n  return y\n"))
      .toBe("const f = (x) ->\n  y := x + 1\n  y\n")

  it "drops trailing return in a fat arrow function", ->
    expect(expectReturnEquivalent("const f = (x) => {\n  const y = x + 1\n  return y\n}\n"))
      .toBe("const f = (x) => {\n  const y = x + 1\n  y\n}\n")

  it "drops trailing return in a method definition", ->
    expect(expectReturnEquivalent("class Foo {\n  bar() {\n    return 42\n  }\n}\n"))
      .toBe("class Foo {\n  bar() {\n    42\n  }\n}\n")

  it "is idempotent", ->
    once := fix("function f(x) {\n  const y = x + 1\n  return y\n}\n").fixedSource!
    twice := fix(once)
    expect(twice.fixedSource).toBeUndefined()
    expect(twice.diagnostics.filter((d) -> d.ruleId is RULE)).toHaveLength(0)

describe "style/prefer-implicit-return guards", ->
  it "bails on generator functions because explicit return is preserved in JS emit", ->
    unchanged("function* g() {\n  return 1\n}\n")

  it "bails on object literal returns because de-returning adds parentheses in JS emit", ->
    unchanged("function f() {\n  return { a: 1 }\n}\n")

  it "bails on bare return statements with no value", ->
    unchanged("function f() {\n  return\n}\n")

  it "bails on return inside a loop body", ->
    unchanged("function f(xs) {\n  for (const x of xs) {\n    return x\n  }\n}\n")

  it "leaves a valueless 'return' alone", ->
    // Deleting a bare `return` does not preserve the return value -- the function
    // would start returning whatever the preceding statement evaluated to. A
    // valueless return still presents an AST `expression`, so this needs a source
    // check, not just a structural one.
    unchanged("f := =>\n  g()\n  return\n")

  it "leaves a 'return' that is not the last statement", ->
    // Matched via the function's final entry tuple, but control flow depends on it.
    unchanged("f := (t) =>\n  if t.a\n    return t.a()\n  if t.b\n    t.b()\n")


describe "trailing return semicolons", ->
  for source of [
    "function f() { return x; }\n"
    "f := =>\n  return g(\n    x\n  );\n"
    "function f()\n  return x;\n"
  ]
    it `removes the suppressing semicolon with the keyword: ${source}`, ->
      result := fix(source)
      fixed := result.fixedSource ?? source
      expect(fixed).not.toContain("return")
      expect(fixed).not.toContain(";")
      expect(result.isEquivalencePreserved).toBe(true)
      expect(normalizeSemicolonStyle(compileSource(fixed, DIAL)))
        .toBe(normalizeSemicolonStyle(compileSource(source, DIAL)))
      expect(fix(fixed).appliedFixesCount).toBe(0)

  it "preserves early returns when another statement follows", ->
    unchanged("function f() { return x; g() }\n")

  it "does not reparse a sole braced-arrow return as an object method", ->
    unchanged("direction := => { return directions()[id] ?? null; }\n")

  it "removes nested callback returns without overlapping the outer edit", ->
    source := "function mask(xs)\n  return xs.reduce((mask, x) =>\n    y := x + 1\n    return mask | y\n  , 0);\n"
    result := fix(source)
    fixed := result.fixedSource ?? source
    expect(fixed).not.toContain("return")
    expect(result.isEquivalencePreserved).toBe(true)
    expect(normalizeSemicolonStyle(compileSource(fixed, DIAL)))
      .toBe(normalizeSemicolonStyle(compileSource(source, DIAL)))


  it "does not attribute a nested object's return to an outer implicit return", ->
    unchanged("function f(xs)\n  xs.map((x) =>\n    return { x }\n  )\n")

describe "class constructors", ->
  it "keeps the 'return' of a constructor: `new` yields the returned object", ->
    // Civet adds no implicit return to a constructor, so dropping the keyword makes
    // `new` hand back the instance instead of `ctx`.
    source := "vi.stubGlobal 'AudioContext', class\n  constructor()\n    return ctx\n"
    res := fix(source)
    expect(res.diagnostics.filter((d) -> d.ruleId is RULE)).toHaveLength(0)
    expect(res.fixedSource ?? source).toBe(source)

  it "still fixes the methods around a constructor in the same class", ->
    // The rejected constructor fix used to take the whole file's batch with it.
    fixed := expectReturnEquivalent("class Foo\n  constructor()\n    return ctx\n  m()\n    return 1\n")
    expect(fixed).toBe("class Foo\n  constructor()\n    return ctx\n  m()\n    1\n")

describe "one-line braced method bodies", ->
  it "drops the braces with the return: `get data() { return x.y }` -> `get data() x.y`", ->
    // With only the keyword gone, `{ x.y }` re-parses as an object literal, which
    // the gate rejects -- and with it every other fix in the file.
    expect(expectReturnEquivalent("f = => ({ get data() { return mocks.events } })\n"))
      .toBe("f = => ({ get data() mocks.events })\n")

  it "drops the braces of a plain one-line method as well", ->
    expect(expectReturnEquivalent("o := { m(a) { return a + 1 } }\n"))
      .toBe("o := { m(a) a + 1 }\n")

  it "removes the semicolon that sat before the closing brace", ->
    // Compiled output differs only by that semicolon, which the engine's
    // semicolon-style delta accounts for, so check the gate rather than byte equality.
    res := fix("f = => ({ get data() { return mocks.c; } })\n")
    expect(res.isEquivalencePreserved).toBe(true)
    expect(res.fixedSource).toBe("f = => ({ get data() mocks.c })\n")

  it "keeps a callback's own return edit apart from the method's braces", ->
    expect(expectReturnEquivalent("f = => ({ get data() { return foo(=> { return 1 }) } })\n"))
      .toMatch(/^f = => \(\{ get data\(\) foo\(/)

  it "leaves a braced method followed by another entry alone", ->
    // Unbraced, `m() g(1), n: 2` swallows the comma: `m() { return g(1), {n: 2} }`.
    source := "o := { m() { return g(1) }, n: 2 }\n"
    res := fix(source)
    expect(res.isEquivalencePreserved).toBe(true)
    expect(res.fixedSource ?? source).not.toContain("m() g(1)")

  it "still fixes a multi-line braced getter through the plain keyword removal", ->
    expect(expectReturnEquivalent("o := {\n  get data() {\n    return mocks.events\n  }\n}\n"))
      .toBe("o := {\n  get data() {\n    mocks.events\n  }\n}\n")

describe "return of a conditional expression", ->
  it "does not offer to drop `return if … then … else …`", ->
    // A conditional expression after `return` is a ternary; as the last statement it
    // is an if/else. Same behaviour, different compiled output: the gate would reject
    // the fix on every run, so the rule stays silent instead of reporting it.
    source := "f = (w) =>\n  if w.a\n    return 'x'\n  return if s() then 'm' else 'n'\n"
    res := fix(source)
    expect(res.diagnostics.filter((d) -> d.ruleId is RULE)).toHaveLength(0)
    expect(res.fixedSource ?? source).toBe(source)

  it "does not let such a return poison the file's other fixes", ->
    fixed := expectReturnEquivalent("f = (w) =>\n  return if s() then 'm' else 'n'\ng = (x) =>\n  y := x + 1\n  return y\n")
    expect(fixed).toContain("  y := x + 1\n  y\n")
    expect(fixed).toContain("return if s() then 'm' else 'n'")
