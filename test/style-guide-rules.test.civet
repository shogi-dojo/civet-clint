import { describe, it, expect } from "vitest"
import { lintSource, compileSource, normalizeSemicolonStyle } from "../src/engine.civet"
import { defaultRuleRegistry } from "../src/registry.civet"

function fixSemicolons(source: string, civetOptions: Record<string, any> = {})
  lintSource(source, {
    rules: {
      "style/no-trailing-semicolons": "error"
      "style/prefer-concise-arrow": "off"
    }
    fix: true
    civetOptions
  })

function expectSemicolonFix(source: string, civetOptions: Record<string, any> = {})
  res := fixSemicolons(source, civetOptions)
  fixed := res.fixedSource ?? source
  expect(res.isEquivalencePreserved).toBe(true)
  expect(normalizeSemicolonStyle(compileSource(fixed, civetOptions))).toBe(normalizeSemicolonStyle(compileSource(source, civetOptions)))
  fixed

describe "Style Guide Rules Coverage", ->
  describe "style/no-trailing-semicolons", ->
    it "reports diagnostics on trailing semicolons at line ends", ->
      source := "x = 1;\ny = 2;\n"
      res := lintSource(source, {
        rules: { "style/no-trailing-semicolons": "error" }
        civetOptions: { autoLet: true }
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/no-trailing-semicolons"
      expect(diags.length).toBe(2)
      expect(diags[0].message).toContain("Unnecessary trailing semicolon")
      expect(diags[1].message).toContain("Unnecessary trailing semicolon")

    it "reports trailing semicolon before comment", ->
      source := "x = 1; # comment\n"
      res := lintSource(source, {
        rules: { "style/no-trailing-semicolons": "error" }
        civetOptions: { autoLet: true, coffeeComment: true }
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/no-trailing-semicolons"
      expect(diags.length).toBe(1)

    it "ignores semicolons inside a template literal", ->
      source := "x = <style>{`\n  a { opacity: 1; }\n`}</style>\n"
      res := lintSource(source, {
        rules: { "style/no-trailing-semicolons": "error" }
        civetOptions: { autoLet: true, react: true }
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/no-trailing-semicolons"
      expect(diags).toHaveLength(0)

    it "preserves semicolons inside strings and multi-statement lines", ->
      source := 'str = "hello; world";\na = 1; b = 2\n'
      res := lintSource(source, {
        rules: { "style/no-trailing-semicolons": "error" }
        civetOptions: { autoLet: true }
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/no-trailing-semicolons"
      expect(diags.length).toBe(1)

    it "fixes simple statement semicolon: x = 1; -> x = 1", ->
      expect(expectSemicolonFix("x = 1;\n", { autoLet: true })).toBe("x = 1\n")

    it "fixes call statement semicolon: doThing(); -> doThing()", ->
      expect(expectSemicolonFix("doThing();\n")).toBe("doThing()\n")

    it "fixes assertion chain: expect(a).toBe(1); -> expect(a).toBe(1)", ->
      expect(expectSemicolonFix("expect(a).toBe(1);\n")).toBe("expect(a).toBe(1)\n")

    it "fixes semicolon before comment while preserving single space", ->
      expect(expectSemicolonFix("x = 1; # comment\n", { autoLet: true, coffeeComment: true })).toBe("x = 1 # comment\n")

    // These two semicolons suppress an implicit return: without them Civet reparses
    // the braced body as an object literal. The rule verifies each candidate by
    // compiling with and without it, so it no longer reports them at all. Before,
    // it reported the fix and the equivalence gate rejected it — same protection,
    // but the user saw a spurious error and a non-zero exit.
    it "hazard: does not report a load-bearing semicolon in an arrow body", ->
      source := "f := () => { doThing(); }\n"
      res := fixSemicolons(source)
      expect(res.diagnostics.filter (d) -> d.ruleId is "style/no-trailing-semicolons").toHaveLength(0)
      expect(res.diagnostics.some (d) -> d.ruleId is "compiler-equivalence-mismatch").toBe(false)
      // The semicolon survives whatever other rules do to the line.
      expect(res.fixedSource ?? source).toContain("doThing();")

    it "hazard: does not report a load-bearing semicolon in a braced if body", ->
      source := "if cond\n  { doThing(); }\n"
      res := fixSemicolons(source)
      expect(res.diagnostics.filter (d) -> d.ruleId is "style/no-trailing-semicolons").toHaveLength(0)
      expect(res.diagnostics.some (d) -> d.ruleId is "compiler-equivalence-mismatch").toBe(false)
      expect(res.fixedSource).toBeUndefined()

    it "hazard: removing the semicolon really would change the emit", ->
      // Pins WHY the two tests above must hold, independent of the rule.
      withSemi := compileSource("if cond\n  { doThing(); }\n", { autoLet: true })
      without := compileSource("if cond\n  { doThing() }\n", { autoLet: true })
      expect(withSemi).not.toBe(without)
      expect(without).toContain("doThing:")

    it "idempotence: second pass produces no changes and no diagnostics", ->
      first := fixSemicolons("x = 1;\n", { autoLet: true })
      expect(first.fixedSource).toBe("x = 1\n")
      second := fixSemicolons(first.fixedSource!, { autoLet: true })
      expect(second.fixedSource).toBeUndefined()
      expect(second.diagnostics.filter((d) -> d.ruleId is "style/no-trailing-semicolons")).toHaveLength(0)

    it "preserves CRLF line endings", ->
      source := "x = 1;\r\ny = 2;\r\n"
      res := fixSemicolons(source, { autoLet: true })
      expect(res.fixedSource).toBe("x = 1\r\ny = 2\r\n")
      expect(res.isEquivalencePreserved).toBe(true)

    it "leaves semicolons inside string literals untouched", ->
      source := 'str = "hello; world";\n'
      expect(expectSemicolonFix(source, { autoLet: true })).toBe('str = "hello; world"\n')

    it "leaves semicolons inside comments untouched", ->
      source := "# comment with ; in it\nx = 1\n"
      res := fixSemicolons(source, { autoLet: true, coffeeComment: true })
      expect(res.fixedSource).toBeUndefined()
      expect(res.diagnostics.filter((d) -> d.ruleId is "style/no-trailing-semicolons")).toHaveLength(0)

    it "leaves for loop header semicolons untouched", ->
      source := "for (let i = 0; i < n; i++)\n  console.log(i)\n"
      res := fixSemicolons(source)
      expect(res.fixedSource).toBeUndefined()
      expect(res.diagnostics.filter((d) -> d.ruleId is "style/no-trailing-semicolons")).toHaveLength(0)

    it "composes with prefer-concise-arrow in one pass", ->
      source := "fn := () =>\n  return 1;\n"
      res := lintSource(source, {
        rules: {
          "style/no-trailing-semicolons": "error"
          "style/prefer-concise-arrow": "error"
        }
        fix: true
      })
      expect(res.isEquivalencePreserved).toBe(true)
      expect(res.fixedSource).toBe("fn := =>\n  return 1\n")

    it "adversarial: rejects rule declaring semicolon-style to sneak identifier rename", ->
      sneaky := {
        id: "test/sneaky-semicolon"
        meta: { description: "test", fixable: true, defaultSeverity: "error" }
        check: (ctx: any) ->
          ctx.declareEquivalenceReference?("semicolon-style", -> ctx.source.replace("VALUE", "CHANGED"))
          i := ctx.source.indexOf "VALUE"
          if i >= 0
            ctx.report({
              ruleId: "test/sneaky-semicolon"
              message: "sneaky"
              pos: i
              fix: { start: i, end: i + 5, replacement: "CHANGED" }
            })
      }
      registry := defaultRuleRegistry.clone()
      registry.register sneaky as any
      res := lintSource("y := VALUE\n", {
        registry
        rules: { "test/sneaky-semicolon": "error" }
        fix: true
      })
      expect(res.fixedSource).toBeUndefined()
      expect(res.isEquivalencePreserved).toBe(false)


  describe "style/prefer-bare-assignment", ->
    it "converts let to bare assignment under autoLet", ->
      source := "let x = 1\nlet y = 2\n"
      res := lintSource(source, {
        rules: { "style/prefer-bare-assignment": "error" }
        civetOptions: { autoLet: true }
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/prefer-bare-assignment"
      expect(diags.length).toBe(2)

      resFixed := lintSource(source, {
        rules: { "style/prefer-bare-assignment": "error" }
        civetOptions: { autoLet: true }
        fix: true
      })
      expect(resFixed.fixedSource).toBe("x = 1\ny = 2\n")
      expect(resFixed.isEquivalencePreserved).toBe(true)

    it "converts CONST_CASE constants to ':=' declarations", ->
      source := 'const TOTAL_STEPS = 3\nexport const WIND_ORDER = ["E", "S"]\n'
      res := lintSource(source, {
        rules: { "style/prefer-bare-assignment": "error" }
        civetOptions: { autoLet: true }
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/prefer-bare-assignment"
      expect(diags.length).toBe(2)

      resFixed := lintSource(source, {
        rules: { "style/prefer-bare-assignment": "error" }
        civetOptions: { autoLet: true }
        fix: true
      })
      expect(resFixed.fixedSource).toBe('TOTAL_STEPS := 3\nexport WIND_ORDER := ["E", "S"]\n')
      expect(resFixed.isEquivalencePreserved).toBe(true)

    it "is skipped when autoLet is off", ->
      source := "let x = 1\n"
      res := lintSource(source, {
        rules: { "style/prefer-bare-assignment": "error" }
        civetOptions: {}
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/prefer-bare-assignment"
      expect(diags.length).toBe(0)

  describe "style/prefer-existential-check", ->
    it "flags inequality null checks with suggestion x?", ->
      source := "valid := x != null\n"
      res := lintSource(source, {
        rules: { "style/prefer-existential-check": "error" }
        civetOptions: { autoLet: true, coffeeEq: true }
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/prefer-existential-check"
      expect(diags.length).toBe(1)
      expect(diags[0].message).toContain("x?")

    it "flags equality null checks with suggestion not x?", ->
      source := "invalid := x == null\n"
      res := lintSource(source, {
        rules: { "style/prefer-existential-check": "error" }
        civetOptions: { autoLet: true, coffeeEq: true, coffeeNot: true }
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/prefer-existential-check"
      expect(diags.length).toBe(1)
      expect(diags[0].message).toContain("not x?")

  describe "style/prefer-jsx-attr-shorthand", ->
    it "flags onClick={onClick} and disabled={true}", ->
      source := "<button onClick={onClick} disabled={true}>Click</button>\n"
      res := lintSource(source, {
        rules: { "style/prefer-jsx-attr-shorthand": "error" }
        civetOptions: { react: true }
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/prefer-jsx-attr-shorthand"
      expect(diags.length).toBe(2)
      expect(diags.some((d) -> d.message.includes("{onClick}"))).toBe(true)
      expect(diags.some((d) -> d.message.includes("disabled"))).toBe(true)

    it "is skipped when react is not enabled", ->
      source := "<button onClick={onClick}>Click</button>\n"
      res := lintSource(source, {
        rules: { "style/prefer-jsx-attr-shorthand": "error" }
        civetOptions: {}
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/prefer-jsx-attr-shorthand"
      expect(diags.length).toBe(0)

    it "fixes attr={attr} to {attr} without touching the compiled output", ->
      source := "x := <C users={users} />\n"
      res := lintSource(source, {
        rules: { "style/prefer-jsx-attr-shorthand": "error" }
        civetOptions: { react: true, autoLet: true }
        fix: true
      })
      expect(res.fixedSource).toBe("x := <C {users} />\n")
      expect(res.isEquivalencePreserved).toBe(true)

    // A lone attribute is stored as the bare entry rather than a one-element
    // list, and the engine's raw AST puts the `=` and braces at different
    // indices than the plain tree. Both shapes must resolve.
    it "flags a single attribute as well as several", ->
      for source of ["<C a={a} />\n", "<C a={a} b={b} />\n"]
        res := lintSource(source, {
          rules: { "style/prefer-jsx-attr-shorthand": "error" }
          civetOptions: { react: true }
        })
        diags := res.diagnostics.filter (d) -> d.ruleId is "style/prefer-jsx-attr-shorthand"
        expect(diags.length).toBeGreaterThan(0)

    it "leaves attr={other} alone", ->
      source := "<C a={b} />\n"
      res := lintSource(source, {
        rules: { "style/prefer-jsx-attr-shorthand": "error" }
        civetOptions: { react: true }
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/prefer-jsx-attr-shorthand"
      expect(diags.length).toBe(0)

    // `prop={true}` lowers to `prop`, which is a different emitted attribute, so
    // the finding must never carry a fix.
    it "reports prop={true} without offering a fix", ->
      source := "<C flag={true} />\n"
      res := lintSource(source, {
        rules: { "style/prefer-jsx-attr-shorthand": "error" }
        civetOptions: { react: true }
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/prefer-jsx-attr-shorthand"
      expect(diags.length).toBe(1)
      expect(diags[0].fix).toBeUndefined()

  describe "style/prefer-ampersand-shorthand", ->
    it "flags prop access callbacks and suggests & shorthand", ->
      source := "ids = users.map((u) => u.id)\n"
      res := lintSource(source, {
        rules: { "style/prefer-ampersand-shorthand": "error" }
        civetOptions: { autoLet: true }
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/prefer-ampersand-shorthand"
      expect(diags.length).toBe(1)
      expect(diags[0].message).toContain(".map &.id")

    it "flags method call callbacks and suggests & shorthand", ->
      source := "trimmed = lines.map((l) => l.trim())\n"
      res := lintSource(source, {
        rules: { "style/prefer-ampersand-shorthand": "error" }
        civetOptions: { autoLet: true }
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/prefer-ampersand-shorthand"
      expect(diags.length).toBe(1)
      expect(diags[0].message).toContain(".map &.trim()")

    it "allows method arguments that do not reference the callback parameter", ->
      source := "trimmed = lines.map((l) => l.slice(1))\n"
      res := lintSource(source, {
        rules: { "style/prefer-ampersand-shorthand": "error" }
        civetOptions: { autoLet: true }
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/prefer-ampersand-shorthand"
      expect(diags).toHaveLength(1)
      expect(diags[0].message).toContain(".map &.slice(1)")

    // The rule used to match with a regex whose character class ran past the
    // callback, so the quoted suggestion picked up delimiters belonging to the
    // enclosing call — `.map &.userId))` — and was a syntax error if pasted.
    it "never quotes trailing delimiters from the surrounding call", ->
      source := "ids = getRows().map((u) => u.userId)\n"
      res := lintSource(source, {
        rules: { "style/prefer-ampersand-shorthand": "error" }
        civetOptions: { autoLet: true }
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/prefer-ampersand-shorthand"
      expect(diags.length).toBe(1)
      expect(diags[0].message).toContain(".map &.userId")
      expect(diags[0].message).not.toContain("))")

    it "reports each link of a chained call", ->
      source := "seats = players.filter((p) => p.riichi).map((p) => p.seat)\n"
      res := lintSource(source, {
        rules: { "style/prefer-ampersand-shorthand": "error" }
        civetOptions: { autoLet: true }
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/prefer-ampersand-shorthand"
      expect(diags.length).toBe(2)
      expect(diags.some((d) -> d.message.includes(".filter &.riichi"))).toBe(true)
      expect(diags.some((d) -> d.message.includes(".map &.seat"))).toBe(true)

    // `&` stands in for the whole receiver, so a body that does anything beyond
    // accessing the parameter has no shorthand form.
    it "ignores callbacks that are not a bare access on the parameter", ->
      cases := [
        "a = users.map((u) => f(u.id))\n"          // parameter is an argument
        "b = users.map((u) => u.id is other)\n"    // comparison, not an access
        "c = users.map((u, i) => u.id)\n"          // more than one parameter
        "d = users.map(({ id }) => id)\n"          // destructured parameter
        "e = users.map((u) => u)\n"                // no access at all
        "f = users.map((u) => u.f(u))\n"           // parameter used as an argument
        "g = users.map((u) => u.a.map fn)\n"       // paren-less trailing call
      ]
      for source of cases
        res := lintSource(source, {
          rules: { "style/prefer-ampersand-shorthand": "error" }
          civetOptions: { autoLet: true }
        })
        diags := res.diagnostics.filter (d) -> d.ruleId is "style/prefer-ampersand-shorthand"
        expect(diags.length).toBe(0)

  describe "style/no-single-param-arrow-without-parens", ->
    it "flags unparenthesized single parameter arrow", ->
      source := "f = x => x + 1\n"
      res := lintSource(source, {
        rules: { "style/no-single-param-arrow-without-parens": "error" }
        civetOptions: { autoLet: true }
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/no-single-param-arrow-without-parens"
      expect(diags.length).toBe(1)
      expect(diags[0].message).toContain("write '(x) =>'")

    it "does not flag zero-arg arrows whose body is on the next line", ->
      // `beforeEach =>` / `useEffect =>` are the style guide's mandated zero-arg
      // form. Flagging them made the rule unsatisfiable on real code.
      source := "beforeEach =>\n  reset()\n\nuseEffect =>\n  go()\n"
      res := lintSource(source, {
        rules: { "style/no-single-param-arrow-without-parens": "error" }
        civetOptions: { autoLet: true }
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/no-single-param-arrow-without-parens"
      expect(diags).toHaveLength(0)

    it "does not flag TypeScript return-type annotations", ->
      // `(o: unknown): unknown => …` puts a TYPE where a parameter would be.
      source := "read = (o: unknown): unknown => go(o)\nf = (v: unknown): v is Foo => true\n"
      res := lintSource(source, {
        rules: { "style/no-single-param-arrow-without-parens": "error" }
        civetOptions: { autoLet: true }
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/no-single-param-arrow-without-parens"
      expect(diags).toHaveLength(0)

    it "does not flag async => or parenthesized arrows", ->
      source := "f = async => 42\ng = (x) => x + 1\n"
      res := lintSource(source, {
        rules: { "style/no-single-param-arrow-without-parens": "error" }
        civetOptions: { autoLet: true }
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/no-single-param-arrow-without-parens"
      expect(diags.length).toBe(0)

  describe "style/prefer-named-export-default", ->
    it "flags anonymous export default arrow", ->
      source := "export default (props) => 42\n"
      res := lintSource(source, {
        rules: { "style/prefer-named-export-default": "warn" }
        civetOptions: {}
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/prefer-named-export-default"
      expect(diags.length).toBe(1)
      expect(diags[0].message).toContain("Prefer named default export")

    it "accepts named export default", ->
      source := "export default MyComp = (props) => 42\n"
      res := lintSource(source, {
        rules: { "style/prefer-named-export-default": "warn" }
        civetOptions: {}
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/prefer-named-export-default"
      expect(diags.length).toBe(0)

  describe "style/no-thin-arrow", ->
    it "flags thin arrow usage", ->
      source := "f = (x) -> x + 1\n"
      res := lintSource(source, {
        rules: { "style/no-thin-arrow": "error" }
        civetOptions: { autoLet: true }
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/no-thin-arrow"
      expect(diags.length).toBe(1)
      expect(diags[0].message).toContain("Use fat arrow '=>' instead of thin arrow '->'")

  describe "style/no-pipe-operator", ->
    it "flags pipe operator usage", ->
      source := "res = val |> process\n"
      res := lintSource(source, {
        rules: { "style/no-pipe-operator": "error" }
        civetOptions: { autoLet: true }
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/no-pipe-operator"
      expect(diags.length).toBe(1)
      expect(diags[0].message).toContain("Disallowed pipe operator '|>'")

  describe "style/prefer-range-operator", ->
    it "flags Array.from length and suggests range map", ->
      source := "items = Array.from({ length: 5 }, (_, i) => i * 2)\n"
      res := lintSource(source, {
        rules: { "style/prefer-range-operator": "error" }
        civetOptions: { autoLet: true, coffeeRange: true }
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/prefer-range-operator"
      expect(diags.length).toBe(1)
      expect(diags[0].message).toContain("[0...5].map")

    it "is skipped when coffeeRange is disabled", ->
      source := "items = Array.from({ length: 5 }, (_, i) => i * 2)\n"
      res := lintSource(source, {
        rules: { "style/prefer-range-operator": "error" }
        civetOptions: { autoLet: true }
      })
      diags := res.diagnostics.filter (d) -> d.ruleId is "style/prefer-range-operator"
      expect(diags.length).toBe(0)
