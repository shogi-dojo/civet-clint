import { describe, it, expect } from "vitest"
import { lintSource, lintPhased, compileSource } from "../src/engine.civet"
import { normalizeFunctionDeclarationStyle } from "../src/utils.civet"

RULE := "style/prefer-function-declaration"

function fix(source: string)
  lintSource(source, {
    rules: { [RULE]: "error", "style/prefer-word-operators": "off" }
    fix: true
  })

describe RULE, ->
  it "converts a safe named const arrow block to a function declaration", ->
    source := "const f = (x) => { return x + 1 }\n"
    res := fix(source)
    expect(res.fixedSource).toBe("function f(x) { return x + 1 }\n")
    expect(res.isEquivalencePreserved).toBe(true)
    expect(normalizeFunctionDeclarationStyle(compileSource(source))).toBe(compileSource(res.fixedSource!))

  it "runs before block de-indentation to avoid overlapping arrow-body edits", ->
    source := "const f = (x) => {\n  const y = x + 1\n  return y\n}\n"
    result := lintPhased(source, {
      rules: {
        [RULE]: "warn"
        "style/prefer-indented-blocks": "error"
      }
      fix: true
    })
    expect(result.fixedSource).toBe("function f(x)\n  const y = x + 1\n  return y\n")
    expect(result.diagnostics.filter((d) -> d.ruleId.startsWith("compiler-equivalence-")).map((d) -> d.ruleId)).toEqual([])

  it "preserves export, default parameters, and return types", ->
    source := "export const f = (x: number = 1): number => { return x + 1 }\n"
    res := fix(source)
    expect(res.fixedSource).toBe("export function f(x: number = 1): number { return x + 1 }\n")
    expect(res.isEquivalencePreserved).toBe(true)

  it "preserves generic function signatures", ->
    source := "const id = <T>(x: T): T => { return x }\n"
    res := fix(source)
    expect(res.fixedSource).toBe("function id<T>(x: T): T { return x }\n")
    expect(res.isEquivalencePreserved).toBe(true)

  it "reports but does not fix lexical this, use-before, or reassignment cases", ->
    cases := [
      "const f = (x) => { return this.value + x }\n"
      "const f = (x) => { return @value + x }\n"
      "const f = (x) => { return @ }\n"
      "f()\nconst f = (x) => { return x }\n"
      "const f = (x) => { return x }\nf = other\n"
    ]
    for source of cases
      res := fix(source)
      diags := res.diagnostics.filter (d) -> d.ruleId is RULE
      expect(diags).toHaveLength(1)
      expect(diags[0].fix).toBeUndefined()
      expect(res.isEquivalencePreserved).toBe(true)

describe `${RULE} on Civet-style declarations`, ->
  it "converts a `name :=` arrow with an indented body, keeping the body text", ->
    source := "export bitAt := (pattern: number, port: number): 0 | 1 =>\n  ((pattern >> port) & 1) as 0 | 1\n"
    res := fix(source)
    expect(res.fixedSource).toBe("export function bitAt(pattern: number, port: number): 0 | 1\n  ((pattern >> port) & 1) as 0 | 1\n")
    expect(res.isEquivalencePreserved).toBe(true)

  it "gives a parameterless arrow an empty parameter list", ->
    res := fix("undo := =>\n  a()\n  b();\n")
    expect(res.fixedSource).toBe("function undo()\n  a()\n  b();\n")

  it "handles a multi-line parameter list and async", ->
    res := fix("sym := (\n  degree: number\n  label = `x`\n): Constraint =>\n  a()\n  return { degree }\n")
    expect(res.fixedSource).toBe("function sym(\n  degree: number\n  label = `x`\n): Constraint\n  a()\n  return { degree }\n")
    expect(fix("load := async (id: string) =>\n  await get(id)\n").fixedSource).toBe("async function load(id: string)\n  await get(id)\n")

  it "leaves one-line arrows and plain assignments alone", ->
    for source of ["inc := (x: number) => x + 1\n", "handler = (x) =>\n  x + 1\n"]
      res := fix(source)
      expect(res.diagnostics.filter (d) -> d.ruleId is RULE).toHaveLength(0)

  it "refuses an indented body that uses `@`", ->
    res := fix("class A\n  m()\n    g := (x: number) =>\n      @v + x\n    g(1)\n")
    diags := res.diagnostics.filter (d) -> d.ruleId is RULE
    expect(diags).toHaveLength(1)
    expect(diags[0].fix).toBeUndefined()

describe "normalizeFunctionDeclarationStyle", ->
  it "does not mistake a parenthesised initialiser for a parameter list", ->
    code := "const a = (nav as Nav).data\nconst f = (x) => {\n  return x\n}\n"
    expect(normalizeFunctionDeclarationStyle(code)).toBe("const a = (nav as Nav).data\nfunction f(x) {\n  return x\n}\n")
