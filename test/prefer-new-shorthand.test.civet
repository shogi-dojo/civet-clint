import { describe, it, expect } from "vitest"
import { lintSource, compileSource } from "../src/engine.civet"
import { normalizeNewCallStyle } from "../src/utils.civet"

RULE := "style/prefer-new-shorthand"

function fix(source: string)
  lintSource(source, { rules: { [RULE]: "error" }, fix: true })

describe RULE, ->
  it "omits empty constructor parentheses", ->
    source := "x := new Foo()\n"
    res := fix(source)
    expect(res.fixedSource).toBe("x := new Foo\n")
    expect(res.isEquivalencePreserved).toBe(true)
    expect(compileSource(source)).toBe("const x = new Foo()\n")
    expect(compileSource(res.fixedSource!)).toBe("const x = new Foo\n")

  it "keeps a constructed value grouped before chained access", ->
    source := "x := new Foo().bar\n"
    res := fix(source)
    expect(res.fixedSource).toBe("x := (new Foo).bar\n")
    expect(res.isEquivalencePreserved).toBe(true)

  it "does not rewrite constructors with arguments or dynamic constructors", ->
    source := "x := new Foo(value)\ny := new (factory())()\n"
    expect(fix(source).fixedSource).toBeUndefined()


  it "accepts Civet's constructor grouping in the true arm of a conditional", ->
    source := "x := if bad then new Foo() else value\n"
    result := fix(source)
    expect(result.fixedSource).toBe("x := if bad then new Foo else value\n")
    expect(result.isEquivalencePreserved).toBe(true)

  it "accepts a `new X` that is the argument of a call inside a conditional", ->
    // The delta used to read `AiAdvisor(new AI) : null` as a parenthesised `(new AI)`
    // followed by `:` and unwrap it into `AiAdvisornew AI()`, which rejected this fix
    // and every other `new X()` fix in the same file.
    source := "advisor := if timedOut then new AiAdvisor(new AI()) else null\nm := new Map()\n"
    result := fix(source)
    expect(result.fixedSource).toBe("advisor := if timedOut then new AiAdvisor(new AI) else null\nm := new Map\n")
    expect(result.isEquivalencePreserved).toBe(true)

describe "normalizeNewCallStyle", ->
  it "unwraps a grouped construction before access, not a call's argument list", ->
    expect(normalizeNewCallStyle("x = (new Foo).bar")).toBe("x = new Foo().bar")
    expect(normalizeNewCallStyle("x = c? g(new Foo) : y")).toBe("x = c? g(new Foo) : y")
    expect(normalizeNewCallStyle("x = c? new G(new Foo()) : y")).toBe("x = c? new G(new Foo) : y")
