import { walkAst, collectCommentRanges, collectStringRanges } from "./utils.civet"

export interface SourceRange
  start: number
  end: number

export interface SourceToken
  value: string
  raw: string
  range: SourceRange
  synthetic: boolean

export interface JsxAttribute
  name?: string
  value?: any
  range?: SourceRange
  start?: number
  equals?: any
  quotedValue?: string
  expression?: any
  bracedRange?: SourceRange
  isSpread: boolean

export interface JsxAttributeOptions
  // Preserve the old class/id shorthand rule's behavior: leading source trivia
  // before the opening tag made that rule leave the element untouched.
  requireOpeningAtStart?: boolean

export class SyntaxTree
  source: string
  root: any

  // Derived data is memoized per tree. Every accessor below is a pure function
  // of (@root, @source), and both are assigned once in the constructor and never
  // reassigned -- each parse yields a fresh SyntaxTree -- so a cache tied to the
  // instance cannot go stale. Without this, commentRanges()/stringRanges() each
  // re-walked the entire AST on every call, and ~20 rules call them per file.
  #commentRanges: SourceRange[] | undefined
  #stringRanges: SourceRange[] | undefined
  #tokens: WeakMap<any, SourceToken[]>

  constructor(ast: any, source: string)
    // `ast` is Civet's unpruned tree. All raw tuple/parent handling stays in this
    // adapter so rules consume named nodes, source tokens, ranges, and normalized
    // helpers instead of depending on compiler layout directly.
    @source = source
    @root = ast
    @#tokens = new WeakMap<any, SourceToken[]>()

  // Source span of a node or token.
  range(node: any): SourceRange | undefined
    return undefined unless node?
    if typeof node.start is "number" and typeof node.end is "number"
      return { start: node.start, end: node.end }
    if Array.isArray(node.range) and node.range.length >= 2
      return { start: node.range[0], end: node.range[1] }
    if node.range?.start? and node.range?.end?
      return { start: node.range.start, end: node.range.end }
    if node.$loc
      pos := node.$loc.pos
      len := node.$loc.length or 0
      return { start: pos, end: pos + len }

    var lo = Infinity
    var hi = -Infinity
    walkAst node, (child) ->
      return unless child?.$loc
      pos := child.$loc.pos
      len := child.$loc.length or 0
      lo = Math.min(lo, pos)
      hi = Math.max(hi, pos + len)

    return undefined unless hi > lo
    { start: lo, end: hi }

  // Range of a node ONLY when it is a source token carrying its own location.
  // Unlike `range`, this never falls back to a subtree walk: callers that just
  // want token spans (scanning for an operator, say) would otherwise pay an
  // O(subtree) cost on every interior node that can never be a token.
  tokenRange(node: any): SourceRange | undefined
    return undefined unless node? and node.$loc and typeof node.token is "string"
    pos := node.$loc.pos
    len := node.$loc.length or 0
    { start: pos, end: pos + len }

  // Slice of source text corresponding to a node or range.
  text(nodeOrRange: any): string
    return "" unless nodeOrRange?
    if typeof nodeOrRange.start is "number" and typeof nodeOrRange.end is "number"
      return @source.slice(nodeOrRange.start, nodeOrRange.end)
    span := @range(nodeOrRange)
    return "" unless span?
    @source.slice(span.start, span.end)

  // Direct child nodes of a node, normalizing tuple and array structures.
  children(node: any): any[]
    return [] unless node? and typeof node is "object"
    res: any[] := []

    if Array.isArray(node)
      for item of node
        if item? and typeof item is "object"
          res.push(item)
    else
      for key of Object.keys(node)
        continue if key is "parent" or key is "$loc" or key is "type"
        val := node[key]
        if val? and typeof val is "object"
          if Array.isArray(val)
            for item of val
              if item? and typeof item is "object"
                res.push(item)
          else
            res.push(val)
    res

  // All source tokens beneath a node (or root if omitted).
  tokens(node?: any): SourceToken[]
    target := node or @root
    cached := @#tokens.get(target)
    return cached if cached?
    tokensList: SourceToken[] := []
    source := @source

    walkAst target, (n) ->
      return unless n? and typeof n is "object"
      if n.$loc and typeof n.token is "string"
        pos := n.$loc.pos
        len := n.$loc.length or 0
        range: SourceRange := { start: pos, end: pos + len }
        raw := source.slice(pos, pos + len)
        value := n.token
        synthetic := raw isnt value or len is 0
        tokensList.push({ value, raw, range, synthetic })

    tokensList.sort (a, b) -> a.range.start - b.range.start
    @#tokens.set(target, tokensList)
    tokensList

  findToken(node: any, tokenValue: string): SourceToken | undefined
    for tok of @tokens(node)
      return tok if tok.value is tokenValue
    undefined

  // Traverses AST calling callback for matching node type or all nodes beneath target (or root).
  visit(targetOrType: any, typeOrCallback?: any, callback?: any): void
    var target = @root
    var type: any = undefined
    var cb: any = undefined

    if typeof targetOrType is "function"
      cb = targetOrType
    else if typeof targetOrType is "string" or Array.isArray(targetOrType)
      type = targetOrType
      cb = typeOrCallback
    else if targetOrType and typeof targetOrType is "object"
      target = targetOrType
      if typeof typeOrCallback is "function"
        cb = typeOrCallback
      else
        type = typeOrCallback
        cb = callback

    return unless cb
    if not type
      walkAst target, cb
    else if typeof type is "string"
      targetType := type
      walkAst target, (node, parent) ->
        if node?.type is targetType
          cb(node, parent)
    else if Array.isArray(type)
      typeSet := new Set(type)
      walkAst target, (node, parent) ->
        if typeSet.has(node?.type)
          cb(node, parent)

  // Extract JSX attributes from a JSXElement node while preserving every entry's
  // source order, including spreads and Civet's `{name}` shorthand.
  jsxAttributes(jsxElementNode: any, options: JsxAttributeOptions = {}): JsxAttribute[]
    attrs: JsxAttribute[] := []
    return attrs unless jsxElementNode?.type is "JSXElement"

    rawList := @extractRawAttributes(jsxElementNode, options.requireOpeningAtStart is true)
    for attr of rawList
      // Civet 0.11.5 can leave whitespace strings between sibling shorthand
      // attribute tuples. They are separators, not attributes or spread barriers.
      continue if typeof attr is "string" and attr.trim() is ""
      if attr?.type is "JSXAttribute"
        attrs.push(@normalizeJsxAttribute(attr))
        continue
      // Civet 0.11.5 wraps each shorthand tuple in a leading-whitespace pair,
      // unlike named attributes. Preserve that wrapper's start while exposing
      // the identifier and braced source range to the JSX shorthand rules.
      if Array.isArray(attr) and attr[0]?.token? and Array.isArray(attr[1]) and
        attr[1].length is 1 and Array.isArray(attr[1][0]) and
        attr[1][0][0]?.type is "Identifier" and attr[1][0][1] is "={"
        shorthand := attr[1][0]
        exprSpan := @range(shorthand[2])
        attrSpan := @range(attr)
        var bracedRange: SourceRange | undefined = undefined
        if exprSpan and @source[exprSpan.start - 1] is "{" and @source[exprSpan.end] is "}"
          bracedRange = { start: exprSpan.start - 1, end: exprSpan.end + 1 }
        attrs.push({
          name: shorthand[0].name
          expression: shorthand[2]
          range: attrSpan
          start: attrSpan?.start
          bracedRange
          isSpread: false
        })
        continue
      // Civet 0.11.5 lowers `<C {name} />` to a tuple of the identifier, a
      // synthetic `={` marker, the identifier value, and a closing brace.
      if Array.isArray(attr) and attr[0]?.type is "Identifier" and attr[1] is "={"
        shorthandName := attr[0].name
        shorthandExpr := attr[2]
        exprSpan := @range(shorthandExpr)
        var shorthandRange: SourceRange | undefined = undefined
        if exprSpan and @source[exprSpan.start - 1] is "{" and @source[exprSpan.end] is "}"
          shorthandRange = { start: exprSpan.start - 1, end: exprSpan.end + 1 }
        attrs.push({
          name: shorthandName
          expression: shorthandExpr
          range: @range(attr)
          start: shorthandRange?.start
          bracedRange: shorthandRange
          isSpread: false
        })
        continue
      name := @extractAttributeName(attr)
      range := @range(attr)
      body := if Array.isArray(attr) then attr[1] else undefined
      value := if Array.isArray(body) then body[1] else undefined
      var equals: any = undefined
      var quotedValue: string | undefined = undefined
      var braced: any = undefined
      if Array.isArray(value)
        equals = value.find (part: any) -> part?.token is "="
        quotedValue = value.find (part: any) ->
          typeof part is "string" and (
            (part.startsWith('"') and part.endsWith('"')) or
            (part.startsWith("'") and part.endsWith("'"))
          )
        braced = value.find (part: any) -> Array.isArray(part) and part[0]?.token is "{"
      var expression: any = undefined
      if Array.isArray(braced)
        expression = braced.slice(1, -1).find (part: any) -> part? and part isnt "" and typeof part isnt "string"
      // Civet 0.11.5 represents `{name}` as an identifier in the attribute-name
      // slot and synthetic `={` / `}` strings in the value slot.
      oldShorthand := Array.isArray(body) and body[0]?.type is "Identifier"
      expression ?= body[0] if oldShorthand
      openBrace := if Array.isArray(braced) then braced[0] else undefined
      closeBrace := if Array.isArray(braced) then braced[braced.length - 1] else undefined
      openSpan := @range(openBrace)
      closeSpan := @range(closeBrace)
      var bracedRange: SourceRange | undefined = undefined
      if openSpan and closeSpan
        bracedRange = { start: openSpan.start, end: closeSpan.end }
      else if oldShorthand and expression?
        exprSpan := @range(expression)
        if exprSpan and @source[exprSpan.start - 1] is "{" and @source[exprSpan.end] is "}"
          bracedRange = { start: exprSpan.start - 1, end: exprSpan.end + 1 }
      leadingSpan := if Array.isArray(attr) then @range(attr[0]) else undefined
      equalsSpan := @range(equals)
      var start: number | undefined = leadingSpan?.start
      start ?= equalsSpan.start - name.length if equalsSpan and name?
      rawTokens := @tokens(attr)
      isSpread := not name? and rawTokens.some (token) -> token.value is "..."
      attrs.push({ name, value, range, start, equals, quotedValue, expression, bracedRange, isSpread })
    attrs

  private normalizeJsxAttribute(attr: any): JsxAttribute
    name := @extractAttributeName(attr)
    hasExplicitName := Array.isArray(attr.name) or typeof attr.name is "string"
    attrSpan := @range(attr)
    rawTokens := @tokens(attr)
    eqToken := rawTokens.find (token) -> token.value is "=" and token.raw is "="
    equals := if eqToken then { token: "=", $loc: { pos: eqToken.range.start, length: 1 } } else undefined
    equalsSpan := if eqToken then eqToken.range else undefined
    value := attr.value

    var expression: any = undefined
    if value? and typeof value is "object"
      walkAst value, (node) ->
        return unless node? and typeof node is "object" and typeof node.type is "string"
        // The first typed node is the actual expression in both Civet 0.11.15's
        // tuple-based representation and 0.11.16's JSXAttribute node.
        expression ?= node

    quotedValue := if typeof value is "string" and (
      (value.startsWith('"') and value.endsWith('"')) or
      (value.startsWith("'") and value.endsWith("'"))
    ) then value else undefined

    openToken := rawTokens.find (token) -> token.value is "{" and token.raw is "{"
    closeToken := [...rawTokens].reverse().find (token) -> token.value is "}" and token.raw is "}"
    var bracedRange: SourceRange | undefined = undefined
    if openToken and closeToken
      bracedRange = { start: openToken.range.start, end: closeToken.range.end }
    else if not hasExplicitName and expression?
      exprSpan := @range(expression)
      if exprSpan and @source[exprSpan.start - 1] is "{" and @source[exprSpan.end] is "}"
        bracedRange = { start: exprSpan.start - 1, end: exprSpan.end + 1 }

    var start: number | undefined = undefined
    if hasExplicitName and name? and equalsSpan
      start = equalsSpan.start - name.length
      while start > 0 and /\s/.test(@source[start - 1])
        start--
    else if bracedRange
      start = bracedRange.start
    else if attrSpan
      start = attrSpan.start

    isSpread := not name? and rawTokens.some (token) -> token.value is "..."
    { name, value, range: attrSpan, start, equals, quotedValue, expression, bracedRange, isSpread }

  private extractRawAttributes(jsxElement: any, requireOpeningAtStart: boolean): any[]
    tree := this
    children := jsxElement?.children
    return [] unless Array.isArray(children)

    // Civet 0.11.16 exposes JSX attributes as named nodes. Collect only nodes
    // whose direct parent is this element, so nested JSX children cannot leak
    // their attributes into the opening tag.
    normalized: any[] := []
    walkAst children, (node) ->
      normalized.push(node) if node?.type is "JSXAttribute" and node.parent is jsxElement
    if normalized.length > 0
      normalized.sort (left, right) ->
        (tree.range(left)?.start ?? 0) - (tree.range(right)?.start ?? 0)
      return normalized

    isOpenAngle := (c: any) -> c is "<" or c?.token is "<"
    extractName := @extractAttributeName.bind(this)
    isAttr := (v: any) -> extractName(v)?

    asAttributeList := (value: any): any[] | undefined ->
      return undefined unless Array.isArray(value) and value.length > 0
      return [value] if isAttr value
      if value.some isAttr
        // Keep non-named entries. They are ordering barriers for `.class`/`#id`
        // lowering even though another rule may not inspect them directly.
        return value
      // The 0.11.5 JSX shape adds an array layer around each attribute and then
      // another around the attribute list. Flatten that wrapper while preserving
      // source order; leave spread entries intact as barriers between attributes.
      flattened: any[] := []
      for item of value
        if isAttr item
          flattened.push(item)
        else if Array.isArray(item)
          nested := asAttributeList(item)
          if nested
            flattened.push(...nested)
          else if tree.tokens(item).some((token) -> token.value is "...")
            flattened.push(item)
      return flattened if flattened.length > 0
      undefined

    var opening: any[] | undefined = undefined
    if isOpenAngle(children[0])
      opening = children
    else if Array.isArray(children[0]) and children[0].some(isOpenAngle)
      opening = children[0]
    else
      if requireOpeningAtStart
        elementSpan := @range(jsxElement)
        openPos := if elementSpan then @source.indexOf("<", elementSpan.start) else -1
        return [] unless elementSpan and openPos >= 0 and
          @source.slice(elementSpan.start, openPos).trim() is ""
      if children.some(isOpenAngle)
        opening = children
      else
        opening = children.find (child: any) -> Array.isArray(child) and child.some(isOpenAngle)

    return [] unless opening?
    for slot of opening
      list := asAttributeList slot
      return list if list?

    []

  private extractAttributeName(attr: any): string | undefined
    if attr?.type is "JSXAttribute"
      rawName := attr.name
      if Array.isArray(rawName) and typeof rawName[0] is "string"
        return rawName[0]
      if typeof rawName is "string"
        return rawName
      var shorthand: string | undefined = undefined
      if attr.value? and typeof attr.value is "object"
        walkAst attr.value, (node) ->
          shorthand ?= node.name if node?.type is "Identifier" and typeof node.name is "string"
      return shorthand
    return attr[0].name if Array.isArray(attr) and attr[0]?.type is "Identifier" and attr[1] is "={"
    return undefined unless Array.isArray(attr) and attr.length >= 2
    attrBody := attr[1]
    return undefined unless Array.isArray(attrBody) and attrBody.length >= 2
    namePart := attrBody[0]
    if Array.isArray(namePart) and typeof namePart[0] is "string"
      namePart[0]
    else if namePart?.type is "Identifier" and typeof namePart.name is "string"
      namePart.name
    else if typeof namePart is "string"
      namePart
    else
      undefined

  // Normalized type of a node's immediate parent. Rules use this instead of
  // reaching into Civet's parent layout, which the structural AST guard forbids.
  parentType(node: any): string | undefined
    parent := node?.parent
    return undefined unless parent? and typeof parent is "object"
    if typeof parent.type is "string" then parent.type else undefined

  // Whether a raw node is nested under one of the requested normalized node types.
  // Rules use this helper instead of depending on Civet's parent layout directly.
  hasAncestorType(node: any, types: string | string[]): boolean
    wanted := new Set(if Array.isArray(types) then types else [types])
    seen := new Set<any>()
    var current = node?.parent
    while current? and typeof current is "object" and not seen.has(current)
      return true if wanted.has(current.type)
      seen.add(current)
      current = current.parent
    false

  // Ranges of all comments.
  commentRanges(): SourceRange[]
    @#commentRanges ??= collectCommentRanges(@root)

  // Ranges of all string/template literals.
  stringRanges(): SourceRange[]
    @#stringRanges ??= collectStringRanges(@root)
