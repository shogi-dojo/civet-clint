import type { SyntaxTree } from "./syntax.civet"

export type Severity = "warn" | "error"
export type RuleLevel = "off" | "warn" | "error"

export type RuleOptions = Record<string, any>
export type RuleEntry = RuleLevel | [RuleLevel, RuleOptions]
export type CompileDial = Record<string, any>
export type CompileOptions = Record<string, any>
export type CompilerPreference = "project" | "bundled"

export interface CivetCompiler
  compile: (source: string, options?: Record<string, any>) => any

export interface CompilerResolution
  compiler: CivetCompiler
  version: string
  path: string
  preference: CompilerPreference
  usedBundled: boolean
  warning?: string

export interface Fix
  start: number
  end: number
  replacement: string

export interface Diagnostic
  ruleId: string
  severity: Severity
  message: string
  line: number
  column: number
  pos?: number
  fix?: Fix

export type EquivalenceReference = (source: string) => string | undefined
export type OutputDelta = "quote-style" | "semicolon-style" | "declaration-style" | "trailing-comma-style" | "whitespace-style" | "block-brace-style" | "type-paren-style" | "return-paren-style" | "inequality-style" | "new-call-style" | "placeholder-param" | "range-loop" | "function-declaration" | "existential-paren-style"

export interface RuleContext
  source: string
  syntax: SyntaxTree
  filename?: string
  options: RuleOptions
  parseOptions: CompileDial
  // The engine's own baseline compile of `source`, under the same dial and
  // compile options it uses everywhere else. Rules that need to compare a
  // candidate against unmodified output should use this rather than recompiling:
  // it is the identical value, already paid for. Absent only if a caller built a
  // context without one.
  baselineOutput?: string
  compiler?: CivetCompiler
  report: (diag: {
    ruleId: string
    severity?: Severity
    message: string
    line?: number
    column?: number
    pos?: number
    fix?: Fix
  }) => void
  getLineColumn: (pos: number) => { line: number, column: number }
  // `delta` lists the emit dimensions the fix is allowed to move: a single kind,
  // or several when one rewrite touches more than one (e.g. a postfix conditional
  // gains braces AND drops a semicolon). The gate composes the kinds' normalizers
  // and requires the composed emit to match, so only declared dimensions may move.
  declareEquivalenceReference?: (delta: OutputDelta | OutputDelta[], build: EquivalenceReference) => void

export interface RuleCapability
  requires?: string[]
  requiresAny?: string[]
  forbids?: string[]

// Rules run in ascending phase order, and the engine re-parses between phases so a
// later phase sees the text earlier phases produced. Ordering matters when one rule
// creates the conditions another depends on: de-bracing an arrow body (phase
// "repair") is what makes its trailing semicolons genuinely redundant, so
// style/no-trailing-semicolons must not run until that has happened.
//
//   repair      — semantic repairs that intentionally change emitted output.
//                 Gated by behaviour (the test suite), not byte-equality.
//   declaration — binding-preserving declaration rewrites, before body idioms.
//   idiom       — the default. Output-preserving style fixes.
//   cleanup     — fixes that only become correct once earlier phases have run.
export type RulePhase = "repair" | "declaration" | "idiom" | "cleanup"

export const RULE_PHASE_ORDER: RulePhase[] = ["repair", "declaration", "idiom", "cleanup"]

export interface RuleMeta
  description: string
  fixable: boolean
  defaultSeverity: Severity
  // Defaults to "idiom" when omitted.
  phase?: RulePhase
  allowFixesInsideComments?: boolean
  capabilities?: RuleCapability
  conflictsWith?: string[]
  defaultOptions?: RuleOptions

export interface Rule
  id: string
  meta: RuleMeta
  check: (context: RuleContext) => void

export interface Plugin
  name: string
  rules?: Rule[] | Record<string, Rule>

export interface ConfigOverride
  files: string | string[]
  preset?: string
  civetConfig?: string
  compiler?: CompilerPreference
  rules?: Record<string, RuleEntry>
  civetOptions?: CompileDial
  compileOptions?: CompileOptions

// One suppressed finding. `file` is relative to the exceptions file; without a
// `line` the entry covers every finding of `rule` in that file.
export interface ExceptionEntry
  file: string
  rule: string
  line?: number
  reason?: string

export interface ClintConfig
  preset?: string
  civetConfig?: string
  exceptions?: string
  compiler?: CompilerPreference
  rules?: Record<string, RuleEntry>
  overrides?: ConfigOverride[]

export interface SkippedRule
  ruleId: string
  reason: string

export interface ResolvedConfig
  preset: string
  rules: Record<string, RuleLevel>
  ruleOptions: Record<string, RuleOptions>
  civetConfigPath?: string
  civetOptions: CompileDial
  compileOptions: CompileOptions
  compiler: CivetCompiler
  compilerVersion: string
  compilerPath: string
  compilerPreference: CompilerPreference
  compilerUsedBundled: boolean
  compilerWarning?: string
  configPath?: string
  exceptionsPath?: string
  // Entries of the exceptions file, with `file` resolved to an absolute path.
  exceptions?: ExceptionEntry[]
  skippedRules: SkippedRule[]
  overrides?: ConfigOverride[]
  matchingOverrides?: string[]

export interface LintResult
  filePath: string
  source: string
  fixedSource?: string
  diagnostics: Diagnostic[]
  appliedFixesCount: number
  isEquivalencePreserved: boolean
  errorCount: number
  warningCount: number
  fixableCount: number
  // Findings hidden by the exceptions file, and the indices (into
  // `ResolvedConfig.exceptions`) of the entries that hid them.
  suppressedCount?: number
  usedExceptions?: number[]
