export type Severity = "warn" | "error"
export type RuleLevel = "off" | "warn" | "error"

// Per-rule options, supplied in a config's rules map with the array form
// `["error", { ...options }]`. Options are rule-defined; Clint only validates that
// the container is a plain object and hands it to the rule as-is.
export type RuleOptions = Record<string, any>

// A rule entry as written in a config file: either a bare level or a
// `[level, options]` pair. The bare form stays the canonical spelling — options are
// opt-in, and a rule that declares none never needs the array form.
export type RuleEntry = RuleLevel | [RuleLevel, RuleOptions]

// The Civet compiler "dial" — the `parseOptions` object that selects Coffee/React/TS
// parsing behaviors. Civet reserves the right to change these keys; Clint treats the
// dial opaquely and only inspects the handful of option keys declared in
// `RuleCapability.requires`.
export type CompileDial = Record<string, any>

// Top-level `CompileOptions` fields (everything outside `parseOptions`) retained from
// the project's `civet.json`. Clint controls `sync`, `ast`, and `filename` itself; the
// remaining user-supplied fields (e.g. `js`, `trace`) are threaded through so the
// baseline and candidate compiles run under the same pipeline the project uses.
export type CompileOptions = Record<string, any>

export interface Fix
  start: number
  end: number
  replacement: string

export interface Diagnostic
  ruleId: string
  severity: Severity
  message: string
  line: number
  column: number
  pos?: number
  fix?: Fix

// A rule may declare that a batch of its fixes is not byte-identical, but is
// nonetheless equivalent, by supplying the source that the fixed output should be
// compared against. The engine compiles this *reference source* and requires the
// fixed source to match it byte-for-byte — so the comparison stays exact and the
// rule never gets to inspect or massage compiled output. See `src/engine.civet`.
export type EquivalenceReference = (source: string) => string | undefined

// The kinds of emitted-output difference a rule may declare. The engine, not the
// rule, defines what each kind permits, so a rule cannot widen its own allowance.
// `quote-style`: outputs must be identical once string-literal quoting is normalized.
export type OutputDelta = "quote-style"

export interface RuleContext
  source: string
  ast: any
  filename?: string
  // Options for the currently executing rule, already merged over the rule's
  // declared defaults. Empty when the config supplies none.
  options: RuleOptions
  // The resolved compiler dial for the current file. Rules consult this to avoid
  // emitting rewrites whose replacement is invalid under the active dial — e.g. the
  // `isnt` rewrite is only valid when `coffeeIsnt` is enabled.
  parseOptions: CompileDial
  report: (diag: {
    ruleId: string
    severity?: Severity
    message: string
    line?: number
    column?: number
    pos?: number
    fix?: Fix
  }) => void
  getLineColumn: (pos: number) => { line: number, column: number }
  // Registers a reference-source builder for this rule's fix batch (see
  // `EquivalenceReference`) together with the kind of emitted-output difference the
  // rule is permitted to cause. Both are required: the reference says what the
  // output should be, and the delta bounds how far it may move. Only consulted when
  // the strict byte comparison against the original output fails, so the default
  // path is unaffected.
  declareEquivalenceReference?: (delta: OutputDelta, build: EquivalenceReference) => void

// Declares what a rule needs from the compiler dial. When a key in `requires` is not
// truthy under the resolved dial, the rule is explicitly skipped (see
// `ResolvedConfig.skippedRules`) rather than emitting fixes that are invalid for the
// active configuration.
export interface RuleCapability
  requires?: string[]
  // At least one of these dial keys must be truthy.
  requiresAny?: string[]

export interface RuleMeta
  description: string
  fixable: boolean
  defaultSeverity: Severity
  capabilities?: RuleCapability
  // Default values for every option the rule understands. Config-supplied options
  // are merged over these, and any key absent here is rejected as unknown — so a
  // typo in a config is a hard error rather than a silently ignored setting.
  defaultOptions?: RuleOptions

export interface Rule
  id: string
  meta: RuleMeta
  check: (context: RuleContext) => void

export interface Plugin
  name: string
  rules?: Rule[] | Record<string, Rule>

export interface ConfigOverride
  files: string | string[]
  preset?: string
  civetConfig?: string
  rules?: Record<string, RuleEntry>
  civetOptions?: CompileDial
  compileOptions?: CompileOptions

export interface ClintConfig
  preset?: string
  civetConfig?: string
  rules?: Record<string, RuleEntry>
  overrides?: ConfigOverride[]

export interface SkippedRule
  ruleId: string
  reason: string

export interface ResolvedConfig
  preset: string
  // Levels stay separate from options so every existing consumer of `rules`
  // (severity lookups, `computeSkippedRules`, `--print-config`) is unaffected by
  // the introduction of options.
  rules: Record<string, RuleLevel>
  // Config-supplied options per rule, before merging with the rule's defaults.
  // Absent entries mean the rule runs on its declared defaults.
  ruleOptions: Record<string, RuleOptions>
  civetConfigPath?: string
  // The compiler dial (`parseOptions`). Backward-compatible field name.
  civetOptions: CompileDial
  // Retained top-level CompileOptions from `civet.json` (outside `parseOptions`).
  compileOptions: CompileOptions
  configPath?: string
  // Rules that were enabled but cannot run under the resolved dial. Surfaced by
  // `clint --print-config` and never executed, so they never report invalid autofixes.
  skippedRules: SkippedRule[]
  overrides?: ConfigOverride[]
  matchingOverrides?: string[]

export interface LintResult
  filePath: string
  source: string
  fixedSource?: string
  diagnostics: Diagnostic[]
  appliedFixesCount: number
  isEquivalencePreserved: boolean
  errorCount: number
  warningCount: number
  fixableCount: number
