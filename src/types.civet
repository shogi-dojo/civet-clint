import type { SyntaxTree } from "./syntax.civet"

export type Severity = "warn" | "error"
export type RuleLevel = "off" | "warn" | "error"

export type RuleOptions = Record<string, any>
export type RuleEntry = RuleLevel | [RuleLevel, RuleOptions]
export type CompileDial = Record<string, any>
export type CompileOptions = Record<string, any>

export interface Fix
  start: number
  end: number
  replacement: string

export interface Diagnostic
  ruleId: string
  severity: Severity
  message: string
  line: number
  column: number
  pos?: number
  fix?: Fix

export type EquivalenceReference = (source: string) => string | undefined
export type OutputDelta = "quote-style" | "semicolon-style" | "declaration-style"

export interface RuleContext
  source: string
  syntax: SyntaxTree
  filename?: string
  options: RuleOptions
  parseOptions: CompileDial
  report: (diag: {
    ruleId: string
    severity?: Severity
    message: string
    line?: number
    column?: number
    pos?: number
    fix?: Fix
  }) => void
  getLineColumn: (pos: number) => { line: number, column: number }
  declareEquivalenceReference?: (delta: OutputDelta, build: EquivalenceReference) => void

export interface RuleCapability
  requires?: string[]
  requiresAny?: string[]
  forbids?: string[]

export interface RuleMeta
  description: string
  fixable: boolean
  defaultSeverity: Severity
  allowFixesInsideComments?: boolean
  capabilities?: RuleCapability
  conflictsWith?: string[]
  defaultOptions?: RuleOptions

export interface Rule
  id: string
  meta: RuleMeta
  check: (context: RuleContext) => void

export interface Plugin
  name: string
  rules?: Rule[] | Record<string, Rule>

export interface ConfigOverride
  files: string | string[]
  preset?: string
  civetConfig?: string
  rules?: Record<string, RuleEntry>
  civetOptions?: CompileDial
  compileOptions?: CompileOptions

export interface ClintConfig
  preset?: string
  civetConfig?: string
  rules?: Record<string, RuleEntry>
  overrides?: ConfigOverride[]

export interface SkippedRule
  ruleId: string
  reason: string

export interface ResolvedConfig
  preset: string
  rules: Record<string, RuleLevel>
  ruleOptions: Record<string, RuleOptions>
  civetConfigPath?: string
  civetOptions: CompileDial
  compileOptions: CompileOptions
  configPath?: string
  skippedRules: SkippedRule[]
  overrides?: ConfigOverride[]
  matchingOverrides?: string[]

export interface LintResult
  filePath: string
  source: string
  fixedSource?: string
  diagnostics: Diagnostic[]
  appliedFixesCount: number
  isEquivalencePreserved: boolean
  errorCount: number
  warningCount: number
  fixableCount: number
