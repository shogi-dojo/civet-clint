import fs from "node:fs/promises"
import path from "node:path"
import { loadConfig, resolveConfigForFile, resolveRuleOptions } from "./config.civet"
import { pipelineOptions, controlledOptionKeys } from "./compiler.civet"
import { lintFile, rewriteFile } from "./engine.civet"
import { defaultRuleRegistry } from "./registry.civet"
import type { LintResult, ResolvedConfig } from "./types.civet"

// Report the options each active rule will actually run with — the rule's declared
// defaults merged with anything the config supplied. Rules that take no options are
// omitted so the payload stays readable.
function effectiveRuleOptions(config: ResolvedConfig): Record<string, Record<string, any>>
  out: Record<string, Record<string, any>> := {}
  for ruleId of Object.keys(config.rules)
    continue if config.rules[ruleId] is "off"
    resolved := resolveRuleOptions(ruleId, config.ruleOptions?[ruleId], defaultRuleRegistry)
    out[ruleId] = resolved if Object.keys(resolved).length > 0
  out

const IGNORED_DIRS = new Set([
  "node_modules"
  ".git"
  "dist"
  "build"
  "coverage"
  ".next"
  ".turbo"
  ".output"
])

export interface FindFilesOptions
  extensions?: string[]
  rewrite?: boolean

const REWRITE_EXTS = [".js", ".jsx", ".ts", ".tsx", ".mts", ".cts"]

function isTargetFile(name: string, opts: FindFilesOptions = {}): boolean
  if opts.rewrite
    return false if name.endsWith(".d.ts") or name.endsWith(".d.mts") or name.endsWith(".d.cts") or name.endsWith(".mjs") or name.endsWith(".cjs")
    REWRITE_EXTS.some (ext) -> name.endsWith(ext)
  else if opts.extensions and opts.extensions.length > 0
    opts.extensions.some (ext) -> name.endsWith(ext)
  else
    name.endsWith(".civet")

export async function findCivetFiles(
  targets: string[]
  cwd: string = process.cwd()
  opts: FindFilesOptions = {}
): Promise<string[]>
  effectiveTargets := targets.length > 0 ? targets : ["."]
  files: string[] := []

  traverse := async (dirPath: string): Promise<void> ->
    entries := await fs.readdir(dirPath, { withFileTypes: true })

    for entry of entries
      if entry.isDirectory()
        if not IGNORED_DIRS.has(entry.name) and not entry.name.startsWith(".")
          await traverse(path.join(dirPath, entry.name))
      else if entry.isFile() and isTargetFile(entry.name, opts)
        files.push(path.join(dirPath, entry.name))

  for target of effectiveTargets
    resolved := path.resolve(cwd, target)
    try
      stat := await fs.stat(resolved)
      if stat.isDirectory()
        await traverse(resolved)
      else if stat.isFile() and isTargetFile(resolved, opts)
        files.push(resolved)
    catch
      throw new Error(`Target not found or unreadable: ${target}`)

  // Return sorted unique absolute paths
  Array.from(new Set(files)).sort()

export interface CliOptions
  check?: boolean
  write?: boolean
  rewrite?: boolean
  config?: string
  format?: "text" | "json"
  printConfig?: boolean
  verbose?: boolean
  help?: boolean
  version?: boolean
  targets: string[]
  errors: string[]

export function parseCliArgs(args: string[]): CliOptions
  options: CliOptions := {
    targets: []
    format: "text"
    errors: []
  }

  for let i = 0; i < args.length; i++
    arg := args[i]
    if arg is "--"
      options.targets.push(...args.slice(i + 1))
      break
    if arg is "--check"
      options.check = true
    else if arg is "--write" or arg is "-w" or arg is "--fix"
      options.write = true
    else if arg is "--rewrite"
      options.rewrite = true
    else if arg is "--print-config"
      options.printConfig = true
    else if arg is "--verbose"
      options.verbose = true
    else if arg is "--help" or arg is "-h"
      options.help = true
    else if arg is "--version" or arg is "-v"
      options.version = true
    else if arg is "--config" or arg is "-c"
      i++
      if args[i]?
        options.config = args[i]
      else
        options.errors.push(`${arg} requires a path`)
    else if arg.startsWith("--config=")
      options.config = arg.slice("--config=".length)
    else if arg is "--format" or arg is "-f"
      i++
      formatVal := args[i]
      if formatVal is "json" or formatVal is "text"
        options.format = formatVal
      else
        options.errors.push(`${arg} requires "text" or "json"`)
    else if arg.startsWith("--format=")
      formatVal := arg.slice("--format=".length)
      if formatVal is "json" or formatVal is "text"
        options.format = formatVal as any
      else
        options.errors.push(`Unknown output format: ${formatVal}`)
    else if not arg.startsWith("-")
      options.targets.push(arg)
    else
      options.errors.push(`Unknown option: ${arg}`)

  options

export function formatTextReport(
  results: LintResult[]
  isWriteMode: boolean
  isRewriteMode: boolean = false
  totalRewritten: number = 0
): { output: string, exitCode: number }
  lines: string[] := []
  var totalErrors = 0
  var totalWarnings = 0
  var totalFixable = 0
  var totalFixed = 0
  var hasFatalError = false

  cwd := process.cwd()

  for res of results
    totalErrors += res.errorCount
    totalWarnings += res.warningCount
    totalFixable += res.fixableCount
    totalFixed += res.appliedFixesCount
    hasFatalError = true if res.diagnostics.some (diag) ->
      diag.ruleId is "syntax-error" or
        diag.ruleId is "compile-error" or
        diag.ruleId is "io-error" or
        diag.ruleId is "internal-rule-error" or
        diag.ruleId.startsWith("compiler-equivalence-")

    if res.diagnostics.length > 0
      relPath := path.relative(cwd, res.filePath) or res.filePath
      lines.push(`\n${relPath}`)
      for diag of res.diagnostics
        tag := diag.severity is "error" ? "error" : "warning"
        posStr := `${diag.line}:${diag.column}`
        fixableTag := diag.fix ? " (fixable)" : ""
        lines.push(`  ${posStr.padEnd(8)} ${tag.padEnd(8)} ${diag.message}  [${diag.ruleId}]${fixableTag}`)

  totalProblems := totalErrors + totalWarnings
  lines.push("")

  if totalProblems > 0
    lines.push(`✖ ${totalProblems} problem${totalProblems is 1 ? "" : "s"} (${totalErrors} error${totalErrors is 1 ? "" : "s"}, ${totalWarnings} warning${totalWarnings is 1 ? "" : "s"})`)
    if totalFixable > 0 and not isWriteMode
      lines.push(`  ${totalFixable} fixable with --write`)

  if isRewriteMode and totalRewritten > 0
    lines.push(`✔ Rewrote ${totalRewritten} file${totalRewritten is 1 ? "" : "s"}`)

  if isWriteMode and not isRewriteMode and totalFixed > 0
    lines.push(`✔ Fixed ${totalFixed} problem${totalFixed is 1 ? "" : "s"}`)

  if totalProblems is 0 and totalFixed is 0 and totalRewritten is 0
    lines.push("✔ No problems found")

  exitCode := hasFatalError ? 2 : totalErrors > 0 ? 1 : 0
  { output: lines.join("\n").trim(), exitCode }

export async function runCli(argv: string[] = process.argv.slice(2)): Promise<number>
  options := parseCliArgs(argv)

  if options.errors.length > 0
    for error of options.errors
      console.error(`Argument error: ${error}`)
    return 2

  if options.help
    console.log(`
clint: Compiler-backed style linter & autofixer for Civet

Usage:
  clint [options] [files/directories...]

Options:
  --check              Check files and report errors (default mode)
  -w, --write, --fix   Automatically fix style issues in place
  --rewrite            Rename and convert JS/TS files to Civet, then apply autofixes
  --print-config       Print the resolved preset, compiler options, rules, and
                       skipped/incompatible rules, then exit
  --verbose            Print the resolved config and Civet compiler options to
                       stderr before linting
  -c, --config <path>  Path to civet-clint configuration file
  -f, --format <type>  Output format: text (default) | json
  -v, --version        Print version and exit
  -h, --help           Show this help message
`.trim())
    return 0

  if options.version
    // The manifest is the single source of truth: a hardcoded fallback would
    // silently report a stale version after the next release bump.
    try
      pkgUrl := new URL("../package.json", import.meta.url)
      rawPkg := await fs.readFile(pkgUrl, "utf8")
      manifest := JSON.parse(rawPkg)
      console.log(`clint v${manifest.version}`)
      return 0
    catch e
      console.error(`Unable to determine clint version: ${(e as Error).message}`)
      return 2

  var config: ResolvedConfig
  try
    config = loadConfig(options.config, process.cwd(), defaultRuleRegistry)
  catch err: any
    console.error(`Configuration error: ${err.message or err}`)
    return 2

  if options.printConfig
    // Report the options the adapter will actually pass to the compiler, not the
    // raw file contents: Clint strips execution-mode keys such as `sync` and `ast`,
    // and printing them as active would misreport the resolved configuration.
    if options.targets.length > 0
      targetFile := options.targets[0]
      fileConfig := resolveConfigForFile(config, targetFile, process.cwd(), defaultRuleRegistry)
      ignored := controlledOptionKeys(fileConfig.compileOptions)
      payload := {
        file: targetFile
        preset: fileConfig.preset
        configPath: fileConfig.configPath
        civetConfigPath: fileConfig.civetConfigPath
        civetOptions: fileConfig.civetOptions
        compileOptions: pipelineOptions(fileConfig.compileOptions)
        ignoredCompileOptions: ignored
        rules: fileConfig.rules
        ruleOptions: effectiveRuleOptions(fileConfig)
        skippedRules: fileConfig.skippedRules
        matchingOverrides: fileConfig.matchingOverrides or []
      }
      console.log(JSON.stringify(payload, null, 2))
      return 0
    else
      ignored := controlledOptionKeys(config.compileOptions)
      payload := {
        preset: config.preset
        configPath: config.configPath
        civetConfigPath: config.civetConfigPath
        civetOptions: config.civetOptions
        compileOptions: pipelineOptions(config.compileOptions)
        ignoredCompileOptions: ignored
        rules: config.rules
        ruleOptions: effectiveRuleOptions(config)
        skippedRules: config.skippedRules
        matchingOverrides: []
      }
      console.log(JSON.stringify(payload, null, 2))
      return 0

  isRewriteMode := options.rewrite is true
  isWriteMode := options.write is true or isRewriteMode

  var files: string[]
  try
    files = await findCivetFiles(options.targets, process.cwd(), { rewrite: isRewriteMode })
  catch err: any
    console.error(`Input error: ${err.message or err}`)
    return 2
  if files.length is 0
    if options.format is "json"
      console.log(JSON.stringify({ files: [], totalErrors: 0, totalWarnings: 0, totalFixed: 0, ...(isRewriteMode ? { totalRewritten: 0 } : {}) }, null, 2))
    else
      console.log(isRewriteMode ? "No files found to rewrite." : "No .civet files found.")
    return 0

  if options.verbose
    // Report the configs that were actually resolved, not the ones the user
    // assumes were found: silent discovery failure is the whole point of this flag.
    // stderr keeps --format json parseable on stdout.
    sample := resolveConfigForFile(config, files[0]!, process.cwd(), defaultRuleRegistry)
    console.error(`clint: config       ${config.configPath ?? "<defaults, none found>"}`)
    console.error(`clint: civet config ${config.civetConfigPath ?? "<defaults, none found>"}`)
    console.error(`clint: preset       ${sample.preset}`)
    console.error(`clint: civet options ${Object.keys(sample.civetOptions ?? {}).sort().join(", ") or "<none>"}`)
    if sample.matchingOverrides?.length
      console.error(`clint: overrides    ${sample.matchingOverrides.join(", ")} (matching ${path.relative(process.cwd(), files[0]!)})`)
    console.error(`clint: files        ${files.length}`)

  results: LintResult[] := []
  var totalRewritten = 0

  for file of files
    try
      if isRewriteMode
        res := await rewriteFile(file, { config })
        results.push(res)
        hasFatal := res.diagnostics.some (d) ->
          d.ruleId is "syntax-error" or d.ruleId is "io-error" or d.ruleId is "compile-error"
        if not hasFatal
          totalRewritten++
      else
        res := await lintFile(file, {
          config
          fix: isWriteMode
        })
        results.push(res)
    catch err: any
      results.push({
        filePath: file
        source: ""
        diagnostics: [{
          ruleId: "io-error"
          severity: "error"
          message: `Failed to process file: ${err.message or err}`
          line: 1
          column: 1
        }]
        appliedFixesCount: 0
        isEquivalencePreserved: false
        errorCount: 1
        warningCount: 0
        fixableCount: 0
      })

  if options.format is "json"
    var totalErrors = 0
    var totalWarnings = 0
    var totalFixed = 0
    var hasFatalError = false
    for r of results
      totalErrors += r.errorCount
      totalWarnings += r.warningCount
      totalFixed += r.appliedFixesCount
      hasFatalError = true if r.diagnostics.some (diag) ->
        diag.ruleId is "syntax-error" or
          diag.ruleId is "compile-error" or
          diag.ruleId is "io-error" or
          diag.ruleId is "internal-rule-error" or
          diag.ruleId.startsWith("compiler-equivalence-")

    jsonPayload := {
      files: results.map (r) -> {
        filePath: r.filePath
        diagnostics: r.diagnostics
        errorCount: r.errorCount
        warningCount: r.warningCount
        appliedFixesCount: r.appliedFixesCount
        isEquivalencePreserved: r.isEquivalencePreserved
      }
      totalErrors
      totalWarnings
      totalFixed
      ...(isRewriteMode ? { totalRewritten } : {})
    }
    console.log(JSON.stringify(jsonPayload, null, 2))
    return hasFatalError ? 2 : totalErrors > 0 ? 1 : 0
  else
    { output, exitCode } := formatTextReport(results, isWriteMode, isRewriteMode, totalRewritten)
    if output
      console.log(output)
    return exitCode
