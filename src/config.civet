import fs from "node:fs"
import path from "node:path"
import type { ClintConfig, CompileDial, CompileOptions, ConfigOverride, ResolvedConfig, RuleLevel, SkippedRule } from "./types.civet"
import { RuleRegistry, defaultRuleRegistry } from "./registry.civet"

const TOP_LEVEL_COMPILE_OPTIONS = new Set([
  "filename"
  "outputFilename"
  "sourceMap"
  "inlineMap"
  "upstreamSourceMap"
  "ast"
  "js"
  "noCache"
  "hits"
  "trace"
  "errors"
  "threads"
  "sync"
  "tsConfig"
])

// Presets bundle a default rule set with a default compiler dial. `coffee-react`
// remains available to existing consumers that select it explicitly (e.g. Ranked);
// `default` is the actual neutral, Coffee-option-free starting point that relies only
// on Civet's vanilla word-operator parsing. The dial is only a *default* — a project's
// `civet.json` always overrides it, so a `default`-preset user with a Coffee-flavored
// `civet.json` still gets Coffee parsing.
export interface PresetDefinition
  rules: Record<string, RuleLevel>
  civetOptions: CompileDial
  compileOptions: CompileOptions

export const PRESETS: Record<string, PresetDefinition> = {
  "default": {
    rules: {
      "style/prefer-word-operators": "error"
      "style/prefer-concise-arrow": "error"
      "style/no-mixed-interpolation": "warn"
    }
    civetOptions: {}
    compileOptions: {}
  }
  "coffee-react": {
    rules: {
      "style/prefer-word-operators": "error"
      "style/prefer-concise-arrow": "error"
      "style/prefer-jsx-shorthand": "error"
      "style/no-null-equality": "warn"
      "style/no-is-not": "warn"
      "style/no-mixed-interpolation": "warn"
    }
    civetOptions: {
      coffeeIsnt: true
      react: true
    }
    compileOptions: {}
  }
}

export function findConfigFile(cwd: string = process.cwd()): string | undefined
  candidates := [
    "civet-clint.config.json"
    ".civet-clintrc.json"
    ".civet-clint.json"
  ]
  for candidate of candidates
    p := path.resolve(cwd, candidate)
    if fs.existsSync(p)
      return p
  undefined

export function findCivetConfigFile(cwd: string = process.cwd()): string | undefined
  candidates := [
    "civet.json"
    "civetconfig.json"
    ".civetconfig.json"
  ]
  for candidate of candidates
    p := path.resolve(cwd, candidate)
    if fs.existsSync(p)
      return p
  undefined

// Load and split a `civet.json` into the compiler dial (`parseOptions`) and the
// retained top-level `CompileOptions`. An explicitly configured `civetConfig` that
// does not exist must be fatal. Silently falling back to `{}` would lint against the
// wrong compiler dial — e.g. losing `coffeeComment` makes `# a === b` parse as code,
// so the fixer rewrites inside a comment. Auto-discovery finding nothing stays
// non-fatal.
export function loadCivetConfig(civetConfigPath?: string, cwd: string = process.cwd()): { dial: CompileDial, compileOptions: CompileOptions, resolvedPath?: string }
  resolvedPath := civetConfigPath ? path.resolve(cwd, civetConfigPath) : findCivetConfigFile(cwd)

  // An explicitly configured `civetConfig` that does not exist must be fatal.
  if civetConfigPath and not fs.existsSync(resolvedPath!)
    throw new Error(`Civet config file not found: ${resolvedPath}`)

  if resolvedPath and fs.existsSync(resolvedPath)
    try
      raw := fs.readFileSync(resolvedPath, "utf8")
      parsed := JSON.parse(raw)
      unless parsed? and typeof parsed is "object" and not Array.isArray(parsed)
        throw new Error("Civet config must contain a JSON object")

      // `civet.json` normally wraps the compiler dial in `parseOptions`. When present,
      // the remaining top-level keys are retained CompileOptions (e.g. `js`, `trace`).
      // When `parseOptions` is absent, the whole object is treated as the dial to stay
      // backward-compatible with the POC's `loadCivetOptions`.
      if parsed.parseOptions?
        unless parsed.parseOptions? and typeof parsed.parseOptions is "object" and not Array.isArray(parsed.parseOptions)
          throw new Error("Civet parseOptions must contain a JSON object")
        dial := parsed.parseOptions as CompileDial
        compileOptions: CompileOptions := {}
        for key of Object.keys(parsed)
          continue if key is "parseOptions"
          compileOptions[key] = parsed[key]
        return { dial, compileOptions, resolvedPath }
      else
        // Older POC configs allowed a bare dial. Preserve that form while still
        // recognizing official top-level CompileOptions such as `js` and
        // `sourceMap` when `parseOptions` is omitted.
        dial: CompileDial := {}
        compileOptions: CompileOptions := {}
        for key of Object.keys(parsed)
          if TOP_LEVEL_COMPILE_OPTIONS.has(key)
            compileOptions[key] = parsed[key]
          else
            dial[key] = parsed[key]
        return { dial, compileOptions, resolvedPath }
    catch err
      throw new Error(`Failed to parse Civet config file at ${resolvedPath}: ${(err as Error).message}`)

  { dial: {}, compileOptions: {} }

// Backward-compatible wrapper: returns only the dial. Existing callers and the public
// API keep working; new code reads `loadCivetConfig` for the full split.
export function loadCivetOptions(civetConfigPath?: string, cwd: string = process.cwd()): CompileDial
  loadCivetConfig(civetConfigPath, cwd).dial

// Compute which enabled rules cannot run under the resolved dial. A rule is skipped
// when any key in `meta.capabilities.requires` is falsy on the dial. Skipped rules
// are reported by `clint --print-config` and never executed, so they never emit an
// autofix whose replacement is invalid under the active dial.
export function computeSkippedRules(
  rules: Record<string, RuleLevel>,
  dial: CompileDial,
  registry: RuleRegistry = defaultRuleRegistry
): SkippedRule[]
  skipped: SkippedRule[] := []
  for ruleId of Object.keys(rules)
    continue if rules[ruleId] is "off"
    rule := registry.get(ruleId)
    continue unless rule
    requires := rule.meta.capabilities?.requires
    requiresAny := rule.meta.capabilities?.requiresAny
    missing := (requires or []).filter (key) -> not dial[key]
    lacksAny := requiresAny? and requiresAny.length > 0 and not requiresAny.some (key) -> dial[key]
    if missing.length > 0 or lacksAny
      reasons: string[] := []
      reasons.push(`requires ${missing.join(", ")} in the compiler dial`) if missing.length > 0
      reasons.push(`requires one of ${requiresAny!.join(", ")} in the compiler dial`) if lacksAny
      skipped.push({
        ruleId
        reason: reasons.join("; ")
      })
  skipped

export function globToRegex(glob: string): RegExp
  normalized := glob.replace(/\\/g, "/")
  var re = ""
  var i = 0
  while i < normalized.length
    c := normalized[i]
    if c is "*"
      if normalized[i + 1] is "*"
        if normalized[i + 2] is "/"
          re += "(?:.*/)?"
          i += 3
          continue
        else
          re += ".*"
          i += 2
          continue
      else
        re += "[^/]*"
        i++
        continue
    else if c is "?"
      re += "[^/]"
      i++
    else if "./+^$()|{}[]".includes(c)
      re += "\\" + c
      i++
    else
      re += c
      i++
  new RegExp("^" + re + "$")

export function matchesFilePattern(filePath: string, pattern: string, configBaseDir: string = process.cwd()): boolean
  cleanPattern := pattern.replace(/\\/g, "/").replace(/^\.\//, "")
  cleanPath := filePath.replace(/\\/g, "/")
  cleanBase := configBaseDir.replace(/\\/g, "/")

  relPath := path.relative(cleanBase, cleanPath).replace(/\\/g, "/")
  basename := path.basename(cleanPath)

  regex := globToRegex(cleanPattern)
  if cleanPattern.includes("/")
    regex.test(relPath) or regex.test(cleanPath)
  else
    regex.test(basename) or regex.test(relPath)

export function loadConfig(
  explicitConfigPath?: string,
  cwd: string = process.cwd(),
  registry: RuleRegistry = defaultRuleRegistry
): ResolvedConfig
  var configPath: string | undefined = undefined
  var userConfig: ClintConfig = {}

  if explicitConfigPath
    resolvedExplicit := path.resolve(cwd, explicitConfigPath)
    if not fs.existsSync(resolvedExplicit)
      throw new Error(`Configuration file not found: ${resolvedExplicit}`)
    configPath = resolvedExplicit
  else
    configPath = findConfigFile(cwd)

  if configPath
    try
      raw := fs.readFileSync(configPath, "utf8")
      userConfig = JSON.parse(raw)
    catch err
      throw new Error(`Failed to parse config file at ${configPath}: ${(err as Error).message}`)

  presetName := userConfig.preset or "default"
  presetDef := PRESETS[presetName]
  if not presetDef
    throw new Error(`Unknown preset: "${presetName}". Available presets: ${Object.keys(PRESETS).join(", ")}`)

  mergedRules: Record<string, RuleLevel> := { ...presetDef.rules, ...(userConfig.rules or {}) }

  for ruleId of Object.keys(mergedRules)
    level := mergedRules[ruleId]
    unless level is "off" or level is "warn" or level is "error"
      throw new Error(`Invalid level for rule "${ruleId}": expected off, warn, or error`)
    if (level is "warn" or level is "error") and not registry.has(ruleId)
      throw new Error(`Unknown rule ID: "${ruleId}". Available rules: ${registry.getRuleList().map((r) -> r.id).join(", ")}`)

  if userConfig.overrides?
    unless Array.isArray(userConfig.overrides)
      throw new Error("Configuration overrides must be an array")
    for override of userConfig.overrides
      unless override? and typeof override is "object"
        throw new Error("Each override must be an object")
      unless override.files? and (typeof override.files is "string" or (Array.isArray(override.files) and override.files.every((f) => typeof f is "string" and f.length > 0)))
        throw new Error("Each override must have a 'files' string or array of strings")
      if override.preset? and not PRESETS[override.preset]
        throw new Error(`Unknown preset in override: "${override.preset}". Available presets: ${Object.keys(PRESETS).join(", ")}`)
      if override.rules?
        for ruleId of Object.keys(override.rules)
          level := override.rules[ruleId]
          unless level is "off" or level is "warn" or level is "error"
            throw new Error(`Invalid level for override rule "${ruleId}": expected off, warn, or error`)
          if (level is "warn" or level is "error") and not registry.has(ruleId)
            throw new Error(`Unknown rule ID in override: "${ruleId}". Available rules: ${registry.getRuleList().map((r) -> r.id).join(", ")}`)

  configBase := configPath ? path.dirname(configPath) : cwd
  explicitCivetConfigPath := userConfig.civetConfig
    ? path.resolve(configBase, userConfig.civetConfig)
    : findCivetConfigFile(cwd)
  { dial: userDial, compileOptions: userCompileOptions, resolvedPath: resolvedCivetConfigPath } := loadCivetConfig(explicitCivetConfigPath, cwd)
  civetOptions := { ...presetDef.civetOptions, ...userDial }
  compileOptions := { ...presetDef.compileOptions, ...userCompileOptions }

  skippedRules := computeSkippedRules(mergedRules, civetOptions, registry)

  {
    preset: presetName
    rules: mergedRules
    civetConfigPath: resolvedCivetConfigPath
    civetOptions
    compileOptions
    configPath
    skippedRules
    overrides: userConfig.overrides
    matchingOverrides: []
  }

export function resolveConfigForFile(
  baseConfig: ResolvedConfig,
  filePath: string,
  cwd: string = process.cwd(),
  registry: RuleRegistry = defaultRuleRegistry
): ResolvedConfig
  configBase := baseConfig.configPath ? path.dirname(baseConfig.configPath) : cwd
  overrides := baseConfig.overrides or []

  var effectivePreset = baseConfig.preset
  var effectiveCivetConfigPath = baseConfig.civetConfigPath
  var effectiveCivetOptions: CompileDial = { ...baseConfig.civetOptions }
  var effectiveCompileOptions: CompileOptions = { ...baseConfig.compileOptions }
  var effectiveRules: Record<string, RuleLevel> = { ...baseConfig.rules }
  matchingOverrides: string[] := []

  for override of overrides
    patterns := Array.isArray(override.files) ? override.files : [override.files]
    matched := patterns.some (pattern) -> matchesFilePattern(filePath, pattern, configBase)
    continue unless matched

    matchingOverrides.push(patterns.join(", "))

    if override.preset
      presetDef := PRESETS[override.preset]
      unless presetDef
        throw new Error(`Unknown preset in override: "${override.preset}". Available presets: ${Object.keys(PRESETS).join(", ")}`)
      effectivePreset = override.preset
      effectiveRules = { ...presetDef.rules, ...effectiveRules }
      effectiveCivetOptions = { ...presetDef.civetOptions, ...effectiveCivetOptions }
      effectiveCompileOptions = { ...presetDef.compileOptions, ...effectiveCompileOptions }

    if override.civetConfig
      explicitCivetPath := path.resolve(configBase, override.civetConfig)
      { dial, compileOptions, resolvedPath } := loadCivetConfig(explicitCivetPath, configBase)
      effectiveCivetConfigPath = resolvedPath
      effectiveCivetOptions = { ...effectiveCivetOptions, ...dial }
      effectiveCompileOptions = { ...effectiveCompileOptions, ...compileOptions }

    if override.civetOptions
      effectiveCivetOptions = { ...effectiveCivetOptions, ...override.civetOptions }

    if override.compileOptions
      effectiveCompileOptions = { ...effectiveCompileOptions, ...override.compileOptions }

    if override.rules
      for ruleId of Object.keys(override.rules)
        level := override.rules[ruleId]
        unless level is "off" or level is "warn" or level is "error"
          throw new Error(`Invalid level for override rule "${ruleId}": expected off, warn, or error`)
        if (level is "warn" or level is "error") and not registry.has(ruleId)
          throw new Error(`Unknown rule ID in override: "${ruleId}". Available rules: ${registry.getRuleList().map((r) -> r.id).join(", ")}`)
        effectiveRules[ruleId] = level

  skippedRules := computeSkippedRules(effectiveRules, effectiveCivetOptions, registry)

  {
    preset: effectivePreset
    rules: effectiveRules
    civetConfigPath: effectiveCivetConfigPath
    civetOptions: effectiveCivetOptions
    compileOptions: effectiveCompileOptions
    configPath: baseConfig.configPath
    skippedRules
    overrides: baseConfig.overrides
    matchingOverrides
  }
