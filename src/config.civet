import fs from "node:fs"
import path from "node:path"
import type { ClintConfig, CompileDial, CompileOptions, ResolvedConfig, RuleLevel, SkippedRule } from "./types.civet"
import { allRules } from "./rules/index.civet"

// Presets bundle a default rule set with a default compiler dial. `coffee-react`
// remains the backward-compatible default for existing consumers (e.g. Ranked);
// `default` is the neutral, Coffee-option-free starting point that relies only on
// Civet's vanilla word-operator parsing. The dial is only a *default* — a project's
// `civet.json` always overrides it, so a `default`-preset user with a Coffee-flavored
// `civet.json` still gets Coffee parsing.
export interface PresetDefinition
  rules: Record<string, RuleLevel>
  civetOptions: CompileDial
  compileOptions: CompileOptions

export const PRESETS: Record<string, PresetDefinition> = {
  "default": {
    rules: {
      "style/prefer-word-operators": "error"
      "style/prefer-concise-arrow": "error"
      "style/no-mixed-interpolation": "warn"
    }
    civetOptions: {}
    compileOptions: {}
  }
  "coffee-react": {
    rules: {
      "style/prefer-word-operators": "error"
      "style/prefer-concise-arrow": "error"
      "style/prefer-jsx-shorthand": "error"
      "style/no-null-equality": "warn"
      "style/no-is-not": "warn"
      "style/no-mixed-interpolation": "warn"
    }
    civetOptions: {
      coffeeIsnt: true
      react: true
    }
    compileOptions: {}
  }
}

export function findConfigFile(cwd: string = process.cwd()): string | undefined
  candidates := [
    "civet-clint.config.json"
    ".civet-clintrc.json"
    ".civet-clint.json"
  ]
  for candidate of candidates
    p := path.resolve(cwd, candidate)
    if fs.existsSync(p)
      return p
  undefined

export function findCivetConfigFile(cwd: string = process.cwd()): string | undefined
  candidates := [
    "civet.json"
    "civetconfig.json"
    ".civetconfig.json"
  ]
  for candidate of candidates
    p := path.resolve(cwd, candidate)
    if fs.existsSync(p)
      return p
  undefined

// Load and split a `civet.json` into the compiler dial (`parseOptions`) and the
// retained top-level `CompileOptions`. An explicitly configured `civetConfig` that
// does not exist must be fatal. Silently falling back to `{}` would lint against the
// wrong compiler dial — e.g. losing `coffeeComment` makes `# a === b` parse as code,
// so the fixer rewrites inside a comment. Auto-discovery finding nothing stays
// non-fatal.
export function loadCivetConfig(civetConfigPath?: string, cwd: string = process.cwd()): { dial: CompileDial, compileOptions: CompileOptions, resolvedPath?: string }
  resolvedPath := civetConfigPath ? path.resolve(cwd, civetConfigPath) : findCivetConfigFile(cwd)

  // An explicitly configured `civetConfig` that does not exist must be fatal.
  if civetConfigPath and not fs.existsSync(resolvedPath!)
    throw new Error(`Civet config file not found: ${resolvedPath}`)

  if resolvedPath and fs.existsSync(resolvedPath)
    try
      raw := fs.readFileSync(resolvedPath, "utf8")
      parsed := JSON.parse(raw)
      unless parsed? and typeof parsed is "object" and not Array.isArray(parsed)
        throw new Error("Civet config must contain a JSON object")

      // `civet.json` normally wraps the compiler dial in `parseOptions`. When present,
      // the remaining top-level keys are retained CompileOptions (e.g. `js`, `trace`).
      // When `parseOptions` is absent, the whole object is treated as the dial to stay
      // backward-compatible with the POC's `loadCivetOptions`.
      if parsed.parseOptions?
        unless parsed.parseOptions? and typeof parsed.parseOptions is "object" and not Array.isArray(parsed.parseOptions)
          throw new Error("Civet parseOptions must contain a JSON object")
        dial := parsed.parseOptions as CompileDial
        compileOptions: CompileOptions := {}
        for key of Object.keys(parsed)
          continue if key is "parseOptions"
          compileOptions[key] = parsed[key]
        return { dial, compileOptions, resolvedPath }
      else
        return { dial: parsed as CompileDial, compileOptions: {}, resolvedPath }
    catch err
      throw new Error(`Failed to parse Civet config file at ${resolvedPath}: ${(err as Error).message}`)

  { dial: {}, compileOptions: {} }

// Backward-compatible wrapper: returns only the dial. Existing callers and the public
// API keep working; new code reads `loadCivetConfig` for the full split.
export function loadCivetOptions(civetConfigPath?: string, cwd: string = process.cwd()): CompileDial
  loadCivetConfig(civetConfigPath, cwd).dial

// Compute which enabled rules cannot run under the resolved dial. A rule is skipped
// when any key in `meta.capabilities.requires` is falsy on the dial. Skipped rules
// are reported by `clint --print-config` and never executed, so they never emit an
// autofix whose replacement is invalid under the active dial.
export function computeSkippedRules(rules: Record<string, RuleLevel>, dial: CompileDial): SkippedRule[]
  skipped: SkippedRule[] := []
  for ruleId of Object.keys(rules)
    continue if rules[ruleId] is "off"
    rule := allRules[ruleId]
    continue unless rule
    requires := rule.meta.capabilities?.requires
    continue unless requires and requires.length > 0
    missing := requires.filter (key) -> not dial[key]
    if missing.length > 0
      skipped.push({
        ruleId
        reason: `requires ${missing.join(", ")} in the compiler dial`
      })
  skipped

export function loadConfig(explicitConfigPath?: string, cwd: string = process.cwd()): ResolvedConfig
  var configPath: string | undefined = undefined
  var userConfig: ClintConfig = {}

  if explicitConfigPath
    resolvedExplicit := path.resolve(cwd, explicitConfigPath)
    if not fs.existsSync(resolvedExplicit)
      throw new Error(`Configuration file not found: ${resolvedExplicit}`)
    configPath = resolvedExplicit
  else
    configPath = findConfigFile(cwd)

  if configPath
    try
      raw := fs.readFileSync(configPath, "utf8")
      userConfig = JSON.parse(raw)
    catch err
      throw new Error(`Failed to parse config file at ${configPath}: ${(err as Error).message}`)

  presetName := userConfig.preset or "coffee-react"
  presetDef := PRESETS[presetName]
  if not presetDef
    throw new Error(`Unknown preset: "${presetName}". Available presets: ${Object.keys(PRESETS).join(", ")}`)

  mergedRules: Record<string, RuleLevel> := { ...presetDef.rules, ...(userConfig.rules or {}) }

  for ruleId of Object.keys(mergedRules)
    level := mergedRules[ruleId]
    unless level is "off" or level is "warn" or level is "error"
      throw new Error(`Invalid level for rule "${ruleId}": expected off, warn, or error`)

  configBase := configPath ? path.dirname(configPath) : cwd
  explicitCivetConfigPath := userConfig.civetConfig
    ? path.resolve(configBase, userConfig.civetConfig)
    : findCivetConfigFile(cwd)
  { dial: userDial, compileOptions: userCompileOptions, resolvedPath: resolvedCivetConfigPath } := loadCivetConfig(explicitCivetConfigPath, cwd)
  civetOptions := { ...presetDef.civetOptions, ...userDial }
  compileOptions := { ...presetDef.compileOptions, ...userCompileOptions }

  skippedRules := computeSkippedRules(mergedRules, civetOptions)

  {
    preset: presetName
    rules: mergedRules
    civetConfigPath: resolvedCivetConfigPath
    civetOptions
    compileOptions
    configPath
    skippedRules
  }
