import fs from "node:fs/promises"
import path from "node:path"
import { parseRawAst, compileForOutput } from "./compiler.civet"
import type { CompileDial, CompileOptions, Diagnostic, EquivalenceReference, Fix, LintResult, OutputDelta, ResolvedConfig, RuleContext, RuleLevel, RuleOptions, Severity } from "./types.civet"
import { createLineColumnIndex, applyEdits, detectLineEnding, atomicWriteFile, collectCommentRanges, intersectsRange } from "./utils.civet"
import { loadConfig, computeSkippedRules, resolveConfigForFile, resolveRuleOptions } from "./config.civet"
import { RuleRegistry, defaultRuleRegistry } from "./registry.civet"

export interface LintOptions
  filename?: string
  config?: ResolvedConfig
  registry?: RuleRegistry
  civetOptions?: Record<string, any>
  // Top-level CompileOptions outside parseOptions. Threaded through the adapter so the
  // baseline and candidate compiles run under the same emitted-output pipeline.
  compileOptions?: Record<string, any>
  fix?: boolean
  rules?: Record<string, RuleLevel>
  // Per-rule options, merged over the resolved config's options and the rule's own
  // declared defaults. Mirrors `rules` for programmatic callers and tests.
  ruleOptions?: Record<string, RuleOptions>

// Rewrites every single-quoted string literal in emitted JS to the equivalent
// double-quoted literal, leaving all other bytes alone. Used only to compare two
// compiled outputs for quote-style-only difference; the result is never written
// anywhere.
//
// This scans the output rather than pattern-matching it, so a quote character inside
// a string, comment, or template literal cannot be mistaken for a delimiter. A
// literal that cannot be requoted without escaping is emitted verbatim, which makes
// the two sides differ and the comparison fail closed.
export function normalizeQuoteStyle(code: string): string
  var out = ""
  var i = 0
  while i < code.length
    ch := code[i]
    if ch is "/" and (code[i + 1] is "/" or code[i + 1] is "*")
      block := code[i + 1] is "*"
      end := block ? code.indexOf("*/", i + 2) : code.indexOf("\n", i + 2)
      stop := end < 0 ? code.length : (block ? end + 2 : end)
      out += code.slice(i, stop)
      i = stop
      continue
    if ch is "`"
      // Template literals are copied verbatim, including any nested `${}`.
      var j = i + 1
      while j < code.length
        break if code[j] is "`" and code[j - 1] isnt "\\"
        j++
      out += code.slice(i, Math.min(j + 1, code.length))
      i = j + 1
      continue
    if ch is '"' or ch is "'"
      quote := ch
      var j = i + 1
      var body = ""
      var closed = false
      while j < code.length
        c := code[j]
        if c is "\\"
          body += code.slice(j, j + 2)
          j += 2
          continue
        if c is quote
          closed = true
          break
        if c is "\n"
          break
        body += c
        j++
      unless closed
        out += ch
        i++
        continue
      // Only requote when the result needs no new escaping; otherwise keep it as-is
      // so a genuine difference stays visible to the caller.
      if quote is "'" and not body.includes('"')
        out += '"' + body + '"'
      else
        out += quote + body + quote
      i = j + 1
      continue
    out += ch
    i++
  out

// Backward-compatible single-dial entry point used by the POC API and tests. Prefer
// the adapter directly for new code; this helper keeps the old signature working.
export function compileSource(source: string, civetOptions: Record<string, any> = {}, filename: string = "unknown.civet"): string
  res := compileForOutput(source, { dial: civetOptions, filename })
  if res.ok
    res.output!
  else
    throw new Error(res.error)

export function lintSource(source: string, options: LintOptions = {}): LintResult
  registry := options.registry or defaultRuleRegistry
  filename := options.filename or "input.civet"
  resolvedConfig: ResolvedConfig := (options.config as ResolvedConfig)?.rules
    ? (options.config as ResolvedConfig)
    : loadConfig(undefined, process.cwd(), registry)

  mergedRules := { ...resolvedConfig.rules, ...(options.rules or {}) }
  mergedRuleOptions := { ...(resolvedConfig.ruleOptions or {}), ...(options.ruleOptions or {}) }
  civetOptions: CompileDial := { ...resolvedConfig.civetOptions, ...(options.civetOptions or {}) }
  compileOptions: CompileOptions := { ...resolvedConfig.compileOptions, ...(options.compileOptions or {}) }

  for ruleId of Object.keys(mergedRules)
    level := mergedRules[ruleId]
    if (level is "warn" or level is "error") and not registry.has(ruleId)
      throw new Error(`Unknown rule ID: "${ruleId}". Available rules: ${registry.getRuleList().map((r) -> r.id).join(", ")}`)

  // Rules skipped by the resolved dial are never executed. Recompute against the
  // merged rules and dial so per-call `civetOptions`/`rules` overrides are honored —
  // an autofix whose replacement is invalid under the active dial is never proposed.
  skippedIds := new Set(computeSkippedRules(mergedRules, civetOptions, registry).map (s) -> s.ruleId)

  getLineColumn := createLineColumnIndex(source)
  var diagnostics: Diagnostic[] = []

  // Step 1: Parse and baseline compile via the adapter (same options object shape).
  var ast: any = undefined
  var originalCompiled: string | undefined = undefined

  parseRes := parseRawAst(source, { dial: civetOptions, compileOptions, filename })
  if not parseRes.ok
    diag: Diagnostic := {
      ruleId: "syntax-error"
      severity: "error"
      message: `Civet parse error: ${parseRes.error}`
      line: parseRes.line or 1
      column: parseRes.column or 1
      pos: parseRes.offset or 0
    }
    return {
      filePath: filename
      source
      diagnostics: [diag]
      appliedFixesCount: 0
      isEquivalencePreserved: false
      errorCount: 1
      warningCount: 0
      fixableCount: 0
    }
  ast = parseRes.ast

  baselineRes := compileForOutput(source, { dial: civetOptions, compileOptions, filename })
  if not baselineRes.ok
    diag: Diagnostic := {
      ruleId: "compile-error"
      severity: "error"
      message: `Civet baseline compile error: ${baselineRes.error}`
      line: baselineRes.line or 1
      column: baselineRes.column or 1
    }
    return {
      filePath: filename
      source
      diagnostics: [diag]
      appliedFixesCount: 0
      isEquivalencePreserved: false
      errorCount: 1
      warningCount: 0
      fixableCount: 0
    }
  originalCompiled = baselineRes.output

  // Comments are stripped before codegen, so an edit landing inside one is
  // invisible to the compiler-equivalence check. Drop such fixes centrally:
  // every rule is covered, including future ones. Block comments (`/* */`)
  // survive into the output, so equivalence already guards those.
  commentRanges := collectCommentRanges(ast)

  // Step 2: Run active rules
  //
  // `options` and `declareEquivalenceReference` are per-rule, so they are rebound
  // immediately before each rule's `check` call rather than fixed here.
  equivalenceReferences := new Map<string, EquivalenceReference>()
  outputDeltas := new Map<string, OutputDelta>()
  var currentRuleId = ""

  // Independent bound on how far a reference-declaring rule may move the emitted
  // output. The rule names a delta kind; the engine — not the rule — decides what
  // that kind permits. Today the only kind is `quote-style`: the two outputs must be
  // identical once every JS string literal's quoting is normalized, which means the
  // change is confined to quote characters and cannot alter identifiers, structure,
  // or string contents.
  outputDeltaAllowed := (ruleId: string, before: string, after: string): boolean ->
    kind := outputDeltas.get(ruleId)
    return false unless kind is "quote-style"
    normalizeQuoteStyle(before) is normalizeQuoteStyle(after)

  context: RuleContext := {
    source
    ast
    filename
    parseOptions: civetOptions
    options: {}
    getLineColumn
    declareEquivalenceReference: (delta, build) ->
      if currentRuleId
        equivalenceReferences.set(currentRuleId, build)
        outputDeltas.set(currentRuleId, delta)
    report: (d) ->
      ruleLevel := mergedRules[d.ruleId] or "off"
      return if ruleLevel is "off"

      if d.fix and intersectsRange(commentRanges, d.fix.start, d.fix.end)
        return

      severity: Severity := (ruleLevel is "error" or ruleLevel is "warn")
        ? ruleLevel
        : (d.severity or "error")

      var line = d.line
      var column = d.column
      if line is undefined or column is undefined
        if d.pos isnt undefined
          lc := getLineColumn(d.pos)
          line = lc.line
          column = lc.column
        else if d.fix
          lc := getLineColumn(d.fix.start)
          line = lc.line
          column = lc.column
        else
          line = 1
          column = 1

      diagnostics.push({
        ruleId: d.ruleId
        severity
        message: d.message
        line: line!
        column: column!
        pos: d.pos
        fix: d.fix
      })
  }

  for ruleId of Object.keys(mergedRules)
    continue if mergedRules[ruleId] is "off"
    // Skip rules declared incompatible with the active dial. This runs before any
    // check so an invalid autofix is never even proposed.
    continue if skippedIds.has(ruleId)
    rule := registry.get(ruleId)
    if rule
      try
        currentRuleId = ruleId
        context.options = resolveRuleOptions(ruleId, mergedRuleOptions[ruleId], registry)
        rule.check(context)
      catch err: any
        diagnostics.push({
          ruleId: "internal-rule-error"
          severity: "error"
          message: `Rule "${ruleId}" threw an internal error: ${err.message or err}`
          line: 1
          column: 1
        })
      finally
        currentRuleId = ""

  // Sort diagnostics by line, then column
  diagnostics.sort (a, b) ->
    if a.line isnt b.line
      a.line - b.line
    else
      a.column - b.column

  fixableList := diagnostics.filter (d) -> d.fix?
  fixableCount := fixableList.length

  var fixedSource: string | undefined = undefined
  var appliedFixesCount = 0
  var isEquivalencePreserved = true

  if options.fix and fixableCount > 0
    // Validate each rule's edit batch independently so one faulty rule does
    // not prevent unrelated, compiler-equivalent fixes from being applied.
    fixesByRule := new Map<string, Fix[]>()
    for diag of fixableList
      ruleFixes := fixesByRule.get(diag.ruleId) or []
      ruleFixes.push(diag.fix!)
      fixesByRule.set(diag.ruleId, ruleFixes)

    // Accepts a candidate's compiled output. The strict rule is unchanged: it must
    // equal the original file's output byte-for-byte.
    //
    // A rule may additionally declare a *reference source* (see
    // `EquivalenceReference`) — a rewrite of the ORIGINAL Civet source expressing the
    // same normalization its fixes perform. When the strict check fails, the
    // candidate's output must instead equal that reference source's compiled output,
    // byte-for-byte.
    //
    // Trust boundary: the reference is supplied by the rule, so this check confirms
    // that a rule's fixes agree with its OWN declared normalization — it does not
    // independently prove the normalization is meaning-preserving. A reference broad
    // enough to describe an arbitrary rewrite would authorize that rewrite. The
    // safety of an opt-in reference therefore rests on it being narrow, and on review
    // of the rule that declares it; `declareOutputDelta` below bounds the blast radius
    // mechanically. Rules that declare no reference — every rule today except opt-in
    // terse imports — are governed solely by the strict check.
    acceptCandidate := (ruleId: string, candidateOutput: string): boolean ->
      return true if candidateOutput is originalCompiled
      build := equivalenceReferences.get(ruleId)
      return false unless build?
      referenceSource := build(source)
      return false unless referenceSource? and referenceSource isnt source
      referenceRes := compileForOutput(referenceSource, { dial: civetOptions, compileOptions, filename })
      return false unless referenceRes.ok and referenceRes.output is candidateOutput
      // The reference may only move the emitted output within the delta the rule
      // declared. A rule whose reference changes anything else is rejected even
      // though its own reference agreed, so a broad reference cannot launder an
      // arbitrary rewrite.
      outputDeltaAllowed(ruleId, originalCompiled!, candidateOutput)

    approvedFixes: Fix[] := []
    for [ruleId, ruleFixes] of fixesByRule
      { output: ruleCandidate, appliedEdits: ruleApplied } := applyEdits(source, ruleFixes)
      continue if ruleCandidate is source

      candidateRes := compileForOutput(ruleCandidate, { dial: civetOptions, compileOptions, filename })
      if candidateRes.ok
        if acceptCandidate(ruleId, candidateRes.output!)
          approvedFixes.push(...ruleApplied)
        else
          isEquivalencePreserved = false
          diagnostics.push({
            ruleId: "compiler-equivalence-mismatch"
            severity: "error"
            message: `Autofix from "${ruleId}" was rejected because emitted compiler output changed.`
            line: 1
            column: 1
          })
      else
        isEquivalencePreserved = false
        diagnostics.push({
          ruleId: "compiler-equivalence-failed"
          severity: "error"
          message: `Autofix from "${ruleId}" was rejected because transformed code failed compilation: ${candidateRes.error}`
          line: 1
          column: 1
        })

    { output: combinedCandidate, appliedEdits } := applyEdits(source, approvedFixes)
    if combinedCandidate isnt source
      combinedRes := compileForOutput(combinedCandidate, { dial: civetOptions, compileOptions, filename })
      // The combined reference applies every declared normalization in turn, so a
      // file mixing a reference-declaring rule with ordinary ones is still checked
      // against one exact compiled baseline.
      combinedReference := ->
        var acc = source
        for build of equivalenceReferences.values()
          next := build(acc)
          acc = next if next?
        acc
      combinedAccepted := combinedRes.ok and (
        combinedRes.output is originalCompiled or (
          equivalenceReferences.size > 0 and do
            reference := combinedReference()
            if reference is source
              false
            else
              referenceRes := compileForOutput(reference, { dial: civetOptions, compileOptions, filename })
              referenceRes.ok and
                referenceRes.output is combinedRes.output and
                // Every declared delta must permit the combined difference, so
                // mixing rules cannot widen what any one of them allows.
                Array.from(outputDeltas.keys()).every (id) ->
                  outputDeltaAllowed(id, originalCompiled!, combinedRes.output!)
        )
      )
      if combinedRes.ok
        if combinedAccepted
          fixedSource = combinedCandidate
          appliedFixesCount = appliedEdits.length

          appliedKeys := new Set(appliedEdits.map (edit) -> `${edit.start}:${edit.end}:${edit.replacement}`)
          diagnostics = diagnostics.filter (diag) ->
            not diag.fix? or not appliedKeys.has(`${diag.fix.start}:${diag.fix.end}:${diag.fix.replacement}`)
        else
          isEquivalencePreserved = false
          diagnostics.push({
            ruleId: "compiler-equivalence-mismatch"
            severity: "error"
            message: "Combined autofixes were rejected because emitted compiler output changed."
            line: 1
            column: 1
          })
      else
        isEquivalencePreserved = false
        diagnostics.push({
          ruleId: "compiler-equivalence-failed"
          severity: "error"
          message: `Combined autofixes were rejected because transformed code failed compilation: ${combinedRes.error}`
          line: 1
          column: 1
        })

  errorCount := diagnostics.filter((d) -> d.severity is "error").length
  warningCount := diagnostics.filter((d) -> d.severity is "warn").length

  {
    filePath: filename
    source
    fixedSource
    diagnostics
    appliedFixesCount
    isEquivalencePreserved
    errorCount
    warningCount
    fixableCount
  }

export async function lintFile(filePath: string, options: LintOptions = {}): Promise<LintResult>
  content := await fs.readFile(filePath, "utf8")
  registry := options.registry or defaultRuleRegistry
  baseConfig := options.config or loadConfig(undefined, path.dirname(filePath), registry)
  // Override globs are written relative to the config file, or to the workspace when
  // the config carries no path (programmatic use). Resolving them against the linted
  // file's own directory silently drops every multi-segment pattern, and disagrees
  // with `--print-config`, which resolves against the workspace.
  fileConfig := resolveConfigForFile(baseConfig, filePath, process.cwd(), registry)

  res := lintSource(content, {
    ...options
    config: fileConfig
    filename: filePath
    registry
  })

  if options.fix and res.fixedSource and res.fixedSource isnt content
    // Preserve line endings
    lineEnding := detectLineEnding(content)
    normalizedFixed := lineEnding is "\r\n"
      ? res.fixedSource.replace(/\r?\n/g, "\r\n")
      : res.fixedSource.replace(/\r\n/g, "\n")

    await atomicWriteFile(filePath, normalizedFixed)

  res
