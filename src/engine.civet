import fs from "node:fs/promises"
import path from "node:path"
import { parseSyntax, compileForOutput } from "./compiler.civet"
import type { CivetCompiler, CompileDial, CompileOptions, Diagnostic, EquivalenceReference, Fix, LintResult, OutputDelta, ResolvedConfig, RuleContext, RuleLevel, RuleOptions, RulePhase, Severity } from "./types.civet"
import { createLineColumnIndex, applyEdits, detectLineEnding, atomicWriteFile, intersectsRange, normalizeSemicolonStyle, normalizeBlockBraceStyle, normalizeTrailingCommaStyle, normalizeWhitespaceStyle, normalizeInequalityStyle, normalizeNewCallStyle, normalizePlaceholderParamStyle, normalizeRangeLoopStyle, normalizeFunctionDeclarationStyle, normalizeExistentialParenStyle } from "./utils.civet"

// Re-exported so the public API is unchanged by the move to utils.civet.
export { normalizeSemicolonStyle }
export { normalizeBlockBraceStyle }
export { normalizeWhitespaceStyle }
export { normalizeTrailingCommaStyle }
import { loadConfig, computeSkippedRules, resolveConfigForFile, resolveRuleOptions, validateRuleConflicts } from "./config.civet"
import { RuleRegistry, defaultRuleRegistry } from "./registry.civet"
import { RULE_PHASE_ORDER } from "./types.civet"
import type { SyntaxTree } from "./syntax.civet"

export interface LintOptions
  filename?: string
  config?: ResolvedConfig
  registry?: RuleRegistry
  civetOptions?: Record<string, any>
  compileOptions?: Record<string, any>
  compiler?: CivetCompiler
  // The exceptions that apply to this file; `index` identifies the entry in
  // `ResolvedConfig.exceptions` so the caller can tell which ones were used.
  exceptions?: { rule: string, line?: number, index: number }[]
  fix?: boolean
  rules?: Record<string, RuleLevel>
  ruleOptions?: Record<string, RuleOptions>
  // Restrict this pass to a single phase. lintSource runs every enabled rule when
  // omitted, which is the historical behaviour.
  phase?: RulePhase
  // Run each phase in order, re-parsing between them. See lintPhased.
  phases?: RulePhase[]

// Canonical application order for output-delta normalizers. A rule declaring
// several kinds, and the combined batch composing every rule's kinds, both walk
// this same sequence so single-rule and multi-rule verification agree.
export const DELTA_NORMALIZER_ORDER: OutputDelta[] = [
  "semicolon-style"
  "quote-style"
  "declaration-style"
  "trailing-comma-style"
  "block-brace-style"
  "type-paren-style"
  "return-paren-style"
  "inequality-style"
  "new-call-style"
  "placeholder-param"
  "range-loop"
  "function-declaration"
  "existential-paren-style"
  "whitespace-style"
]

export function normalizeQuoteStyle(code: string): string
  var out = ""
  var i = 0
  while i < code.length
    ch := code[i]
    if ch is "/" and (code[i + 1] is "/" or code[i + 1] is "*")
      block := code[i + 1] is "*"
      end := block ? code.indexOf("*/", i + 2) : code.indexOf("\n", i + 2)
      stop := end < 0 ? code.length : (block ? end + 2 : end)
      out += code.slice(i, stop)
      i = stop
      continue
    if ch is "`"
      var j = i + 1
      while j < code.length
        break if code[j] is "`" and code[j - 1] isnt "\\"
        j++
      out += code.slice(i, Math.min(j + 1, code.length))
      i = j + 1
      continue
    if ch is '"' or ch is "'"
      quote := ch
      var j = i + 1
      var body = ""
      var closed = false
      while j < code.length
        c := code[j]
        if c is "\\"
          body += code.slice(j, j + 2)
          j += 2
          continue
        if c is quote
          closed = true
          break
        if c is "\n"
          break
        body += c
        j++
      unless closed
        out += ch
        i++
        continue
      if quote is "'" and not body.includes('"')
        out += '"' + body + '"'
      else
        out += quote + body + quote
      i = j + 1
      continue
    out += ch
    i++
  out


export function normalizeDeclarationStyle(code: string): string
  var out = ""
  var i = 0
  while i < code.length
    ch := code[i]
    if ch is "/" and (code[i + 1] is "/" or code[i + 1] is "*")
      block := code[i + 1] is "*"
      end := block ? code.indexOf("*/", i + 2) : code.indexOf("\n", i + 2)
      stop := end < 0 ? code.length : (block ? end + 2 : end)
      out += code.slice(i, stop)
      i = stop
      continue
    if ch is "`" or ch is '"' or ch is "'"
      quote := ch
      var j = i + 1
      while j < code.length
        if code[j] is "\\"
          j += 2
          continue
        break if code[j] is quote
        break if code[j] is "\n" and quote isnt "`"
        j++
      out += code.slice(i, Math.min(j + 1, code.length))
      i = j + 1
      continue
    if ch is "c" and code.startsWith("const", i)
      before := i > 0 ? code[i - 1] : ""
      after := code[i + 5] ?? ""
      isWordChar := (c: string): boolean -> /[A-Za-z0-9_$]/.test(c)
      if not isWordChar(before) and not isWordChar(after)
        out += "let"
        i += 5
        continue
    out += ch
    i++
  out

// Normalize away insignificant whitespace, so a fix that only changes how a call
// is delimited can be verified. Civet emits the layout of the source verbatim, so
// `it('a', =>\n  body\n)` and `it 'a', =>\n  body` produce identical statements
// that differ only as `}\n)` vs `})` — the byte-identical gate would otherwise
// reject every implicit-block fix.
//
// String and comment contents are copied through untouched: whitespace is
// significant inside them, and collapsing it would change the program.
export function normalizeTypeParenStyle(code: string): string
  var out = ""
  var i = 0
  while i < code.length
    ch := code[i]
    if ch is "/" and (code[i + 1] is "/" or code[i + 1] is "*")
      block := code[i + 1] is "*"
      end := block ? code.indexOf("*/", i + 2) : code.indexOf("\n", i + 2)
      stop := end < 0 ? code.length : (block ? end + 2 : end)
      out += code.slice(i, stop)
      i = stop
      continue
    if ch is "`" or ch is '"' or ch is "'"
      quote := ch
      var j = i + 1
      while j < code.length
        if code[j] is "\\"
          j += 2
          continue
        break if code[j] is quote
        break if code[j] is "\n" and quote isnt "`"
        j++
      out += code.slice(i, Math.min(j + 1, code.length))
      i = j + 1
      continue
    if ch is "("
      var j = i + 1
      var hasPipe = false
      var invalid = false
      while j < code.length
        c := code[j]
        break if c is ")"
        if c is "(" or c is "{" or c is "}" or c is "[" or c is "]" or c is ":" or c is ";" or c is ","
          invalid = true
          break
        if c is "|"
          hasPipe = true
        j++
      if not invalid and hasPipe and j < code.length and code[j] is ")"
        prevText := out.trimEnd()
        nextText := code.slice(j + 1).trimStart()
        prevChar := prevText.slice(-1)
        nextChar := nextText[0] ?? ""
        if prevChar isnt "&" and nextChar isnt "&" and nextChar isnt "["
          inner := code.slice(i + 1, j)
          unless inner.includes("=>")
            out += inner
            i = j + 1
            continue
    out += ch
    i++
  out

// Drops a paren pair that wraps the whole of a `return` expression. Civet passes
// source parens straight through, so `return (\n  <div>…\n)` emits `return (…)`
// while the de-parenthesised source emits `return …` -- the same value either way.
// Consulted only for rules that declare the `return-paren-style` delta, so its
// blast radius is those rules' own edits.
export function normalizeReturnParenStyle(code: string): string
  var out = ""
  var i = 0
  while i < code.length
    ch := code[i]
    if ch is "/" and (code[i + 1] is "/" or code[i + 1] is "*")
      block := code[i + 1] is "*"
      end := block ? code.indexOf("*/", i + 2) : code.indexOf("\n", i + 2)
      stop := end < 0 ? code.length : (block ? end + 2 : end)
      out += code.slice(i, stop)
      i = stop
      continue
    if ch is "`" or ch is '"' or ch is "'"
      quote := ch
      var j = i + 1
      while j < code.length
        if code[j] is "\\"
          j += 2
          continue
        break if code[j] is quote
        break if code[j] is "\n" and quote isnt "`"
        j++
      out += code.slice(i, Math.min(j + 1, code.length))
      i = j + 1
      continue
    if ch is "r" and code.startsWith("return", i) and not /[\w$]/.test(code[i - 1] ?? "") and not /[\w$]/.test(code[i + 6] ?? "")
      var k = i + 6
      while code[k] is " " or code[k] is "\t"
        k++
      if code[k] is "("
        // Walk to the matching close, skipping nested parens and any string.
        var depth = 0
        var m = k
        var bad = false
        while m < code.length
          c := code[m]
          if c is '"' or c is "'" or c is "`"
            q := c
            m++
            while m < code.length
              if code[m] is "\\"
                m += 2
                continue
              break if code[m] is q
              m++
            m++
            continue
          if c is "("
            depth++
          else if c is ")"
            depth--
            break if depth is 0
          else if c is ";"
            bad = true
            break
          m++
        if not bad and depth is 0 and m < code.length
          // Only when the close paren ends the statement: anything after it on
          // the line (`.foo`, an operator) means the parens were doing work.
          var t = m + 1
          while code[t] is " " or code[t] is "\t"
            t++
          rest := code[t] ?? ""
          if rest is "\n" or rest is "" or rest is "}" or rest is ";"
            out += "return "
            out += normalizeReturnParenStyle(code.slice(k + 1, m)).trim()
            i = m + 1
            continue
    out += ch
    i++
  out

export function compileSource(source: string, civetOptions: Record<string, any> = {}, filename: string = "unknown.civet"): string
  res := compileForOutput(source, { dial: civetOptions, filename })
  if res.ok
    res.output!
  else
    throw new Error(res.error)

export function lintSource(source: string, options: LintOptions = {}): LintResult
  registry := options.registry or defaultRuleRegistry
  filename := options.filename or "input.civet"
  resolvedConfig: ResolvedConfig := (options.config as ResolvedConfig)?.rules
    ? (options.config as ResolvedConfig)
    : loadConfig(undefined, process.cwd(), registry)

  mergedRules := { ...resolvedConfig.rules, ...(options.rules or {}) }
  mergedRuleOptions := { ...(resolvedConfig.ruleOptions or {}), ...(options.ruleOptions or {}) }
  civetOptions: CompileDial := { ...resolvedConfig.civetOptions, ...(options.civetOptions or {}) }
  compileOptions: CompileOptions := { ...resolvedConfig.compileOptions, ...(options.compileOptions or {}) }
  compiler := options.compiler or resolvedConfig.compiler

  for ruleId of Object.keys(mergedRules)
    level := mergedRules[ruleId]
    if (level is "warn" or level is "error") and not registry.has(ruleId)
      throw new Error(`Unknown rule ID: "${ruleId}". Available rules: ${registry.getRuleList().map((r) -> r.id).join(", ")}`)

  validateRuleConflicts(mergedRules, registry)

  skippedIds := new Set(computeSkippedRules(mergedRules, civetOptions, registry).map (s) -> s.ruleId)

  getLineColumn := createLineColumnIndex(source)
  var diagnostics: Diagnostic[] = []

  var syntax: SyntaxTree | undefined = undefined
  var originalCompiled: string | undefined = undefined

  parseRes := parseSyntax(source, { dial: civetOptions, compileOptions, filename, compiler })
  if not parseRes.ok
    diag: Diagnostic := {
      ruleId: "syntax-error"
      severity: "error"
      message: `Civet parse error: ${parseRes.error}`
      line: parseRes.line or 1
      column: parseRes.column or 1
      pos: parseRes.offset or 0
    }
    return {
      filePath: filename
      source
      diagnostics: [diag]
      appliedFixesCount: 0
      isEquivalencePreserved: false
      errorCount: 1
      warningCount: 0
      fixableCount: 0
    }
  syntax = parseRes.syntax!

  baselineRes := compileForOutput(source, { dial: civetOptions, compileOptions, filename, compiler })
  if not baselineRes.ok
    diag: Diagnostic := {
      ruleId: "compile-error"
      severity: "error"
      message: `Civet baseline compile error: ${baselineRes.error}`
      line: baselineRes.line or 1
      column: baselineRes.column or 1
    }
    return {
      filePath: filename
      source
      diagnostics: [diag]
      appliedFixesCount: 0
      isEquivalencePreserved: false
      errorCount: 1
      warningCount: 0
      fixableCount: 0
    }
  originalCompiled = baselineRes.output

  commentRanges := syntax.commentRanges()

  equivalenceReferences := new Map<string, EquivalenceReference>()
  outputDeltas := new Map<string, OutputDelta[]>()
  var currentRuleId = ""
  var suppressFixForCurrentRule = false

  applyDeltaNormalizer := (kind: OutputDelta, code: string): string ->
    switch kind
      when "quote-style"
        normalizeQuoteStyle(code)
      when "semicolon-style"
        normalizeSemicolonStyle(code)
      when "declaration-style"
        normalizeDeclarationStyle(code)
      when "trailing-comma-style"
        normalizeTrailingCommaStyle(code)
      when "whitespace-style"
        normalizeWhitespaceStyle(code)
      when "block-brace-style"
        normalizeBlockBraceStyle(code)
      when "type-paren-style"
        normalizeTypeParenStyle(code)
      when "return-paren-style"
        // Compound on purpose: dropping the parens also dedents everything they
        // wrapped, so the layout moves as well. A rule declaring this delta is
        // asking for both, and saying so here is more honest than having the rule
        // pretend the re-indentation is somebody else's.
        normalizeWhitespaceStyle(normalizeReturnParenStyle(code))
      when "inequality-style"
        normalizeInequalityStyle(code)
      when "new-call-style"
        normalizeNewCallStyle(code)
      when "placeholder-param"
        normalizePlaceholderParamStyle(code)
      when "range-loop"
        normalizeRangeLoopStyle(code)
      when "function-declaration"
        normalizeFunctionDeclarationStyle(code)
      when "existential-paren-style"
        normalizeExistentialParenStyle(code)
      else
        code

  // Compose a rule's declared kinds in normalizeCombined's canonical order, so a
  // rewrite that moves several dimensions at once (say braces and a semicolon) is
  // judged by the same composite the combined batch would use.
  outputDeltaAllowed := (ruleId: string, before: string, after: string): boolean ->
    kinds := outputDeltas.get(ruleId) ?? []
    var resBefore = before
    var resAfter = after
    for kind of DELTA_NORMALIZER_ORDER
      continue unless kinds.includes(kind)
      resBefore = applyDeltaNormalizer(kind, resBefore)
      resAfter = applyDeltaNormalizer(kind, resAfter)
    resBefore is resAfter

  fileExceptions := options.exceptions or []
  exceptedRules := new Set(fileExceptions.map (entry) -> entry.rule)
  usedExceptions := new Set<number>()
  var suppressedCount = 0

  context: RuleContext := {
    source
    syntax
    filename
    parseOptions: civetOptions
    baselineOutput: originalCompiled
    compiler
    options: {}
    getLineColumn
    declareEquivalenceReference: (delta, build) ->
      if currentRuleId
        equivalenceReferences.set(currentRuleId, build)
        outputDeltas.set(currentRuleId, Array.isArray(delta) ? delta : [delta])
    report: (d) ->
      ruleLevel := mergedRules[d.ruleId] or "off"
      return if ruleLevel is "off"

      reportingRule := registry.get(d.ruleId)
      allowsCommentFix := reportingRule?.meta.allowFixesInsideComments is true
      if d.fix and not allowsCommentFix and intersectsRange(commentRanges, d.fix.start, d.fix.end)
        return

      severity: Severity := (ruleLevel is "error" or ruleLevel is "warn")
        ? ruleLevel
        : (d.severity or "error")

      var line = d.line
      var column = d.column
      if line is undefined or column is undefined
        if d.pos isnt undefined
          lc := getLineColumn(d.pos)
          line = lc.line
          column = lc.column
        else if d.fix
          lc := getLineColumn(d.fix.start)
          line = lc.line
          column = lc.column
        else
          line = 1
          column = 1

      exception := fileExceptions.find (entry) -> entry.rule is d.ruleId and (not entry.line? or entry.line is line)
      if exception?
        usedExceptions.add(exception.index)
        suppressedCount++
        return

      diagnostics.push({
        ruleId: d.ruleId
        severity
        message: d.message
        line: line!
        column: column!
        pos: d.pos
        // A rule with an exception in this file is never autofixed here. Its
        // equivalence reference is built from every site it found, so applying
        // some of them cannot be verified -- and once other fixes move lines, a
        // line-keyed exception would stop protecting the site it names.
        fix: suppressFixForCurrentRule or exceptedRules.has(d.ruleId) ? undefined : d.fix
      })
  }

  for ruleId of Object.keys(mergedRules)
    continue if mergedRules[ruleId] is "off"
    continue if skippedIds.has(ruleId)
    rule := registry.get(ruleId)
    rulePhase := rule ? (rule.meta.phase or "idiom") : "idiom"
    // When a phase is requested, only rules belonging to it participate -- including
    // in the equivalence reference, so a phase is verified against its own fixes.
    if options.phase? and rule? and rulePhase isnt options.phase
      continue
    // A "repair" rule changes emitted output by design and is only applied when the
    // caller opts into that phase (as `--rewrite` does). Outside it the rule still
    // REPORTS -- the mis-compilation is worth knowing about -- but its fix is
    // withheld, so a plain `--write` neither applies it nor reports a confusing
    // equivalence mismatch for a fix it was never going to use.
    suppressFix := rulePhase is "repair" and options.phase isnt "repair"
    if rule
      try
        currentRuleId = ruleId
        suppressFixForCurrentRule = suppressFix
        context.options = resolveRuleOptions(ruleId, mergedRuleOptions[ruleId], registry)
        rule.check(context)
      catch err: any
        diagnostics.push({
          ruleId: "internal-rule-error"
          severity: "error"
          message: `Rule "${ruleId}" threw an internal error: ${err.message or err}`
          line: 1
          column: 1
        })
      finally
        currentRuleId = ""
        suppressFixForCurrentRule = false

  diagnostics.sort (a, b) ->
    if a.line isnt b.line
      a.line - b.line
    else
      a.column - b.column

  fixableList := diagnostics.filter (d) -> d.fix?
  fixableCount := fixableList.length

  var fixedSource: string | undefined = undefined
  var appliedFixesCount = 0
  var isEquivalencePreserved = true

  if options.fix and fixableCount > 0
    fixesByRule := new Map<string, Fix[]>()
    for diag of fixableList
      ruleFixes := fixesByRule.get(diag.ruleId) or []
      ruleFixes.push(diag.fix!)
      fixesByRule.set(diag.ruleId, ruleFixes)

    // A "repair" rule changes emitted output on purpose -- it fixes code the compiler
    // mis-parses, so requiring byte-identical emit would reject every real repair.
    // Its gate instead demands that the mis-parse the phase targets was present
    // before and is gone after. Correctness of the surrounding behaviour is the
    // project test suite's job, which is why repairs are opt-in.
    // Each repair targets a specific mis-compilation. The gate requires that the
    // defect was present before and is absent after, so a repair rule cannot use
    // this phase as a licence to make arbitrary edits.
    //
    //   object-literal arrow  `=>( {`      — a braced body read as an object literal
    //   discarded return      `=> { x; }`  — a concise body collapsed into a block
    misparsePattern := /=>\(\s*\{/

    // Counts `=> { ... ; }` bodies whose braces wrap a single semicolon-terminated
    // expression — the shape a concise arrow collapses into. A regex cannot express
    // this because the body spans lines and nests braces, so the brace is matched.
    countDiscardedBodies := (code: string): number ->
      var total = 0
      var i = 0
      while i < code.length
        idx := code.indexOf("=>", i)
        break if idx < 0
        var j = idx + 2
        while j < code.length and (code[j] is " " or code[j] is "\t")
          j++
        if code[j] isnt "{"
          i = idx + 2
          continue
        var depth = 0
        var k = j
        var end = -1
        while k < code.length
          if code[k] is "{"
            depth++
          else if code[k] is "}"
            depth--
            if depth is 0
              end = k
              break
          k++
        if end < 0
          i = idx + 2
          continue
        inner := code.slice(j + 1, end).trim()
        // A single statement ending in `;` and containing no further statements.
        total++ if inner.endsWith(";") and not inner.slice(0, -1).includes(";")
        i = end + 1
      total

    countMatches := (code: string, pattern: RegExp): number ->
      code.match(new RegExp(pattern.source, "g"))?.length ?? 0

    // A repair must strictly REDUCE the defect, not necessarily eliminate it. Nested
    // constructs are peeled one layer per pass (see style/no-braced-arrow-body), so
    // requiring zero occurrences would reject every intermediate step and leave the
    // file unrepaired. Requiring a strict decrease still forbids a rule from making
    // unrelated edits under cover of the phase.
    repairIsAcceptable := (candidateOutput: string): boolean ->
      before := originalCompiled!
      fixedMisparse := countMatches(candidateOutput, misparsePattern) < countMatches(before, misparsePattern)
      fixedDiscard := countDiscardedBodies(candidateOutput) < countDiscardedBodies(before)
      fixedMisparse or fixedDiscard

    acceptCandidate := (ruleId: string, candidateOutput: string): boolean ->
      return true if candidateOutput is originalCompiled
      if (registry.get(ruleId)?.meta.phase or "idiom") is "repair"
        return repairIsAcceptable(candidateOutput)
      build := equivalenceReferences.get(ruleId)
      return false unless build?
      referenceSource := build(source)
      return false unless referenceSource? and referenceSource isnt source
      referenceRes := compileForOutput(referenceSource, { dial: civetOptions, compileOptions, filename, compiler })
      return false unless referenceRes.ok and referenceRes.output is candidateOutput
      outputDeltaAllowed(ruleId, originalCompiled!, candidateOutput)

    approvedFixes: Fix[] := []
    approvedRuleIds := new Set<string>()
    for [ruleId, ruleFixes] of fixesByRule
      { output: ruleCandidate, appliedEdits: ruleApplied } := applyEdits(source, ruleFixes)
      continue if ruleCandidate is source

      candidateRes := compileForOutput(ruleCandidate, { dial: civetOptions, compileOptions, filename, compiler })
      if candidateRes.ok
        if acceptCandidate(ruleId, candidateRes.output!)
          approvedFixes.push(...ruleApplied)
          approvedRuleIds.add(ruleId)
        else
          isEquivalencePreserved = false
          diagnostics.push({
            ruleId: "compiler-equivalence-mismatch"
            severity: "error"
            message: `Autofix from "${ruleId}" was rejected because emitted compiler output changed.`
            line: 1
            column: 1
          })
      else
        isEquivalencePreserved = false
        diagnostics.push({
          ruleId: "compiler-equivalence-failed"
          severity: "error"
          message: `Autofix from "${ruleId}" was rejected because transformed code failed compilation: ${candidateRes.error}`
          line: 1
          column: 1
        })

    { output: combinedCandidate, appliedEdits } := applyEdits(source, approvedFixes)
    // applyEdits drops an edit that overlaps one approved earlier (keeping the
    // outermost span). A rule whose every surviving edit was dropped that way must
    // also stay out of the reference chain below: the chain re-applies each rule's
    // builder, so including it would re-apply an edit the candidate really dropped
    // and the reference would diverge from the combined output.
    survivingFixKeys := new Set(appliedEdits.map (edit) -> `${edit.start}:${edit.end}:${edit.replacement}`)
    fixRuleByKey := new Map<string, string>()
    for [ruleId, ruleFixes] of fixesByRule
      continue unless approvedRuleIds.has(ruleId)
      for f of ruleFixes
        fixRuleByKey.set(`${f.start}:${f.end}:${f.replacement}`, ruleId)
    chainRuleIds := new Set<string>()
    for key of survivingFixKeys
      ruleId := fixRuleByKey.get(key)
      chainRuleIds.add(ruleId) if ruleId?
    if combinedCandidate isnt source
      combinedRes := compileForOutput(combinedCandidate, { dial: civetOptions, compileOptions, filename, compiler })
      // Each rule's reference builder is written against the ORIGINAL source and uses
      // absolute offsets, so chaining the builders would feed rule N+1 a string whose
      // positions have already shifted. Instead, derive each rule's edit against the
      // original as a single replaced span (common prefix/suffix diff) and merge those
      // spans through applyEdits, which is how the real fixes are combined.
      // Each rule's builder is written against the ORIGINAL source and uses absolute
      // offsets, so the builders cannot simply be chained — once the first rule has
      // rewritten the text, the second rule's offsets refer to positions that have
      // moved. Instead, re-run every rule's `check` against the accumulated text so
      // each builder is rebuilt on the string it is actually about to transform.
      combinedReference := ->
        var acc = source
        for id of chainRuleIds
          rule := registry.get(id)
          continue unless rule?
          accParse := parseSyntax(acc, { dial: civetOptions, compileOptions, filename, compiler })
          break unless accParse.ok and accParse.syntax?

          // The baseline must track the accumulated text, not the original source.
          // A rule that self-verifies its removals against `baselineOutput` (as
          // no-trailing-semicolons does) would otherwise compare against an emit
          // that still contains an earlier rule's verbatim-layout edits, judge its
          // own edit output-changing, and drop out of the chain -- leaving the
          // reference missing a change the combined candidate really makes.
          accCompiled := compileForOutput(acc, { dial: civetOptions, compileOptions, filename, compiler })

          var rebuilt: EquivalenceReference | undefined = undefined
          scratchContext: RuleContext := {
            ...context
            source: acc
            syntax: accParse.syntax!
            options: resolveRuleOptions(id, mergedRuleOptions[id], registry)
            getLineColumn: createLineColumnIndex(acc)
            baselineOutput: if accCompiled.ok then accCompiled.output else undefined
            compiler
            declareEquivalenceReference: (_delta, build) -> rebuilt = build
            report: -> undefined
          }
          try
            rule.check(scratchContext)
          catch
            break
          continue unless rebuilt?
          next := rebuilt!(acc)
          acc = next if next? and next isnt acc
        acc
      normalizeCombined := (code: string): string ->
        var res = code
        kinds := new Set(Array.from(chainRuleIds).flatMap((id) -> outputDeltas.get(id) ?? []))
        for kind of DELTA_NORMALIZER_ORDER
          continue unless kinds.has(kind)
          res = applyDeltaNormalizer(kind, res)
        res
      // Same distinction as acceptCandidate: a repair phase is verified by the
      // mis-parse disappearing, not by the emit staying identical.
      isRepairPhase := options.phase is "repair"
      combinedAccepted := isRepairPhase
        ? combinedRes.ok and repairIsAcceptable(combinedRes.output!)
        : combinedRes.ok and (
        combinedRes.output is originalCompiled or (
          approvedRuleIds.size > 0 and do
            reference := combinedReference()
            if reference is source
              false
            else
              referenceRes := compileForOutput(reference, { dial: civetOptions, compileOptions, filename, compiler })
              // The chain replays every surviving rule in isolation, so it can
              // re-derive an edit the combined candidate had to drop as an overlap
              // conflict (a rule's span shielding another rule's edit). Judging the
              // chain against the candidate through the declared deltas -- exactly
              // like the original-vs-combined check below -- tolerates that benign
              // divergence while still rejecting any undeclared difference.
              referenceRes.ok and
                normalizeCombined(referenceRes.output!) is normalizeCombined(combinedRes.output!) and
                normalizeCombined(originalCompiled!) is normalizeCombined(combinedRes.output!)
        )
      )
      if combinedRes.ok
        if combinedAccepted
          fixedSource = combinedCandidate
          appliedFixesCount = appliedEdits.length

          appliedKeys := new Set(appliedEdits.map (edit) -> `${edit.start}:${edit.end}:${edit.replacement}`)
          diagnostics = diagnostics.filter (diag) ->
            not diag.fix? or not appliedKeys.has(`${diag.fix.start}:${diag.fix.end}:${diag.fix.replacement}`)
        else
          isEquivalencePreserved = false
          diagnostics.push({
            ruleId: "compiler-equivalence-mismatch"
            severity: "error"
            message: "Combined autofixes were rejected because emitted compiler output changed."
            line: 1
            column: 1
          })
      else
        isEquivalencePreserved = false
        diagnostics.push({
          ruleId: "compiler-equivalence-failed"
          severity: "error"
          message: `Combined autofixes were rejected because transformed code failed compilation: ${combinedRes.error}`
          line: 1
          column: 1
        })

  errorCount := diagnostics.filter((d) -> d.severity is "error").length
  warningCount := diagnostics.filter((d) -> d.severity is "warn").length

  {
    filePath: filename
    source
    fixedSource
    diagnostics
    appliedFixesCount
    isEquivalencePreserved
    errorCount
    warningCount
    fixableCount
    suppressedCount
    usedExceptions: [...usedExceptions]
  }

// Runs each phase in turn, feeding one phase's fixed output into the next.
//
// A single pass cannot express "de-brace this arrow body, THEN drop the semicolons
// that de-bracing made redundant": every rule sees the original source, so the
// second rule judges text that no longer exists by the time fixes are applied.
// Re-parsing between phases is what makes such a dependency expressible.
//
// Diagnostics are collected from every phase, but positions belong to the text that
// phase saw. Only the final phase's diagnostics are reported, since earlier ones
// refer to superseded offsets -- an earlier phase's findings are either fixed (and
// so gone) or re-reported by the final pass.
export function lintPhased(source: string, options: LintOptions = {}): LintResult
  phases := options.phases or RULE_PHASE_ORDER
  registry := options.registry or defaultRuleRegistry
  config := (options.config as ResolvedConfig)?.rules
    ? options.config as ResolvedConfig
    : loadConfig(undefined, process.cwd(), registry)
  rules := { ...config.rules, ...(options.rules or {}) }
  activePhases := new Set(Object.keys(rules)
    .filter((id) -> rules[id] isnt "off")
    .map((id) -> registry.get(id)?.meta.phase or "idiom"))

  if options.fix
    // Most files in a later corpus pass have already settled. One read-only
    // lint proves there is no eligible fix; avoid re-parsing every phase just
    // to produce that same final report. Repair findings must still run their
    // phase because the unphased check deliberately withholds repair fixes.
    initial := lintSource(source, { ...options, phases: undefined, fix: false })
    needsWork := initial.diagnostics.some (diagnostic) ->
      rulePhase := registry.get(diagnostic.ruleId)?.meta.phase or "idiom"
      phases.includes(rulePhase) and (diagnostic.fix? or rulePhase is "repair")
    return initial unless needsWork

  var current = source
  var totalApplied = 0
  var everFixed = false
  var equivalencePreserved = true
  used := new Set<number>()
  rejections: Diagnostic[] := []

  // Each phase runs to a fixed point. Nested constructs produce overlapping fixes --
  // de-bracing `describe => { it => { ... } }` yields an outer edit whose span
  // contains the inner one -- and applyEdits keeps only the outermost of an
  // overlapping pair. Re-running the phase against the rewritten text exposes the
  // next layer, so nesting is peeled one level per iteration instead of being
  // silently left half-repaired.
  MAX_PASSES := 10
  for phase of phases
    // An empty phase cannot change the source or findings. Avoid its redundant
    // parse and baseline emit, especially for house presets with no declarations.
    continue unless activePhases.has(phase)
    var pass = 0
    while pass < MAX_PASSES
      pass++
      res := lintSource(current, { ...options, phases: undefined, phase, filename: options.filename })
      used.add(index) for index of res.usedExceptions or []
      equivalencePreserved = false unless res.isEquivalencePreserved
      totalApplied += res.appliedFixesCount
      unless res.fixedSource? and res.fixedSource isnt current
        // The phase has settled. A fix the gate rejected on this last pass will be
        // rejected again next run, so it must reach the report: the final re-lint
        // below runs without `fix` and would show it as merely "fixable".
        rejections.push(...res.diagnostics.filter (d) -> d.ruleId.startsWith("compiler-equivalence-"))
        break
      current = res.fixedSource
      everFixed = true

  // Re-run the final state so reported diagnostics match the text the user ends up
  // with, rather than whatever the last phase happened to look at.
  final := lintSource(current, { ...options, phases: undefined, phase: undefined, fix: false, filename: options.filename })

  {
    filePath: options.filename or "input.civet"
    source
    fixedSource: everFixed ? current : undefined
    diagnostics: [...final.diagnostics, ...rejections]
    appliedFixesCount: totalApplied
    isEquivalencePreserved: equivalencePreserved
    errorCount: final.errorCount + rejections.length
    warningCount: final.warningCount
    fixableCount: final.fixableCount
    suppressedCount: final.suppressedCount
    // An exception that matched before fixes moved its line still counts as used.
    usedExceptions: [...new Set([...used, ...(final.usedExceptions or [])])]
  }

export async function lintFile(filePath: string, options: LintOptions = {}): Promise<LintResult>
  content := await fs.readFile(filePath, "utf8")
  registry := options.registry or defaultRuleRegistry
  baseConfig := options.config or loadConfig(undefined, path.dirname(filePath), registry)
  fileConfig := resolveConfigForFile(baseConfig, filePath, process.cwd(), registry)

  hasOrderedRules := Object.keys(fileConfig.rules).some (ruleId) ->
    phase := registry.get(ruleId)?.meta.phase
    fileConfig.rules[ruleId] isnt "off" and (phase is "repair" or phase is "declaration")
  shouldRunPhases := options.phases? or (options.fix and hasOrderedRules)
  absolutePath := path.resolve(filePath)
  exceptions := (fileConfig.exceptions or [])
    .map((entry, index) -> { entry.rule, entry.line, index, entry.file })
    .filter (entry) -> entry.file is absolutePath
  // A plain `--write` promises unchanged emit. A `repair` changes it by design,
  // so that phase runs only when the caller asks for it, as `--rewrite` does;
  // here the mis-compilation is reported and its fix withheld.
  phases := options.phases or RULE_PHASE_ORDER.filter (phase) -> phase isnt "repair"
  res := shouldRunPhases
    ? lintPhased(content, { ...options, phases, config: fileConfig, filename: filePath, registry, exceptions })
    : lintSource(content, { ...options, config: fileConfig, filename: filePath, registry, exceptions })

  if options.fix and res.fixedSource and res.fixedSource isnt content
    lineEnding := detectLineEnding(content)
    normalizedFixed := lineEnding is "\r\n"
      ? res.fixedSource.replace(/\r?\n/g, "\r\n")
      : res.fixedSource.replace(/\r\n/g, "\n")

    await atomicWriteFile(filePath, normalizedFixed)

  res

export async function rewriteFile(filePath: string, options: LintOptions = {}): Promise<LintResult>
  content := await fs.readFile(filePath, "utf8")
  destPath := filePath.replace(/\.(jsx?|tsx?|mts|cts)$/, ".civet")

  var destExists = false
  try
    await fs.stat(destPath)
    destExists = true
  catch
    destExists = false

  if destExists
    return {
      filePath
      source: content
      diagnostics: [{
        ruleId: "io-error"
        severity: "error"
        message: `Cannot rewrite "${filePath}": destination "${destPath}" already exists.`
        line: 1
        column: 1
      }]
      appliedFixesCount: 0
      isEquivalencePreserved: false
      errorCount: 1
      warningCount: 0
      fixableCount: 0
    }

  registry := options.registry or defaultRuleRegistry
  baseConfig := options.config or loadConfig(undefined, path.dirname(filePath), registry)
  fileConfig := resolveConfigForFile(baseConfig, destPath, process.cwd(), registry)

  civetOptions: CompileDial := { ...fileConfig.civetOptions, ...(options.civetOptions or {}) }
  compileOptions: CompileOptions := { ...fileConfig.compileOptions, ...(options.compileOptions or {}) }

  parseRes := parseSyntax(content, { dial: civetOptions, compileOptions, filename: filePath, compiler: fileConfig.compiler })
  if not parseRes.ok
    return {
      filePath
      source: content
      diagnostics: [{
        ruleId: "syntax-error"
        severity: "error"
        message: `Cannot rewrite "${filePath}": parse error under resolved dial: ${parseRes.error}`
        line: parseRes.line or 1
        column: parseRes.column or 1
        pos: parseRes.offset or 0
      }]
      appliedFixesCount: 0
      isEquivalencePreserved: false
      errorCount: 1
      warningCount: 0
      fixableCount: 0
    }

  baselineRes := compileForOutput(content, { dial: civetOptions, compileOptions, filename: filePath, compiler: fileConfig.compiler })
  if not baselineRes.ok
    return {
      filePath
      source: content
      diagnostics: [{
        ruleId: "compile-error"
        severity: "error"
        message: `Cannot rewrite "${filePath}": baseline compile error under resolved dial: ${baselineRes.error}`
        line: baselineRes.line or 1
        column: baselineRes.column or 1
      }]
      appliedFixesCount: 0
      isEquivalencePreserved: false
      errorCount: 1
      warningCount: 0
      fixableCount: 0
    }

  await fs.rename(filePath, destPath)

  // A freshly renamed JS file is the case the "repair" phase exists for: its
  // `=> { ... }` bodies are mis-parsed as object literals the moment the extension
  // changes. Run the full phase order so the mis-parse is repaired before any
  // later rule judges the body. Callers can pass an explicit `phases` to opt out.
  await lintFile(destPath, {
    ...options
    config: fileConfig
    fix: true
    phases: options.phases or RULE_PHASE_ORDER
    registry
  })
