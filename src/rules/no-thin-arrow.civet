import type { Rule, RuleContext } from "../types.civet"
import { intersectsRange } from "../utils.civet"

export const noThinArrowRule: Rule = {
  id: "style/no-thin-arrow"
  meta: {
    description: "Disallow thin arrows (->); use fat arrows (=>) instead"
    fixable: false
    defaultSeverity: "warn"
  }
  check: (ctx: RuleContext) ->
    source := ctx.source
    tree := ctx.syntax
    commentRanges := tree.commentRanges()
    stringRanges := tree.stringRanges()
    ignoredRanges := [...commentRanges, ...stringRanges]

    var i = 0
    while i < source.length - 1
      if source[i] is "-" and source[i + 1] is ">"
        pos := i
        if not intersectsRange(ignoredRanges, pos, pos + 2)
          ctx.report({
            ruleId: "style/no-thin-arrow"
            message: "Use fat arrow '=>' instead of thin arrow '->'"
            pos
          })
        i += 2
      else
        i += 1
}
