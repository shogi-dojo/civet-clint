import type { Rule, RuleContext } from "../types.civet"
import { collectCommentRanges, intersectsRange, walkAst } from "../utils.civet"

function collectStringRanges(ast: any): { start: number, end: number }[]
  ranges: { start: number, end: number }[] := []
  walkAst ast, (node) ->
    return unless node? and typeof node is "object"
    if (node.type is "StringLiteral" or node.type is "TemplateLiteral" or node.type is "Literal") and node.$loc
      ranges.push({
        start: node.$loc.pos
        end: node.$loc.pos + (node.$loc.length or 0)
      })
  ranges

export const noThinArrowRule: Rule = {
  id: "style/no-thin-arrow"
  meta: {
    description: "Disallow thin arrows (->); use fat arrows (=>) instead"
    fixable: false
    defaultSeverity: "warn"
  }
  check: (ctx: RuleContext) ->
    source := ctx.source
    commentRanges := collectCommentRanges(ctx.ast)
    stringRanges := collectStringRanges(ctx.ast)
    ignoredRanges := [...commentRanges, ...stringRanges]

    var i = 0
    while i < source.length - 1
      if source[i] is "-" and source[i + 1] is ">"
        pos := i
        if not intersectsRange(ignoredRanges, pos, pos + 2)
          ctx.report({
            ruleId: "style/no-thin-arrow"
            message: "Use fat arrow '=>' instead of thin arrow '->'"
            pos
          })
        i += 2
      else
        i += 1
}
