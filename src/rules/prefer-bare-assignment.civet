import type { Rule, RuleContext } from "../types.civet"
import { intersectsRange } from "../utils.civet"

function isConstCase(name: string): boolean
  /^[A-Z][A-Z0-9_]*$/.test(name) and name.length > 1

export const preferBareAssignmentRule: Rule = {
  id: "style/prefer-bare-assignment"
  meta: {
    description: "Prefer bare '=' for let bindings and ':=' for CONST_CASE declarations under autoLet"
    fixable: true
    defaultSeverity: "error"
    capabilities: {
      requires: ["autoLet"]
    }
    conflictsWith: ["style/prefer-explicit-declarations"]
  }
  check: (ctx: RuleContext) ->
    source := ctx.source
    tree := ctx.syntax
    commentRanges := tree.commentRanges()
    stringRanges := tree.stringRanges()
    ignoredRanges := [...commentRanges, ...stringRanges]

    re := /(?:^|[\n;])([ \t]*)(export[ \t]+)?(const|let|var)[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)[ \t]*(=)/g
    var match: RegExpExecArray | null = null

    // Rewriting `const x =` to bare `x =` emits `let x =` instead of `const x =`,
    // so the byte-identical gate would reject it. Declare a declaration-style
    // reference: the engine independently confirms the only drift is const/let.
    edits: { start: number, end: number, replacement: string }[] := []
    ctx.declareEquivalenceReference?.("declaration-style", (input: string) ->
      return undefined unless edits.length > 0
      var out = input
      for edit of [...edits].sort((a, b) -> b.start - a.start)
        out = out.slice(0, edit.start) + edit.replacement + out.slice(edit.end)
      out
    )

    while (match = re.exec(source)) !== null
      matchedLeader := match[2] or match[3]
      idxLeader := match[0].indexOf(matchedLeader)
      exportKw := match[2] or ""
      declKw := match[3]
      ident := match[4]

      pos := match.index + idxLeader
      matchEnd := match.index + match[0].length
      continue if intersectsRange(ignoredRanges, pos, matchEnd)

      if isConstCase(ident)
        replacement := `${exportKw}${ident} :=`
        edits.push({ start: pos, end: matchEnd, replacement })
        ctx.report({
          ruleId: "style/prefer-bare-assignment"
          message: `Use '${exportKw}${ident} :=' instead of '${exportKw}${declKw} ${ident} ='`
          pos
          fix: {
            start: pos
            end: matchEnd
            replacement
          }
        })
      else
        replacement := `${exportKw}${ident} =`
        edits.push({ start: pos, end: matchEnd, replacement })
        ctx.report({
          ruleId: "style/prefer-bare-assignment"
          message: `Use '${exportKw}${ident} =' instead of '${exportKw}${declKw} ${ident} ='`
          pos
          fix: {
            start: pos
            end: matchEnd
            replacement
          }
        })
}
