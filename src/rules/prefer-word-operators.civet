import type { Rule, RuleContext } from "../types.civet"

const REPLACEMENT_MAP = new Map<string, string>([
  ["===", "is"]
  ["!==", "isnt"]
  ["==", "is"]
  ["!=", "isnt"]
  ["&&", "and"]
  ["||", "or"]
])

function isNull(text: string): boolean
  text.trim() is "null"

export const preferWordOperatorsRule: Rule = {
  id: "style/prefer-word-operators"
  meta: {
    description: "Prefer word operators (is, isnt, and, or, not) over JS operators"
    fixable: true
    defaultSeverity: "error"
  }
  check: (ctx: RuleContext) ->
    source := ctx.source
    tree := ctx.syntax
    reportedStarts := new Set<number>()

    tree.visit "UnaryExpression", (node) ->
      if Array.isArray(node.pre)
        for preItem of node.pre
          span := tree.range(preItem)
          if span and preItem.token is "!"
            pos := span.start
            adjacentBang := source[pos - 1] is "!" or source[pos + 1] is "!"
            if source[pos] is "!" and not adjacentBang and not reportedStarts.has(pos)
              reportedStarts.add(pos)
              nextChar := source[pos + 1]
              replacement := (nextChar is " " or nextChar is "\t" or nextChar is "\n")
                ? "not"
                : "not "
              ctx.report({
                ruleId: "style/prefer-word-operators"
                message: "Use 'not' instead of '!'"
                pos
                fix: {
                  start: pos
                  end: pos + 1
                  replacement
                }
              })

    for tok of tree.tokens()
      if tok.value
        pos := tok.range.start
        len := tok.range.end - pos
        actualSlice := source.slice(pos, pos + len)
        wordOp := REPLACEMENT_MAP.get(actualSlice)

        if wordOp and not reportedStarts.has(pos)
          continue if actualSlice is "!==" and not ctx.parseOptions.coffeeIsnt
          continue if actualSlice is "==" and not ctx.parseOptions.coffeeEq
          continue if actualSlice is "!=" and not (ctx.parseOptions.coffeeEq and ctx.parseOptions.coffeeIsnt)

          normalizedOp := REPLACEMENT_MAP.get(tok.value)
          if normalizedOp
            if actualSlice is "===" or actualSlice is "!==" or actualSlice is "==" or actualSlice is "!="
              beforeSlice := source.slice(Math.max(0, pos - 30), pos)
              afterSlice := source.slice(pos + len, Math.min(source.length, pos + len + 30))

              beforeMatch := beforeSlice.match(/([a-zA-Z0-9_$]+)\s*$/)
              afterMatch := afterSlice.match(/^\s*([a-zA-Z0-9_$]+)/)

              if (beforeMatch and isNull(beforeMatch[1])) or (afterMatch and isNull(afterMatch[1]))
                continue

            reportedStarts.add(pos)
            ctx.report({
              ruleId: "style/prefer-word-operators"
              message: `Use '${wordOp}' instead of '${actualSlice}'`
              pos
              fix: {
                start: pos
                end: pos + len
                replacement: wordOp
              }
            })
}
