import type { Rule, RuleContext } from "../types.civet"
import { walkAst } from "../utils.civet"
import { parseRawAst } from "../compiler.civet"

// Module specifiers that are provably safe to unquote. Civet's terse import form
// parses the specifier as a bare token, so anything containing whitespace or
// characters that terminate the token must keep its quotes. This allowlist is
// deliberately narrow: an unrecognized specifier keeps its quotes rather than
// risking a silently different import target.
//
// Verified against the pinned compiler: relative paths, bare package names,
// scoped packages, `node:` protocol paths, dots, dashes, underscores, digits,
// and path separators all round-trip to byte-identical output when unquoted.
const SAFE_SPECIFIER = /^(?:@[A-Za-z0-9._-]+\/)?[A-Za-z0-9._:/-]+$/

// Strips the quotes from a specifier literal.
//
// Double-quoted specifiers are byte-safe by default: Civet preserves the original
// quote character in its output, and the terse unquoted form always emits double
// quotes, so `"./foo"` -> `./foo` leaves the compiled bytes untouched.
//
// Single-quoted specifiers are not byte-identical for exactly that reason —
// unquoting `'./foo'` changes the emitted literal from `'./foo'` to `"./foo"`. That
// is a quote-style change and nothing else, but it is still a change, so it is gated
// behind the `unquoteSingleQuotes` option and validated against a reference compile
// rather than the original output. See `buildQuoteReference` below.
function unquote(raw: string, allowSingle: boolean): string | undefined
  return undefined unless raw.length >= 2
  first := raw[0]
  last := raw[raw.length - 1]
  isDouble := first is '"' and last is '"'
  isSingle := first is "'" and last is "'"
  return undefined unless isDouble or (isSingle and allowSingle)
  inner := raw.slice(1, raw.length - 1)
  // A specifier carrying an escape sequence is not the same string once the
  // quotes are removed, so leave it alone.
  return undefined if inner.includes("\\")
  // A single-quoted specifier containing a double quote cannot be re-expressed as a
  // double-quoted literal without escaping, so it has no valid reference form.
  return undefined if isSingle and inner.includes('"')
  inner

function isSafeToUnquote(spec: string): boolean
  return false unless spec.length > 0
  SAFE_SPECIFIER.test spec

// Finds the direct children of an ImportDeclaration that carry source positions
// we care about: the leading `import` keyword and the module specifier literal.
function collectParts(node: any)
  var importKeyword: any = undefined
  var specifier: any = undefined
  var hasBindings = false

  visit := (value: any) ->
    return unless value? and typeof value is "object"
    if Array.isArray value
      for item of value
        visit item
      return

    switch value.type
      when "Keyword"
        if value.token is "import" and value.$loc and not importKeyword?
          importKeyword = value
      when "Declaration"
        // Presence of a Declaration means this import binds names, which is
        // what makes the `import` keyword optional. Side-effect imports have none.
        hasBindings = true
      when "ModuleSpecifier"
        visit value.children ?? value
        return
      when "StringLiteral"
        if value.$loc and not specifier?
          specifier = value
        return

    for key of Object.keys value
      continue if key is "parent" or key is "$loc"
      visit value[key]

  visit node
  { importKeyword, specifier, hasBindings }

// Re-parses `input` and returns the source spans of every import-declaration module
// specifier, ascending. The reference source is built from a fresh parse rather than
// from the positions captured during `check`, because the engine may hand this
// builder a source that other rules' fixes have already shifted.
function parseSpecifierSpans(input: string, dial: Record<string, any>): { pos: number, length: number }[]
  res := parseRawAst input, { dial }
  return [] unless res.ok
  spans: { pos: number, length: number }[] := []
  walkAst res.ast, (node) ->
    return unless node? and typeof node is "object"
    return unless node.type is "ImportDeclaration"
    { specifier } := collectParts node
    return unless specifier?.$loc
    pos := specifier.$loc.pos
    length := specifier.$loc.length
    // Only trust a span that still matches the token the parser recorded.
    return unless input.slice(pos, pos + length) is specifier.token
    // An import attribute follows the specifier; those declarations are skipped by
    // `check`, so the reference must leave them alone too or the two would disagree.
    trailing := input.slice pos + length, pos + length + 240
    return if /^\s*(?:with|assert)\b/.test trailing
    spans.push { pos, length }
  spans.sort (a, b) -> a.pos - b.pos
  spans

export const preferTerseImportsRule: Rule = {
  id: "style/prefer-terse-imports"
  meta: {
    description: "Prefer terse imports: omit the optional 'import' keyword and unquote safe module paths"
    fixable: true
    defaultSeverity: "error"
    defaultOptions: {
      // Off by default: enabling it takes the rule off the strictly byte-identical
      // path and onto the reference-compile check (see the rule's
      // `declareEquivalenceReference` call below).
      unquoteSingleQuotes: false
    }
  }
  check: (ctx: RuleContext) ->
    source := ctx.source
    allowSingle := ctx.options.unquoteSingleQuotes is true
    seen := new Set<number>()

    // When single-quote unquoting is enabled, this rule's fixes are no longer
    // byte-identical: the emitted specifier's quote character changes from `'` to
    // `"`. Rather than weaken the gate or accept the batch being rejected, the rule
    // hands the engine a reference source — the original with those same specifiers
    // rewritten to double quotes, and nothing else changed. The engine compiles it
    // and requires an exact match.
    //
    // This is safe in a way that normalizing compiled *output* would not be: the
    // rewrite happens on Civet source at positions the parser identified as module
    // specifiers, so ordinary strings that merely look like paths are never touched.
    if allowSingle and ctx.declareEquivalenceReference?
      ctx.declareEquivalenceReference "quote-style", (input: string) ->
        parsed := parseSpecifierSpans input, ctx.parseOptions
        return undefined unless parsed.length > 0
        var out = ""
        var cursor = 0
        for { pos, length } of parsed
          raw := input.slice pos, pos + length
          continue unless raw.length >= 2 and raw[0] is "'" and raw[raw.length - 1] is "'"
          inner := raw.slice 1, raw.length - 1
          continue if inner.includes("\\") or inner.includes('"')
          continue unless isSafeToUnquote inner
          out += input.slice(cursor, pos) + '"' + inner + '"'
          cursor = pos + length
        return undefined if cursor is 0
        out + input.slice(cursor)

    walkAst ctx.ast, (node) ->
      return unless node? and typeof node is "object"
      return unless node.type is "ImportDeclaration"

      { importKeyword, specifier, hasBindings } := collectParts node

      // An already-unquoted specifier has no positioned StringLiteral child, so
      // `specifier` is absent. That is not a reason to skip the declaration: the
      // keyword removal and the unquoting are independent edits, and a partially
      // terse import still needs its keyword dropped.
      var specPos = -1
      var specLen = 0
      var rawSpec = ""
      var specUsable = false
      if specifier?
        specPos = specifier.$loc.pos
        specLen = specifier.$loc.length
        rawSpec = source.slice specPos, specPos + specLen
        // Only touch a specifier whose recorded span still matches the source.
        specUsable = rawSpec is specifier.token

      // Import attributes/assertions (`with { type: "json" }`) follow the
      // specifier. Removing the keyword there is not covered by the fixtures
      // that back this rule, so leave the whole declaration untouched.
      if specUsable
        trailing := source.slice specPos + specLen, specPos + specLen + 240
        return if /^\s*(?:with|assert)\b/.test trailing

      if importKeyword?
        kwPos := importKeyword.$loc.pos
        return unless source.slice(kwPos, kwPos + 6) is "import"

        // `import` is only optional when the declaration binds names. A
        // side-effect import must keep it, or the statement changes meaning.
        if hasBindings and not seen.has(kwPos)
          // Only a single space may separate `import` from the bindings.
          //
          // Civet echoes the original inter-token whitespace into its output, but
          // when it re-inserts the keyword for a terse import it emits exactly one
          // space. So `import   { a }` (three spaces) has no byte-identical terse
          // form: removing the run changes the emitted spacing, and keeping part
          // of it turns the remainder into indentation. Such declarations are
          // skipped rather than rewritten into an edit the gate would reject.
          end := kwPos + 7
          if source[kwPos + 6] is " " and source[end] isnt " " and source[end] isnt "\t"
            seen.add kwPos
            ctx.report({
              ruleId: "style/prefer-terse-imports"
              message: "Omit the optional 'import' keyword"
              pos: kwPos
              fix: { start: kwPos, end, replacement: "" }
            })

      return unless specUsable
      inner := unquote rawSpec, allowSingle
      if inner? and isSafeToUnquote(inner) and not seen.has(specPos)
        seen.add specPos
        ctx.report({
          ruleId: "style/prefer-terse-imports"
          message: `Unquote the module path '${inner}'`
          pos: specPos
          fix: { start: specPos, end: specPos + specLen, replacement: inner }
        })
}
