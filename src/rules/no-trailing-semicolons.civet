import type { CivetCompiler, Fix, Rule, RuleContext } from "../types.civet"
import type { SyntaxTree } from "../syntax.civet"
import { intersectsRange, applyEdits, normalizeSemicolonStyle } from "../utils.civet"
import { parseSyntax, compileForOutput } from "../compiler.civet"

// A trailing `;` in Civet is not always cosmetic. Inside a function body it is one
// of the sanctioned ways to suppress the implicit return of the last statement
// (civet.dev/reference), so deleting it can silently change what the function
// returns:
//
//   it 'x', =>          without the `;` the last statement becomes the return
//     f()               value, and a `useEffect` that returns a non-function
//     g();              makes React treat it as a cleanup callback.
//
// That one position is decided from syntax: a `;` ending the last statement of a
// value-returning function is left alone and never compiled (see
// `suppressesImplicitReturn`). They are exactly the semicolons a converged codebase
// keeps, so proving each one unsafe by compiling was the rule's entire steady-state
// cost -- a full bisection tree, 2n-1 compiles for n of them, on every run.
//
// Everything else is a candidate, and the candidates of a file are verified
// together with a single compile against the engine's baseline. Emitted `;` is
// normalized away by the "semicolon-style" delta, so a difference that survives is
// a real one; only then is the group bisected to find the offender.

type Candidate = { pos: number, fix: Fix }

function findTrailingSemicolons(source: string, tree: SyntaxTree): Candidate[]
  commentRanges := tree.commentRanges()
  stringRanges := tree.stringRanges()
  ignoredRanges := [...commentRanges, ...stringRanges]

  results: Candidate[] := []
  lines := source.split("\n")
  var currentOffset = 0

  for line of lines
    lineLen := line.length
    for let i = 0; i < lineLen; i++
      pos := currentOffset + i
      if intersectsRange(ignoredRanges, pos, pos + 1)
        continue

      ch := line[i]

      // No textual paren-depth tracking here: Civet closes calls and parenthesized
      // headers at dedent, often without any `)` in the source, so counting parens
      // line-by-line drifts permanently out of sync and hides every later
      // semicolon. Over-guessing costs nothing -- safeSemicolons compiles each
      // candidate group, and a `;` that is load-bearing (a `for ( ;; )` header,
      // a call argument separator) fails that verification and is dropped.
      if ch is ";"
        restOfLine := line.slice(i + 1)
        trimmedRest := restOfLine.trim()

        isComment := trimmedRest.startsWith("#") or trimmedRest.startsWith("//")
        isBlockEnd := trimmedRest.startsWith("}")
        isTrailing := trimmedRest.length is 0 or isComment or isBlockEnd

        if isTrailing
          var wsLen = 0
          while i + 1 + wsLen < lineLen
            nextCh := line[i + 1 + wsLen]
            break if nextCh is "\r"
            break unless nextCh is " " or nextCh is "\t"
            wsLen++

          var trailingWsToRemove = 0
          if isComment
            hasSpaceBefore := i > 0 and (line[i - 1] is " " or line[i - 1] is "\t")
            if hasSpaceBefore
              trailingWsToRemove = wsLen
            else if wsLen > 1
              trailingWsToRemove = wsLen - 1
            else
              trailingWsToRemove = 0
          else if isBlockEnd
            trailingWsToRemove = 0
          else
            trailingWsToRemove = wsLen

          results.push({
            pos
            fix: {
              start: pos
              end: pos + 1 + trailingWsToRemove
              replacement: ""
            }
          })

    currentOffset += lineLen + 1

  results

const MAX_FALLBACK_COMPILES = 24
const FUNCTION_NODES = ["FunctionExpression", "ArrowFunction", "MethodDefinition"]
const BRANCH_CONTINUATION = /^(?:else|catch|finally|when|case|default)\b/
const EXPLICIT_EXIT = /^(?:return|throw|break|continue)\b/
const PROPERTY_LIKE = /^[A-Za-z_$][\w$]*(?:\s*\(.*)?[;,]?$/
const CLOSERS_ONLY = /^[)\]}]*[;,]?$/

// True when the `;` at `pos` ends the last statement of a function that returns a
// value -- the position where it suppresses the implicit return. Conservative by
// construction: a wrong `true` only leaves a semicolon unreported, and a wrong
// `false` is still caught by the compile in `safeSemicolons`.
function suppressesImplicitReturn(source: string, tree: SyntaxTree, pos: number, functions: any[]): boolean
  var enclosing: any = undefined
  for fn of functions
    continue unless fn.start <= pos and pos < fn.end
    enclosing = fn if not enclosing? or fn.end - fn.start < enclosing.end - enclosing.start
  return false unless enclosing?
  // Every `;` in such a body is what keeps Civet reading it as a block.
  return true if enclosing.objectProne
  // `: void` functions and constructors have no implicit return to suppress.
  return false if enclosing.returnsNothing
  // Neither has a statement that already transfers control.
  lineStart := source.lastIndexOf("\n", pos - 1) + 1
  return false if EXPLICIT_EXIT.test(source.slice(lineStart, pos).trimStart())

  // Find the next line that holds a statement: not blank, not a comment, and not
  // just the closers of blocks ending here.
  var lineEnd = source.indexOf("\n", pos)
  while lineEnd >= 0 and lineEnd < enclosing.end
    nextEnd := source.indexOf("\n", lineEnd + 1)
    line := source.slice(lineEnd + 1, if nextEnd < 0 then source.length else nextEnd)
    text := line.trim()
    textStart := lineEnd + 1 + (line.length - line.trimStart().length)
    isComment := text.length > 0 and intersectsRange(enclosing.comments, textStart, textStart + 1)
    if text.length > 0 and not isComment and not CLOSERS_ONLY.test(text)
      // Past the function, or at a branch boundary whose arms each return.
      return true if textStart >= enclosing.end or BRANCH_CONTINUATION.test(text)
      // A statement follows inside the same function, so this one is not last.
      return false
    lineEnd = nextEnd
  true

// A JS-style braced arrow body made only of bare expressions is one Civet reads as
// an OBJECT LITERAL the moment its semicolons go:
//
//   batch(=> {            batch(() => ({
//     setA(1);      ->      setA: setA(1),
//     setB(2);              setB: setB(2)
//   })                    }))
//
// Only a bare `name(args)` call or a lone identifier can pass for a property, so
// one statement of any other shape at the body's own indentation settles the body
// as a block.
function isObjectProneBody(body: string): boolean
  return false unless body.startsWith("{") and body.endsWith("}")
  lines := body.slice(1, -1).split("\n").filter (line) -> line.trim().length > 0
  return false if lines.length is 0
  indent := Math.min(...lines.map (line) -> line.length - line.trimStart().length)
  lines.every (line) ->
    text := line.trim()
    line.length - line.trimStart().length > indent or PROPERTY_LIKE.test(text) or CLOSERS_ONLY.test(text)

function withoutReturnSuppressors(source: string, tree: SyntaxTree, found: Candidate[]): Candidate[]
  return found if found.length is 0
  comments := tree.commentRanges()
  functions: any[] := []
  tree.visit FUNCTION_NODES, (node) ->
    range := tree.range(node)
    return unless range?
    returnType := node.returnType ? tree.text(node.returnType) : ""
    name := typeof node.name is "string" ? node.name : ""
    arrow := node.type is "ArrowFunction" ? tree.tokens(node).find((token) -> token.value is "=>" and not token.synthetic) : undefined
    functions.push({
      range.start
      range.end
      comments
      objectProne: arrow? and isObjectProneBody(source.slice(arrow.range.end, range.end).trim())
      returnsNothing: /\bvoid\b/.test(returnType) or name is "constructor"
    })
  found.filter (item) -> not suppressesImplicitReturn(source, tree, item.pos, functions)

// Candidates whose removal provably does not change the emitted program.
//
// One compile covers the whole file in the common case where every candidate is
// removable. Only a group that fails is bisected, so k unsafe candidates cost
// O(k log n) compiles rather than O(n).
function safeSemicolons(
  source: string,
  tree: SyntaxTree,
  dial: Record<string, any>,
  baselineOutput?: string,
  compiler?: CivetCompiler,
  verifyFunctionTails = false
): Candidate[]
  all := findTrailingSemicolons(source, tree)
  found := verifyFunctionTails ? all : withoutReturnSuppressors(source, tree, all)
  return found if found.length is 0

  // The engine already compiled this exact source under the same options before
  // running any rule, and hands the result over on the context. Recompiling it
  // here was the single most expensive thing this rule did.
  baseline := if baselineOutput?
    normalizeSemicolonStyle(baselineOutput)
  else
    base := compileForOutput(source, { dial, compiler })
    return [] unless base.ok
    normalizeSemicolonStyle(base.output!)

  groupIsSafe := (group: Candidate[]): boolean ->
    return true if group.length is 0
    { output } := applyEdits(source, group.map((f) -> f.fix))
    res := compileForOutput(output, { dial, compiler })
    res.ok and normalizeSemicolonStyle(res.output!) is baseline

  // The bisection is bounded: past the budget an unverified group is simply not
  // reported, so a file the syntactic checks misjudge costs seconds, not minutes.
  var compilesLeft = MAX_FALLBACK_COMPILES
  accepted: Candidate[] := []
  partition := (group: Candidate[], depth: number): void ->
    return if group.length is 0 or compilesLeft-- <= 0
    if groupIsSafe(group)
      accepted.push(...group)
      return
    if group.length is 1 or depth > 24
      return
    mid := Math.floor(group.length / 2)
    partition(group.slice(0, mid), depth + 1)
    partition(group.slice(mid), depth + 1)

  // The whole file verified in one compile: nothing left to re-check.
  return found if groupIsSafe(found)
  mid := Math.floor(found.length / 2)
  partition(found.slice(0, mid), 1)
  partition(found.slice(mid), 1)
  accepted.sort (a, b) -> a.pos - b.pos

  // Bisection verifies each group in isolation, but two removals that are each
  // safe alone can interact — dropping one `;` can change how a later line parses.
  // Re-verify the union and, if it fails, shrink it until it holds. The engine's
  // gate would catch this anyway; doing it here means the user sees no error.
  var result = accepted
  while result.length > 0 and not groupIsSafe(result)
    result = result.slice(0, Math.floor(result.length / 2))
  result

// The engine calls the rule's reference builder with the same source it just
// checked. Memoising the last result answers that without a second parse or
// compile, and holds no memory across files.
var lastKey: string | undefined = undefined
var lastValue: Candidate[] = []

function buildReference(input: string, dial: Record<string, any>, compiler: CivetCompiler | undefined, verifyFunctionTails: boolean): string | undefined
  var found = lastValue
  unless lastKey is input
    parseRes := parseSyntax(input, { dial, compiler })
    return undefined unless parseRes.ok
    found = safeSemicolons(input, parseRes.syntax!, dial, undefined, compiler, verifyFunctionTails)
  return undefined if found.length is 0
  { output } := applyEdits(input, found.map((f) -> f.fix))
  output is input ? undefined : output

export const noTrailingSemicolonsRule: Rule = {
  id: "style/no-trailing-semicolons"
  meta: {
    description: "Disallow unnecessary trailing semicolons at statement or line ends"
    fixable: true
    defaultSeverity: "error"
    // Must run after the "repair" phase has de-braced arrow bodies: in a braced body
    // the trailing semicolon is load-bearing, and neither keeping nor removing it
    // produces correct code.
    phase: "cleanup"
    defaultOptions: {
      // Also compile-check a `;` that ends a value-returning function, removing it
      // where the emit proves it redundant. Off by default: such a semicolon almost
      // always suppresses an implicit return, and proving that costs compiles.
      verifyFunctionTails: false
    }
  }
  check: (ctx: RuleContext) ->
    verifyFunctionTails := ctx.options.verifyFunctionTails is true
    if ctx.declareEquivalenceReference?
      ctx.declareEquivalenceReference "semicolon-style", (input: string) ->
        buildReference(input, ctx.parseOptions, ctx.compiler, verifyFunctionTails)

    found := safeSemicolons(ctx.source, ctx.syntax, ctx.parseOptions, ctx.baselineOutput, ctx.compiler, verifyFunctionTails)
    lastKey = ctx.source
    lastValue = found
    for item of found
      ctx.report({
        ruleId: "style/no-trailing-semicolons"
        message: "Unnecessary trailing semicolon"
        pos: item.pos
        fix: item.fix
      })
}
