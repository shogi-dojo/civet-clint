import type { Rule, RuleContext } from "../types.civet"
import { intersectsRange } from "../utils.civet"

// Erik Demaine's Civet style guide, item 22: "Self-closing tags don't need `/`."
//
//   <Foo a=1 />   ->   <Foo a=1>
//
// Civet decides whether a slashless tag is self-closing by looking at what
// follows it, so this is only safe when nothing can be adopted as a child:
//
//   <div><Foo /><Bar /></div>   ->   <div><Foo><Bar></div>
//                                          ^ swallows <Bar/> as its child
//
// Hence the positional guards below: `/>` must end its line, and the next
// non-blank line may not be deeper than the opening tag, a closing tag of the
// same name, or a `)` / `}` closer.
//
// Emitted JS is byte-identical for the spaced form `<Foo a=1 />` -> `<Foo a=1>`.
// The unspaced form `<Foo/>` -> `<Foo>` re-emits as `<Foo />`, a single space,
// which is why the rule declares the `whitespace-style` delta.

// Locate the `>` or `/>` that terminates the opening tag starting at `openIdx`
// (where `source[openIdx]` is `<`). Quotes and `{…}` are skipped so an attribute
// value containing `>` does not end the scan early.
function findTagTerminator(source: string, openIdx: number): { start: number, selfClosing: boolean } | undefined
  var depth = 0
  var i = openIdx + 1
  while i < source.length
    ch := source[i]
    if ch is '"' or ch is "'" or ch is "`"
      quote := ch
      i++
      while i < source.length and source[i] isnt quote
        i += source[i] is "\\" ? 2 : 1
      i++
      continue
    if ch is "{"
      depth++
      i++
      continue
    if ch is "}"
      depth--
      i++
      continue
    if depth is 0
      if ch is "/" and source[i + 1] is ">"
        return { start: i, selfClosing: true }
      return { start: i, selfClosing: false } if ch is ">"
      // A nested `<` means the scan walked past this tag's own terminator.
      return undefined if ch is "<"
    i++
  undefined

export const preferBareSelfClosingJsxRule: Rule = {
  id: "style/prefer-bare-self-closing-jsx"
  meta: {
    description: "Prefer a slashless self-closing JSX tag ('<Foo>') over '<Foo />'"
    fixable: true
    defaultSeverity: "error"
    phase: "idiom"
    capabilities: {
      requires: ["react"]
    }
  }
  check: (ctx: RuleContext) ->
    source := ctx.source
    tree := ctx.syntax
    ignoredRanges := [...tree.commentRanges(), ...tree.stringRanges()]
    seen := new Set<number>()

    edits: { start: number, end: number, replacement: string }[] := []
    ctx.declareEquivalenceReference?.("whitespace-style", (input: string) ->
      return undefined unless edits.length > 0
      var out = input
      for edit of [...edits].sort((a, b) -> b.start - a.start)
        out = out.slice(0, edit.start) + edit.replacement + out.slice(edit.end)
      out
    )

    indentOfLineAt := (pos: number): number ->
      lineStart := source.lastIndexOf("\n", Math.max(pos - 1, 0)) + 1
      var i = lineStart
      while source[i] is " " or source[i] is "\t"
        i++
      i - lineStart

    tree.visit "JSXElement", (node) ->
      tag := node.tag
      return unless typeof tag is "string" and tag.length > 0
      span := tree.range(node)
      return unless span?

      // Cheap rejection first. The span of a JSXElement covers its located
      // descendants, so what follows it is the element's terminator: `/>` for a
      // self-closing tag, `</` for a closed one. Bailing on the closed case here
      // keeps the unbounded searches below off the hot path -- most elements in a
      // React codebase are closed, and scanning back through a megabyte of source
      // for each of them cost 785ms on the 441-file corpus.
      var probeEnd = span.end
      while source[probeEnd] is " " or source[probeEnd] is "\t" or source[probeEnd] is "\n" or source[probeEnd] is "\r"
        probeEnd++
      return if source.startsWith("</", probeEnd)

      // The AST carries no source position for `<Foo` or `/>` -- both come through
      // as bare strings -- so the opening tag is recovered from the element's
      // located-descendant span, then confirmed by the scanner below.
      needle := `<${tag}`
      var openIdx = source.lastIndexOf(needle, span.start)
      openIdx = source.indexOf(needle, span.start) if openIdx < 0
      return if openIdx < 0
      after := source[openIdx + needle.length]
      return unless after is undefined or /[\s/>]/.test(after)

      term := findTagTerminator(source, openIdx)
      return unless term? and term.selfClosing
      // The terminator has to belong to THIS element, not to one nested inside it.
      return unless term.start >= span.end - 1
      return if seen.has(term.start)

      // `/>` must end its line. Inline, the slashless form adopts whatever comes
      // next as a child: `<div><Foo /><Bar /></div>` -> `<Foo>` swallows `<Bar/>`,
      // and `{a ? <Foo> : <Bar />}` stops parsing altogether.
      lineEnd := source.indexOf("\n", term.start)
      tailEnd := lineEnd < 0 ? source.length : lineEnd
      return unless /^[ \t]*$/.test(source.slice(term.start + 2, tailEnd))

      // Two hazards live in whatever follows, both settled by the next non-blank
      // line:
      //
      //   * a DEEPER line becomes a child of the slashless tag;
      //   * a closing tag with the SAME name pairs with the slashless tag instead
      //     of with the enclosing element, which then loses its closer:
      //
      //       <div .outer>          <div .outer>
      //         <div .spot />   ->    <div .spot>     ->  <div .spot></div></div>
      //       </div>                </div>                            ^ consumed
      //
      //     `<Foo />` in the same position is fine, because `</div>` cannot pair
      //     with `Foo` -- which is why this only shows up on HTML-cased tags.
      openIndent := indentOfLineAt(openIdx)
      closerPrefix := `</${tag}`
      isSameCloser := (line: string): boolean ->
        return false unless line.startsWith(closerPrefix)
        rest := line[closerPrefix.length]
        rest is ">" or rest is " " or rest is "\t"
      var probe = tailEnd
      while probe < source.length
        nextEnd := source.indexOf("\n", probe + 1)
        stop := nextEnd < 0 ? source.length : nextEnd
        line := source.slice(probe + 1, stop)
        if line.trim().length > 0
          return if line.length - line.trimStart().length > openIndent
          return if isSameCloser(line.trim())
          // A slashless tag that is the last thing inside a parenthesised group or
          // an expression container stops parsing:
          //
          //   timerSlot={if cond then null else (
          //     <LiveGameTimer id=id>        <- parse error on the next line
          //   )}
          //
          // Whether it survives depends on how many groups close after it and on
          // what encloses them, so the guard is simply: a closer may not be the
          // next thing. A sibling tag, JSX text, an expression container, or the
          // enclosing element's own closing tag are all fine (each probed).
          nextTrimmed := line.trim()
          return if nextTrimmed.startsWith(")") or nextTrimmed.startsWith("}")
          break
        probe = stop
        break if nextEnd < 0

      // Drop the slash together with the horizontal whitespace in front of it:
      // leaving `<Foo a=1 >` re-emits with a doubled space. Stop at the line
      // start, so a `/>` that sits on its own line keeps its indentation.
      slashLineStart := source.lastIndexOf("\n", term.start) + 1
      var start = term.start
      while start > Math.max(openIdx, slashLineStart) and (source[start - 1] is " " or source[start - 1] is "\t")
        start--
      // Nothing but indentation in front of the slash: keep it, so a `/>` that
      // sits on its own line does not slide back to column 0.
      start = term.start if start is slashLineStart
      end := term.start + 1
      return if intersectsRange(ignoredRanges, start, end)
      seen.add(term.start)

      edit := { start, end, replacement: "" }
      edits.push(edit)
      ctx.report({
        ruleId: "style/prefer-bare-self-closing-jsx"
        message: `Self-closing '<${tag}>' does not need '/'`
        pos: start
        fix: edit
      })
}
