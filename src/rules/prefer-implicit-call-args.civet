import type { Rule, RuleContext } from "../types.civet"
import { intersectsRange } from "../utils.civet"

// Civet lets a call drop its parens when the argument list is unambiguous, which
// removes a closing paren from the end of the line:
//
//   expect(path).toBe('/a/Foo.civet')   ->  expect(path).toBe '/a/Foo.civet'
//   render(<Panel {rules} />)           ->  render <Panel {rules} />
//   g(x)                                ->  g x
//   a.b(x, y)                           ->  a.b x, y
//
// Emitted JS is byte-identical, so no OutputDelta is involved.
//
// Guards:
// 1. The call is the entire statement (only indentation, an assignment target, or
//    preceding implicit call names before it on the line; only whitespace/comment
//    after).
// 2. No top-level binary operator, `?`, or `:` appears between the parens.
// 3. The argument list is non-empty.
function hasTopLevelBinaryOpOrTernary(inner: string): boolean
  trimmed := inner.trim()
  if trimmed.startsWith("<") and (trimmed.endsWith("/>") or trimmed.endsWith(">"))
    return false

  var depthParen = 0
  var depthBrace = 0
  var depthBracket = 0
  var inString = false
  var quoteChar = ""
  var i = 0

  while i < inner.length
    ch := inner[i]
    if inString
      if ch is "\\"
        i += 2
        continue
      if ch is quoteChar
        inString = false
      i++
      continue
    if ch is '"' or ch is "'" or ch is "`"
      inString = true
      quoteChar = ch
      i++
      continue
    if ch is "("
      depthParen++
      i++
      continue
    if ch is ")"
      depthParen = Math.max(0, depthParen - 1)
      i++
      continue
    if ch is "{"
      depthBrace++
      i++
      continue
    if ch is "}"
      depthBrace = Math.max(0, depthBrace - 1)
      i++
      continue
    if ch is "["
      depthBracket++
      i++
      continue
    if ch is "]"
      depthBracket = Math.max(0, depthBracket - 1)
      i++
      continue

    if depthParen is 0 and depthBrace is 0 and depthBracket is 0
      return true if ch is "?" or ch is ":"
      return true if ch is "+" or ch is "*" or ch is "/" or ch is "%" or ch is "^" or ch is "="
      return true if ch is "&" or ch is "|" or ch is "<" or ch is ">"
      if /[a-zA-Z]/.test(ch)
        rest := inner.slice(i)
        return true if /^(?:is|isnt|and|or|in|instanceof)\b/.test(rest)
    i++
  false

// An assignment target may come first: `user := users.find (u) => u.id is id`.
// A bare `=` needs spaces, so a JSX attribute (`onChange=f('x')`) never matches.
LINE_PREFIX := /^[ \t]*(?:[A-Za-z_$][\w$.]*(?:\s*(?::=|\.=)\s*|\s+=\s+))?(?:(?!(?:if|for|while|unless|until|return|throw|yield|await|export|import|case|default|let|const|var)\b)[A-Za-z_$][\w$.]*\s+)*$/

export const preferImplicitCallArgsRule: Rule = {
  id: "style/prefer-implicit-call-args"
  meta: {
    description: "Drop call parens on trailing calls when the argument list is unambiguous"
    fixable: true
    defaultSeverity: "warn"
    phase: "idiom"
  }
  check: (ctx: RuleContext) ->
    source := ctx.source
    tree := ctx.syntax
    ignoredRanges := [...tree.commentRanges(), ...tree.stringRanges()]

    tree.visit "CallExpression", (node) ->
      children := node?.children
      return unless Array.isArray(children) and children.length >= 2

      last := children[children.length - 1]
      return unless last?.type is "Call"

      before := children[children.length - 2]
      var name: string | undefined = undefined

      if before?.type is "PropertyAccess" or before?.type is "Identifier"
        name = before.name
      else if before?
        name = tree.text(before).trim()

      return unless typeof name is "string" and name.length > 0

      // An empty argument list must keep its parens: `toBeNull()` is the call,
      // while `toBeNull` alone is a property read.
      return unless (last?.args?.length ?? 0) > 0

      callChildren := last?.children
      return unless Array.isArray(callChildren) and callChildren.length >= 4
      open := callChildren[0]
      close := callChildren[callChildren.length - 1]
      return unless open?.token is "(" and close?.token is ")"

      openSpan := tree.range(open)
      closeSpan := tree.range(close)
      return unless openSpan? and closeSpan?

      // Civet synthesizes these tokens for an already paren-free call, pointing at
      // whatever character sits at that offset, so confirm the source really has them.
      return unless source[openSpan.start] is "(" and source[closeSpan.start] is ")"

      // Guard the two edited positions only. Checking the whole span would reject
      // every call whose argument is a string literal, which is most of them.
      return if intersectsRange(ignoredRanges, openSpan.start, openSpan.end)
      return if intersectsRange(ignoredRanges, closeSpan.start, closeSpan.end)

      // Single-line only. A wrapped argument list already closes on its own line.
      return if source.slice(openSpan.start, closeSpan.end).includes("\n")

      // A JSX attribute value ends at the first space, so its call keeps its parens.
      return if tree.hasAncestorType(node, "JSXAttribute")

      // The call must be the entire statement.
      nodeSpan := tree.range(node)
      return unless nodeSpan?

      lineStart := source.lastIndexOf("\n", nodeSpan.start - 1) + 1
      linePrefix := source.slice(lineStart, nodeSpan.start)
      return unless LINE_PREFIX.test(linePrefix)

      lineEnd := source.indexOf("\n", closeSpan.start)
      trailing := source.slice(closeSpan.start + 1, lineEnd < 0 ? source.length : lineEnd)
      return unless /^[)\s]*(?:\/\/|#.*)?$/.test(trailing)
      // A deeper-indented next line continues the statement (`x = f(a)\n  or g()`),
      // and without its parens the call would take that line as its argument.
      if lineEnd >= 0
        nextLine := /\n([ \t]*)\S/.exec(source.slice(lineEnd))
        return if nextLine? and nextLine[1].length > /^[ \t]*/.exec(source.slice(lineStart))![0].length

      // An argument starting with an operator, a paren, or whitespace becomes
      // ambiguous once the call parens are gone (`f(-1)` -> `f -1` is a subtraction).
      // A JSX element is exempt: `<` only reads as "less than" when it follows a
      // value, and here it opens the argument.
      inner := source.slice(openSpan.end, closeSpan.start)
      return if inner.trim().length is 0

      // An arrow as the LAST argument owns the rest of the line either way, so its
      // parameter parens and its body are no ambiguity: `f((u) => u.id is id)` ->
      // `f (u) => u.id is id`. Only the arguments before it are checked.
      args := (last?.args ?? []).filter (a: any) -> a?.type is "Argument"
      lastArg := args[args.length - 1]
      arrowSpan := lastArg?.expression?.type is "ArrowFunction" ? tree.range(lastArg.expression) : undefined
      leading := arrowSpan? ? source.slice(openSpan.end, arrowSpan.start).replace(/,\s*$/, "") : inner

      isJsxArgument := /^<[A-Za-z]/.test(inner.trimStart())
      return if not isJsxArgument and not (arrowSpan? and leading.length is 0) and /^[\s(+\-*/%<>=!&|^~?:,]/.test(inner)

      // Guard 2: No top-level binary operator, `?`, or `:` appears between the parens.
      return if leading.length > 0 and hasTopLevelBinaryOpOrTernary(leading)

      ctx.report({
        ruleId: "style/prefer-implicit-call-args"
        message: `Drop the call parens on '${name}' and let the argument list close the line`
        pos: openSpan.start
        fix: {
          start: openSpan.start
          end: openSpan.end
          replacement: " "
        }
      })
      ctx.report({
        ruleId: "style/prefer-implicit-call-args"
        message: `Remove the closing paren for '${name}'`
        pos: closeSpan.start
        fix: {
          start: closeSpan.start
          end: closeSpan.end
          replacement: ""
        }
      })
}
