import type { Rule, RuleContext } from "../types.civet"
import { shouldSkipCommentStyleRewrite } from "./comment-style.civet"

export const preferSlashCommentsRule: Rule = {
  id: "style/prefer-slash-comments"
  meta: {
    description: "Prefer standard Civet '//' comments over CoffeeScript-style '#' comments"
    fixable: true
    defaultSeverity: "error"
    allowFixesInsideComments: true
    capabilities: {
      requires: ["coffeeComment"]
    }
    conflictsWith: ["style/prefer-hash-comments"]
  }
  check: (ctx: RuleContext) ->
    source := ctx.source
    tree := ctx.syntax

    tree.visit "Comment", (comment) ->
      commentRange := tree.range(comment)
      return unless commentRange?
      pos := commentRange.start
      slice := source.slice(pos, commentRange.end)

      // Only migrate single-line CoffeeScript comments. Preserve shebangs and
      // block/doc forms such as ### ... ###.
      return unless slice.startsWith("#")
      return if slice.startsWith("#!") or slice.startsWith("##")
      return if shouldSkipCommentStyleRewrite(comment, slice, tree)

      ctx.report({
        ruleId: "style/prefer-slash-comments"
        message: "Prefer standard Civet '//' comment over CoffeeScript-style '#' comment"
        pos
        fix: {
          start: pos
          end: pos + 1
          replacement: "//"
        }
      })
}
