import type { Rule, RuleContext } from "../types.civet"
import type { SyntaxTree } from "../syntax.civet"

const SHORTHAND_METHODS = new Set([
  "map", "filter", "find", "findIndex", "findLast", "findLastIndex"
  "some", "every", "flatMap", "forEach", "sort"
])

function soleParameterName(arrow: any): string | undefined
  paramsNode := arrow?.parameters ?? arrow?.signature?.parameters
  params := paramsNode?.parameters
  return undefined unless Array.isArray(params) and params.length is 1
  binding := params[0]?.binding
  return undefined unless binding?.type is "Identifier"
  return undefined unless typeof binding.name is "string"
  binding.name

function parameterPos(arrow: any, tree: SyntaxTree): number | undefined
  paramsNode := arrow?.parameters ?? arrow?.signature?.parameters
  binding := paramsNode?.parameters?[0]?.binding
  return undefined unless binding?
  span := tree.range(binding)
  span?.start

function soleBodyExpression(arrow: any): any
  block := arrow?.block
  return undefined unless block?.type is "BlockStatement" and block.bare
  exprs := block.expressions
  return undefined unless Array.isArray(exprs) and exprs.length is 1
  entry := exprs[0]
  return undefined unless Array.isArray(entry) and entry.length >= 2
  entry[1]

function referencesParam(node: any, paramName: string, tree: SyntaxTree): boolean
  var found = false
  tree.visit node, (n) ->
    found = true if n?.type is "Identifier" and n.name is paramName
  found

function propertyChain(expr: any, paramName: string, tree: SyntaxTree): string | undefined
  return undefined unless expr?.type is "MemberExpression"
  children := tree.children(expr)
  parts := children.filter (c: any) -> c?.type?

  root := parts[0]
  return undefined unless root?.type is "Identifier" and root.name is paramName
  return undefined unless parts.length > 1

  var chain = ""
  for part of parts.slice(1)
    return undefined unless part?.type is "PropertyAccess"
    return undefined if part.dot?.optional
    return undefined unless typeof part.name is "string"
    chain += `.${part.name}`
  chain

function accessChain(body: any, paramName: string, tree: SyntaxTree): string | undefined
  return propertyChain(body, paramName, tree) if body?.type is "MemberExpression"
  return undefined unless body?.type is "CallExpression"

  parts := tree.children(body).filter (c: any) -> c?.type?
  member := parts[0]
  call := parts[1]
  return undefined unless parts.length is 2 and call?.type is "Call"
  return undefined unless member?.type is "MemberExpression"

  chain := propertyChain member, paramName, tree
  return undefined unless chain?

  args := call.args ?? []
  for arg of args
    return undefined if referencesParam arg, paramName, tree

  span := tree.range(call)
  return undefined unless span?
  return undefined if span.end <= span.start

  callText := tree.text(span)
  return undefined unless callText.startsWith("(") and callText.endsWith(")")
  `${chain}${callText}`

export const preferAmpersandShorthandRule: Rule = {
  id: "style/prefer-ampersand-shorthand"
  meta: {
    description: "Prefer '&' block shorthand for single-parameter property access callbacks"
    fixable: false
    defaultSeverity: "warn"
  }
  check: (ctx: RuleContext) ->
    tree := ctx.syntax

    tree.visit "CallExpression", (node) ->
      children := tree.children(node)
      var pendingMethod: string | undefined = undefined

      for part of children
        if part?.type is "MemberExpression"
          for inner of tree.children(part)
            if inner?.type is "PropertyAccess" and typeof inner.name is "string"
              pendingMethod = inner.name
          continue

        if part?.type is "PropertyAccess" and typeof part.name is "string"
          pendingMethod = part.name
          continue

        continue unless part?.type is "Call"

        method := pendingMethod
        pendingMethod = undefined
        continue unless method? and SHORTHAND_METHODS.has(method)

        args := part.args
        continue unless Array.isArray(args) and args.length is 1
        arrow := args[0]?.expression
        continue unless arrow?.type is "ArrowFunction"

        paramName := soleParameterName arrow
        continue unless paramName?

        body := soleBodyExpression arrow
        continue unless body?

        chain := accessChain body, paramName, tree
        continue unless chain?

        pos := parameterPos arrow, tree
        continue unless pos?

        ctx.report({
          ruleId: "style/prefer-ampersand-shorthand"
          message: `Use '&' shorthand '.${method} &${chain}' instead of verbose callback`
          pos
        })
}
