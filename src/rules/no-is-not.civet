import type { Rule, RuleContext } from "../types.civet"
import { SyntaxTree } from "../syntax.civet"

export const noIsNotRule: Rule = {
  id: "style/no-is-not"
  meta: {
    description: "Flag 'is not' (prefer 'isnt')"
    fixable: false
    defaultSeverity: "warn"
    capabilities: {
      requiresAny: ["coffeeIsnt", "coffeeNot"]
    }
  }
  check: (ctx: RuleContext) ->
    source := ctx.source
    tree := new SyntaxTree(ctx.ast, source)
    reportedStarts := new Set<number>()

    tree.visit (node) ->
      span := tree.range(node)
      if span
        pos := span.start
        len := span.end - span.start
        slice := source.slice(pos, span.end)
        coffeeNotFootgun := ctx.parseOptions.coffeeNot and
          node.token is "===" and
          slice is "is" and
          /^\s+not\b/.test(source.slice(pos + len))

        if (slice is "is not" or coffeeNotFootgun) and not reportedStarts.has(pos)
          reportedStarts.add(pos)
          message := if ctx.parseOptions.coffeeIsnt
            "Prefer 'isnt' over 'is not'"
          else
            "Avoid 'is not': coffeeNot changes its meaning; enable coffeeIsnt and use 'isnt', or use '!=='"
          ctx.report({
            ruleId: "style/no-is-not"
            message
            pos
            severity: "warn"
          })
}
