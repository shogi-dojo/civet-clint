import type { Rule, RuleContext } from "../types.civet"
import { intersectsRange } from "../utils.civet"

const FN_NODE_TYPES = [
  "FunctionExpression"
  "FunctionDeclaration"
  "MethodDefinition"
  "ArrowFunction"
]

const LOOP_TYPES = [
  "ForStatement"
  "IterationStatement"
  "WhileStatement"
  "DoWhileStatement"
  "ForOfStatement"
  "ForInStatement"
]

export const preferImplicitReturnRule: Rule = {
  id: "style/prefer-implicit-return"
  meta: {
    description: "Prefer implicit return at the end of functions and methods over explicit 'return'"
    fixable: true
    defaultSeverity: "error"
    phase: "idiom"
  }
  check: (ctx: RuleContext) ->
    source := ctx.source
    tree := ctx.syntax
    ignoredRanges := [...tree.commentRanges(), ...tree.stringRanges()]
    seen := new Set<number>()

    // Every function span in the file, so a candidate `return` can be attributed to
    // the INNERMOST function that contains it. Without this, an outer function
    // matches a `return` that belongs to a nested arrow -- dropping it there
    // changes what the inner callback yields, which `act` and other
    // thenable-sensitive callees are sensitive to.
    fnSpans: { start: number, end: number }[] := []
    tree.visit FN_NODE_TYPES, (fn) ->
      span := tree.range(fn)
      fnSpans.push(span) if span?

    innermostFnSpan := (pos: number): { start: number, end: number } | undefined ->
      var best: { start: number, end: number } | undefined = undefined
      for span of fnSpans
        continue unless span.start <= pos and pos < span.end
        best = span if not best? or span.start > best.start or span.end < best.end
      best

    tree.visit FN_NODE_TYPES, (fnNode) ->
      if fnNode.generator
        isGen := Array.isArray(fnNode.generator) ? fnNode.generator.length > 0 : Boolean(fnNode.generator)
        return if isGen

      block := fnNode.block
      return unless block? and Array.isArray(block.expressions) and block.expressions.length > 0

      lastEntry := block.expressions[block.expressions.length - 1]
      var lastStmt: any = undefined
      if Array.isArray(lastEntry)
        lastStmt = lastEntry.find (e: any) -> e?.type is "ReturnStatement"
      else if lastEntry?.type is "ReturnStatement"
        lastStmt = lastEntry

      return unless lastStmt? and lastStmt.type is "ReturnStatement"
      return unless lastStmt.expression?

      exprType := lastStmt.expression.type
      return if exprType is "ObjectLiteral" or exprType is "ObjectExpression" or exprType is "BareObjectLiteral"

      return if tree.hasAncestorType(lastStmt, LOOP_TYPES)

      // The structural check above is not sufficient on its own: when a function's
      // final entry is a tuple, scanning it for a ReturnStatement can pick up a
      // `return` that belongs to a nested block rather than the function tail --
      //
      //   if tab.onClick
      //     return tab.onClick()     <- matched here, but NOT the last statement
      //   if isStaticMode
      //     ...
      //
      // Dropping that `return` changes control flow, so the equivalence gate
      // rejected it on every run (37 sites on a 441-file codebase). Require the
      // statement to also be textually last: nothing but whitespace and block
      // closers may follow it inside the function.
      stmtSpan := tree.range(lastStmt)
      fnSpan := tree.range(fnNode)
      return unless stmtSpan? and fnSpan?
      return unless /^[\s});]*$/.test(source.slice(stmtSpan.end, fnSpan.end))

      // The return must belong to THIS function, not to a nested one.
      inner := innermostFnSpan(stmtSpan.start)
      return unless inner? and inner.start is fnSpan.start and inner.end is fnSpan.end

      returnTok := tree.tokens(lastStmt).find (t) ->
        (t.raw.trim() is "return" or t.value.trim() is "return") and not t.synthetic
      return unless returnTok?

      pos := returnTok.range.start
      var after = returnTok.range.end
      while source[after] is " " or source[after] is "\t"
        after++

      // A bare `return` carries no value, and deleting it does not make the
      // function return the same thing -- it makes the function return whatever
      // the preceding statement evaluated to. The AST check above is not enough:
      // a valueless return still presents an `expression`, so this shape reached
      // the fix and was rejected by the gate on every run, taking the other
      // (valid) fixes in the same file down with it, since fixes are accepted or
      // rejected per rule per file.
      rest := source.slice(after)
      return if rest.length is 0
      return if /^[\r\n]/.test(rest)
      return if /^(?:\/\/|#)/.test(rest)

      return if seen.has(pos)
      return if intersectsRange(ignoredRanges, pos, after)
      seen.add(pos)

      ctx.report({
        ruleId: "style/prefer-implicit-return"
        message: "Drop explicit 'return' at end of function body"
        pos
        fix: {
          start: pos
          end: after
          replacement: ""
        }
      })
}
