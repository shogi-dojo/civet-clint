import type { Rule, RuleContext } from "../types.civet"
import { intersectsRange } from "../utils.civet"

// `const x = …` compiles identically to `x := …`, and `let x = …` compiles
// identically to `x .= …`. Both transforms need no OutputDelta: emitted JS is
// byte-identical and the strict equivalence gate accepts them unchanged.
export const preferWalrusDeclarationsRule: Rule = {
  id: "style/prefer-walrus-declarations"
  meta: {
    description: "Prefer Civet's ':=' and '.=' declaration operators over 'const' and 'let'"
    fixable: true
    defaultSeverity: "error"
    conflictsWith: ["style/prefer-explicit-declarations", "style/prefer-bare-assignment"]
  }
  check: (ctx: RuleContext) ->
    source := ctx.source
    tree := ctx.syntax
    commentRanges := tree.commentRanges()
    stringRanges := tree.stringRanges()
    ignoredRanges := [...commentRanges, ...stringRanges]

    // Two shapes: a bare identifier, or a destructuring pattern. The pattern
    // branch stops at the first newline so a multi-line pattern -- where the
    // closing brace position is not knowable by regex -- is left alone.
    identRe := /(?:^|[\n;])([ \t]*)(export[ \t]+)?(const|let)[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)[ \t]*(=)(?!=)/g
    patternRe := /(?:^|[\n;])([ \t]*)(export[ \t]+)?(const|let)[ \t]+([{\[][^}\]\n]*[}\]])[ \t]*(=)(?!=)/g

    report := (match: RegExpExecArray) ->
      exportKw := match[2] or ""
      declKw := match[3]
      target := match[4]
      op := declKw is "const" ? ":=" : ".="
      idxDecl := match[0].indexOf(declKw)
      pos := match.index + idxDecl - exportKw.length
      matchEnd := match.index + match[0].length
      return if intersectsRange(ignoredRanges, pos, matchEnd)

      replacement := `${exportKw}${target} ${op}`
      ctx.report({
        ruleId: "style/prefer-walrus-declarations"
        message: `Use '${exportKw}${target} ${op}' instead of '${exportKw}${declKw} ${target} ='`
        pos
        fix: {
          start: pos
          end: matchEnd
          replacement
        }
      })

    var match: RegExpExecArray | null = null
    while (match = identRe.exec(source)) !== null
      report(match)
    match = null
    while (match = patternRe.exec(source)) !== null
      report(match)
}
