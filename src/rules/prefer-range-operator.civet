import type { Rule, RuleContext } from "../types.civet"
import { collectCommentRanges, collectStringRanges, intersectsRange } from "../utils.civet"

export const preferRangeOperatorRule: Rule = {
  id: "style/prefer-range-operator"
  meta: {
    description: "Prefer '[0...N].map' range loops over 'Array.from({ length: N }, ...)'"
    fixable: false
    defaultSeverity: "error"
    capabilities: {
      requires: ["coffeeRange"]
    }
  }
  check: (ctx: RuleContext) ->
    source := ctx.source
    commentRanges := collectCommentRanges(ctx.ast)
    stringRanges := collectStringRanges(ctx.ast)
    ignoredRanges := [...commentRanges, ...stringRanges]

    re := /Array\.from\(\s*\{\s*length:\s*([a-zA-Z0-9_$]+)\s*\}\s*,\s*(?:\(\s*(?:_|[^,)]+)\s*,\s*([a-zA-Z_$][a-zA-Z0-9_$]*)\s*\)|([a-zA-Z_$][a-zA-Z0-9_$]*))\s*=>/g
    var match: RegExpExecArray | null = null

    while (match = re.exec(source)) !== null
      lenExpr := match[1]
      param := match[2] or match[3] or "i"

      pos := match.index
      matchEnd := match.index + match[0].length
      continue if intersectsRange(ignoredRanges, pos, matchEnd)

      ctx.report({
        ruleId: "style/prefer-range-operator"
        message: `Use range loop '[0...${lenExpr}].map' instead of 'Array.from({ length: ${lenExpr} }, ...)'`
        pos
      })
}
