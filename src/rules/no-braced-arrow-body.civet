import type { Fix, Rule, RuleContext } from "../types.civet"

// A JS-style `=> { ... }` arrow body is not a block in Civet: when every statement
// can be read as an object key, Civet parses the braces as an OBJECT LITERAL.
//
//   it 'x', => {          compiles to    it('x', () =>( {
//     expect(a).toBe(1)                    toBe: expect(a).toBe(1)
//   }                                    }))
//
// Side effects still run (the call is evaluated while the object is built), which is
// why such tests pass, but the arrow now returns an object instead of the last value.
// That breaks any consumer of the return value — a `useEffect` cleanup, a `.map`
// callback — and duplicate keys silently overwrite each other.
//
// The fix is the Civet-native form: drop the braces and let indentation delimit the
// body. This is a semantic REPAIR, not a style tweak, so it deliberately does NOT
// declare an output delta — the emitted JS is meant to change, and the engine's
// byte-identical gate would rightly reject it. It is reported as fixable only under
// an explicit opt-in so `--write` never rewrites semantics without being asked.

// Index of the `}` matching the `{` at openIdx, or -1. Skips braces inside strings,
// template literals and comments.
function findMatchingBrace(source: string, openIdx: number): number
  var depth = 0
  var i = openIdx
  while i < source.length
    ch := source[i]
    if ch is "/" and (source[i + 1] is "/" or source[i + 1] is "*")
      block := source[i + 1] is "*"
      end := block ? source.indexOf("*/", i + 2) : source.indexOf("\n", i + 2)
      i = end < 0 ? source.length : (block ? end + 2 : end)
      continue
    if ch is '"' or ch is "'" or ch is "`"
      quote := ch
      var j = i + 1
      while j < source.length
        if source[j] is "\\"
          j += 2
          continue
        break if source[j] is quote
        j++
      i = j + 1
      continue
    if ch is "{"
      depth++
    else if ch is "}"
      depth--
      return i if depth is 0
    i++
  -1

export const noBracedArrowBodyRule: Rule = {
  id: "style/no-braced-arrow-body"
  meta: {
    description: "Disallow JS-style '=> { ... }' arrow bodies that Civet parses as object literals"
    fixable: true
    defaultSeverity: "error"
    // Runs before every other rule: de-bracing is what makes the body's trailing
    // semicolons redundant, so style/no-trailing-semicolons (phase "cleanup") must
    // not judge the braced form.
    phase: "repair"
  }
  check: (ctx: RuleContext) ->
    source := ctx.source
    tree := ctx.syntax
    reported := new Set<number>()
    candidates: { pos: number, start: number, end: number, fix: Fix }[] := []

    tree.visit "ArrowFunction", (node) ->
      block := node.block
      return unless block?
      // Civet marks an implicitly-returned body, and wraps an object-literal body in
      // a ParenthesizedExpression. Both together identify the mis-parsed shape; a
      // real statement block has neither.
      return unless block.implicitlyReturned
      expressions := block.expressions
      return unless Array.isArray(expressions) and expressions.length > 0
      firstEntry := expressions[0]
      first := Array.isArray(firstEntry) ? firstEntry[1] : firstEntry
      return unless first?.type is "ParenthesizedExpression"

      span := tree.range(node)
      return unless span?

      // Distinguish the accidental `=> {` from a deliberate `=> ({ ... })` object
      // return, which is written with explicit parens and must be left alone.
      text := source.slice(span.start, span.end)
      arrowIdx := text.indexOf("=>")
      return if arrowIdx < 0
      after := text.slice(arrowIdx + 2)
      braceOffset := after.search(/\S/)
      return if braceOffset < 0
      return unless after[braceOffset] is "{"

      pos := span.start + arrowIdx
      return if reported.has(pos)
      reported.add(pos)

      // Build the fix: delete the `{` (and any space before it), then delete the
      // matching `}`. The body lines are already indented relative to the arrow, so
      // removing the braces leaves a valid indented body.
      //
      // The trailing semicolons inside the body are deliberately LEFT ALONE. Keeping
      // them preserves the original JS meaning exactly -- without them the last
      // statement becomes an implicit return, which for a useEffect body React would
      // treat as a cleanup callback. style/no-trailing-semicolons runs in the later
      // "cleanup" phase and removes whichever of them are then genuinely redundant.
      openIdx := span.start + arrowIdx + 2 + braceOffset
      closeIdx := findMatchingBrace(source, openIdx)
      return if closeIdx < 0

      var openFrom = openIdx
      while openFrom > 0 and (source[openFrom - 1] is " " or source[openFrom - 1] is "\t")
        openFrom--

      // Only unwrap when the closing brace sits on its own line; anything else is a
      // one-liner whose reflow is not a safe mechanical edit.
      lineStart := source.lastIndexOf("\n", closeIdx) + 1
      return unless source.slice(lineStart, closeIdx).trim() is ""

      // Keep the body verbatim, including its final newline and the closing line's
      // indentation, so whatever followed the `}` (usually the enclosing call's
      // `)`) stays on its own line.
      // Keep the body verbatim but drop the closing line's indentation: it belonged
      // to the `}` that is going away, and leaving it behind strands trailing
      // whitespace on a blank line.
      body := source.slice(openIdx + 1, lineStart)
      fix: Fix := {
        start: openFrom
        end: closeIdx + 1
        replacement: body.replace(/\n$/, "")
      }

      candidates.push({ pos, start: openFrom, end: closeIdx + 1, fix })

    // Nested bodies produce overlapping edits: the outer arrow's span contains the
    // inner one, and applyEdits keeps only the outermost of an overlapping pair, so
    // offering both would silently drop the inner fix and leave the file
    // half-repaired -- which the equivalence gate then rejects wholesale.
    //
    // Only the outermost body carries a fix in any one pass. lintPhased re-runs each
    // phase to a fixed point, so re-parsing the de-braced text exposes the next layer
    // and nesting is peeled one level at a time. Inner bodies are still REPORTED, so
    // a check-only run lists every occurrence.
    candidates.sort (a, b) -> a.start - b.start
    var lastEnd = -1
    for candidate of candidates
      nested := candidate.start < lastEnd
      lastEnd = candidate.end if not nested
      ctx.report({
        ruleId: "style/no-braced-arrow-body"
        message: "'=> { ... }' is parsed as an object literal — drop the braces and indent the body"
        pos: candidate.pos
        fix: nested ? undefined : candidate.fix
      })
}
