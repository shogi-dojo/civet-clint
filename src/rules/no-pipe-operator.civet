import type { Rule, RuleContext } from "../types.civet"
import { intersectsRange } from "../utils.civet"

export const noPipeOperatorRule: Rule = {
  id: "style/no-pipe-operator"
  meta: {
    description: "Disallow pipe operator (|>); keep ordinary method chains instead"
    fixable: false
    defaultSeverity: "error"
  }
  check: (ctx: RuleContext) ->
    source := ctx.source
    tree := ctx.syntax
    commentRanges := tree.commentRanges()
    stringRanges := tree.stringRanges()
    ignoredRanges := [...commentRanges, ...stringRanges]

    var i = 0
    while i < source.length - 1
      if source[i] is "|" and source[i + 1] is ">"
        pos := i
        if not intersectsRange(ignoredRanges, pos, pos + 2)
          ctx.report({
            ruleId: "style/no-pipe-operator"
            message: "Disallowed pipe operator '|>'; use regular method calls or function applications instead"
            pos
          })
        i += 2
      else
        i += 1
}
