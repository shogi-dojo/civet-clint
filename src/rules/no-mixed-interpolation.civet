import type { Rule, RuleContext } from "../types.civet"

export const noMixedInterpolationRule: Rule = {
  id: "style/no-mixed-interpolation"
  meta: {
    description: 'Flag mixed string interpolation styles (#{...} vs ${...})'
    fixable: false
    defaultSeverity: "warn"
  }
  check: (ctx: RuleContext) ->
    source := ctx.source
    tree := ctx.syntax
    findings: { pos: number, message: string }[] := []
    reported := new Set<number>()

    tree.visit "StringLiteral", (node) ->
      span := tree.range(node)
      if span and node.token
        pos := span.start
        raw := source.slice(pos, span.end)
        if raw.startsWith('"') and /(^|[^\\])\$\{[^}]+\}/.test(raw) and not reported.has(pos)
          reported.add(pos)
          findings.push({
            pos
            message: '${...} does not interpolate inside double-quoted strings; use a backtick template'
          })

    tree.visit "TemplateLiteral", (node) ->
      tickPositions: number[] := []
      tree.visit node, (part) ->
        span := tree.range(part)
        if span
          actual := source.slice(span.start, span.end)
          tickPositions.push(span.start) if actual is "`"

      if tickPositions.length >= 2
        minPos := Math.min(...tickPositions)
        maxPos := Math.max(...tickPositions) + 1
        raw := source.slice(minPos, maxPos)
        if raw.startsWith("`") and /(^|[^\\])#\{/.test(raw) and not reported.has(minPos)
          reported.add(minPos)
          findings.push({
            pos: minPos
            message: '#{...} does not interpolate inside backtick templates; use ${...}'
          })

    for item of findings
      ctx.report({
        ruleId: "style/no-mixed-interpolation"
        message: item.message
        pos: item.pos
        severity: "warn"
      })
}
