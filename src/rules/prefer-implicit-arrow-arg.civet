import type { Fix, Rule, RuleContext } from "../types.civet"
import { applyEdits, intersectsRange, walkAst } from "../utils.civet"
import { bareArrowCallee, zeroArgCalleeMatcher } from "./no-single-param-arrow-without-parens.civet"

// A call whose only argument is a zero-parameter arrow can drop its parens:
//
//   decode = vi.fn(=> Promise.resolve())   ->  decode = vi.fn => Promise.resolve()
//
// Emitted JS is byte-identical. This is a general Civet idiom -- it is not specific
// to test files -- so the rule matches any callee.
//
// An implicit call whose argument is a parenthesised arrow reads the same way:
//
//   m = createMemo (=> a())                ->  m = createMemo => a()
//
// That one is not byte-identical. Civet emits `createMemo((() => a()))` for the
// parenthesised form and `createMemo(() => a())` for the terse one, so the rule
// declares the `arrow-paren-style` delta, which licenses exactly that doubled pair.
// The delta is declared only when such a site is fixed; every other fix keeps the
// byte-exact gate.
//
// The one shape that must NOT be rewritten is an object property whose entry is
// followed by more properties. Without the parens the arrow swallows them as extra
// arguments, which compiles silently to the wrong thing:
//
//   { play: vi.fn(=> p()), x: 1 }   ->   { play: vi.fn(() => p(), {x: 1}) }
//
// That is corruption rather than a parse error, so the trailing-context guard below
// is load-bearing. The same guard keeps `g (=> a()), 5` as it is: it compiles to the
// same program, but `g => a(), 5` reads as if the comma belonged to the arrow.
//
// Finally the rule defers to style/no-single-param-arrow-without-parens. When that
// rule is active, `callee => body` is only written for a callee it exempts, so a fix
// never trades one finding for another.
export const preferImplicitArrowArgRule: Rule = {
  id: "style/prefer-implicit-arrow-arg"
  meta: {
    description: "Drop call parens when the sole argument is a zero-parameter arrow (vi.fn => x)"
    fixable: true
    defaultSeverity: "warn"
    phase: "idiom"
  }
  check: (ctx: RuleContext) ->
    source := ctx.source
    tree := ctx.syntax
    commentRanges := tree.commentRanges()
    ignoredRanges := [...commentRanges, ...tree.stringRanges()]

    // Present only while style/no-single-param-arrow-without-parens is active.
    peerOptions := ctx.activeRuleOptions?("style/no-single-param-arrow-without-parens")
    isZeroArgCallee := zeroArgCalleeMatcher(peerOptions?.extraZeroArgCallees)
    wouldBeFlagged := (before: string): boolean ->
      return false unless peerOptions?
      callee := bareArrowCallee(before)
      callee? and not isZeroArgCallee(callee)

    fixes: Fix[] := []
    var declared = false
    // Declared on the first parenthesised site only, so a file with just `f(=> x)`
    // sites is still judged byte-for-byte. The reference applies every fix this rule
    // proposes; the delta then bounds how its output may differ from the original.
    declareParenDelta := ->
      return if declared
      declared = true
      ctx.declareEquivalenceReference?("arrow-paren-style", (input: string) ->
        return undefined if fixes.length is 0
        applyEdits(input, fixes).output
      )

    report := (pos: number, message: string, fix: Fix) ->
      fixes.push(fix)
      ctx.report({ ruleId: "style/prefer-implicit-arrow-arg", message, pos, fix })

    // Nothing may follow the closer on its line. A trailing comma is the dangerous
    // case (the arrow would absorb the next object property), and a `.chain` or an
    // operator means the parens are load-bearing.
    restOfLine := (from: number): string ->
      lineEnd := source.indexOf("\n", from)
      source.slice(from, lineEnd < 0 ? source.length : lineEnd)

    tree.visit "CallExpression", (node) ->
      children := node?.children
      return unless Array.isArray(children) and children.length >= 2

      last := children[children.length - 1]
      return unless last?.type is "Call"

      args := last?.args
      return unless Array.isArray(args) and args.length is 1

      callChildren := last?.children
      return unless Array.isArray(callChildren) and callChildren.length >= 4
      open := callChildren[0]
      close := callChildren[callChildren.length - 1]
      return unless open?.token is "(" and close?.token is ")"

      openSpan := tree.range(open)
      closeSpan := tree.range(close)
      return unless openSpan? and closeSpan?

      // Civet synthesizes these tokens for an already paren-free call, pointing at
      // whatever character sits at that offset, so confirm the source really has them.
      explicit := openSpan.end > openSpan.start and source[openSpan.start] is "(" and source[closeSpan.start] is ")"

      if explicit
        // The single argument must be an arrow. A parameterised arrow (`f((a) => a)`)
        // is rejected below by the `=>` check on the text right after the paren.
        var hasArrow = false
        walkAst args[0], (child) ->
          hasArrow = true if child?.type is "ArrowFunction"
        return unless hasArrow

        return if intersectsRange(ignoredRanges, openSpan.start, openSpan.end)
        return if intersectsRange(ignoredRanges, closeSpan.start, closeSpan.end)

        // The arrow must start immediately: `vi.fn(=> …)`, not `vi.fn((a) => …)`.
        return unless source.slice(openSpan.end).trimStart().startsWith("=>")

        // Single-line only. When the argument list wraps, the closing paren sits on
        // its own line and dropping it shifts the emitted formatting, which the
        // byte-exact gate rejects. Compare line numbers rather than scanning the span:
        // the reported closer position can land past an intervening newline.
        return unless ctx.getLineColumn(openSpan.start).line is ctx.getLineColumn(closeSpan.start).line

        return unless /^[)\s]*$/.test(restOfLine(closeSpan.start + 1))
        return if wouldBeFlagged(source.slice(0, openSpan.start))

        report(openSpan.start, "Drop the call parens: the sole argument is a zero-parameter arrow", {
          start: openSpan.start
          end: openSpan.end
          replacement: " "
        })
        report(closeSpan.start, "Remove the closing paren for the implicit arrow argument", {
          start: closeSpan.start
          end: closeSpan.end
          replacement: ""
        })
        return

      // Implicit call, parenthesised arrow: `callee (=> body)`.
      argument := args[0]
      return unless argument?.type is "Argument"
      group := argument.expression
      return unless group?.type is "ParenthesizedExpression" and group.expression?.type is "ArrowFunction"

      groupChildren := group.children
      return unless Array.isArray(groupChildren) and groupChildren.length >= 3
      groupOpen := tree.tokenRange(groupChildren[0])
      groupClose := tree.tokenRange(groupChildren[groupChildren.length - 1])
      return unless groupOpen? and groupClose?
      return unless source[groupOpen.start] is "(" and source[groupClose.start] is ")"
      return if intersectsRange(ignoredRanges, groupOpen.start, groupOpen.end)
      return if intersectsRange(ignoredRanges, groupClose.start, groupClose.end)

      // Zero parameters only: the paren must be followed directly by `=>`.
      return unless source.slice(groupOpen.end).trimStart().startsWith("=>")
      return unless ctx.getLineColumn(groupOpen.start).line is ctx.getLineColumn(groupClose.start).line

      // Closes the line: only whitespace, or a trailing comment, may follow.
      trailing := restOfLine(groupClose.end)
      unless trailing.trim().length is 0
        commentAt := groupClose.end + trailing.length - trailing.trimStart().length
        return unless commentRanges.some (range) -> range.start is commentAt

      // The callee must be separated from the paren by spaces on its own line
      // (`f (=>`): a paren with no gap was an explicit call, handled above, and one on
      // the next line would leave a line that starts with `=>`.
      beforeGroup := source.slice(0, groupOpen.start)
      gap := beforeGroup.slice(beforeGroup.trimEnd().length)
      return unless gap.length > 0 and not gap.includes("\n")
      return if wouldBeFlagged(source.slice(0, groupOpen.start))

      declareParenDelta()
      report(groupOpen.start, "Drop the parens around the sole arrow argument", {
        start: groupOpen.start
        end: groupOpen.end
        replacement: ""
      })
      report(groupClose.start, "Remove the closing paren for the implicit arrow argument", {
        start: groupClose.start
        end: groupClose.end
        replacement: ""
      })
}
