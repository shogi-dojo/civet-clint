import type { Rule, RuleContext } from "../types.civet"
import { intersectsRange } from "../utils.civet"

// Civet delimits an object literal by indentation, so the braces on a multi-line
// object are redundant:
//
//   o := {          becomes    o :=
//     a: 1                       a: 1
//     b: 2                       b: 2
//   }
//
// The compiler emits the same object either way — only trailing commas differ, which
// the trailing-comma-style delta already licenses — so the engine can verify this.
//
// Deliberately narrow. Two shapes are excluded because their emitted output really
// does change:
//   * `[{ ... }]` — an array holding an object restructures into a different literal.
//   * `=> ({ ... })` — an arrow returning an object; the parens are load-bearing, and
//     removing them re-creates the mis-parse that style/no-braced-arrow-body detects.
export const preferIndentedObjectRule: Rule = {
  id: "style/prefer-indented-object"
  meta: {
    description: "Prefer indentation over braces for multi-line object literals"
    fixable: true
    defaultSeverity: "error"
  }
  check: (ctx: RuleContext) ->
    source := ctx.source
    tree := ctx.syntax
    ignoredRanges := [...tree.commentRanges(), ...tree.stringRanges()]
    lines := source.split("\n")

    edits: { start: number, end: number, replacement: string }[] := []
    ctx.declareEquivalenceReference?.("trailing-comma-style", (input: string) ->
      return undefined unless edits.length > 0
      var out = input
      for edit of [...edits].sort((a, b) -> b.start - a.start)
        out = out.slice(0, edit.start) + edit.replacement + out.slice(edit.end)
      out
    )

    lineStarts: number[] := []
    var acc = 0
    for line of lines
      lineStarts.push(acc)
      acc += line.length + 1

    indentOf := (line: string): number -> line.length - line.trimStart().length

    for let i = 0; i < lines.length; i++
      line := lines[i]
      trimmedEnd := line.trimEnd()
      continue unless trimmedEnd.endsWith("{")

      // Only a binding's own object literal — `x = {` or `x := {`. A braced object
      // passed straight to a call (`f({`) is excluded: dropping the brace leaves the
      // closing paren on its own line, which the compiler emits differently. `[{`
      // restructures, and `=> ({` is a deliberate arrow object return whose parens
      // are load-bearing.
      continue if /\[\s*\{$/.test(trimmedEnd)
      continue if /=>\s*\(\s*\{$/.test(trimmedEnd)
      continue if /\(\s*\{$/.test(trimmedEnd)
      // A JSX attribute container (`editor={`) is not an object literal: the braces
      // delimit an embedded expression, and dropping them emits invalid JSX. It is
      // told apart from a binding by the absence of whitespace around `=` — Civet
      // requires `x = {` / `x := {`, while JSX forbids spaces in `name={`.
      continue if /(?:^|[\s(])[A-Za-z_$][\w$.-]*=\{$/.test(trimmedEnd)
      continue unless /(?::=\s*|(?<![=!<>])=\s+)\{$/.test(trimmedEnd)

      openIdx := lineStarts[i] + trimmedEnd.length - 1
      continue if intersectsRange(ignoredRanges, openIdx, openIdx + 1)

      openIndent := indentOf(line)

      // Find the matching close: the first later line whose sole content is `}`
      // (optionally followed by `)` / `,`) at the opening line's indentation.
      var closeLine = -1
      for let j = i + 1; j < lines.length; j++
        candidate := lines[j]
        trimmed := candidate.trim()
        continue if trimmed.length is 0
        if indentOf(candidate) <= openIndent
          closeLine = j if /^\}[\),]*$/.test(trimmed)
          break
      continue if closeLine < 0

      // Every line between must be more indented, or the braces are load-bearing.
      var bodyOk = false
      for let j = i + 1; j < closeLine; j++
        inner := lines[j]
        continue if inner.trim().length is 0
        if indentOf(inner) <= openIndent
          bodyOk = false
          break
        bodyOk = true
      continue unless bodyOk

      // An object holding a shorthand property cannot lose its braces: de-braced,
      // `winnerPlayerId` on its own line is an identifier expression, not a
      // property, so the file stops parsing. The braces are load-bearing.
      var hasShorthand = false
      for let j = i + 1; j < closeLine; j++
        inner := lines[j].trim()
        continue if inner.length is 0
        continue if inner.startsWith("//") or inner.startsWith("#")
        continue if indentOf(lines[j]) > openIndent + 2 and not /^[\w$]+,?$/.test(inner)
        if /^[A-Za-z_$][\w$]*,?$/.test(inner) or /^\.\.\.[\w$]+,?$/.test(inner)
          hasShorthand = true
          break
      continue if hasShorthand

      closeTrimmed := lines[closeLine].trim()
      closeStart := lineStarts[closeLine] + indentOf(lines[closeLine])
      // Keep whatever follows the brace, e.g. the `)` of an enclosing call.
      closeRest := closeTrimmed.slice(1)

      openStart := openIdx
      var openFrom = openStart
      while openFrom > lineStarts[i] and (source[openFrom - 1] is " " or source[openFrom - 1] is "\t")
        openFrom--

      openEdit := { start: openFrom, end: openStart + 1, replacement: "" }
      closeEdit := if closeRest.length > 0
        { start: closeStart, end: closeStart + closeTrimmed.length, replacement: closeRest }
      else
        // Drop the whole line, including its newline, when only `}` remains.
        { start: lineStarts[closeLine], end: lineStarts[closeLine] + lines[closeLine].length + 1, replacement: "" }

      edits.push(openEdit)
      edits.push(closeEdit)

      ctx.report({
        ruleId: "style/prefer-indented-object"
        message: "Prefer indentation over braces for a multi-line object literal"
        pos: openStart
        fix: openEdit
      })
      ctx.report({
        ruleId: "style/prefer-indented-object"
        message: "Prefer indentation over braces for a multi-line object literal"
        pos: closeStart
        fix: closeEdit
      })
}
