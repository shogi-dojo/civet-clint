import type { CivetCompiler, Fix, Rule, RuleContext } from "../types.civet"
import { applyEdits, intersectsRange } from "../utils.civet"
import { compileForOutput } from "../compiler.civet"

type Candidate = { pos: number, fix: Fix }

const MAX_VERIFY_COMPILES = 24

// Line-ending commas are valid in source migrations but redundant in Civet lists.
// Check the entire candidate group first (one compile in the usual case), and
// bisect only if removing a comma changes the parsed program.
function safeLineEndingCommas(
  source: string,
  baselineOutput: string | undefined,
  dial: Record<string, any>,
  compiler: CivetCompiler | undefined,
  candidates: Candidate[]
): Candidate[]
  return [] if candidates.length is 0
  baseline := if baselineOutput?
    baselineOutput
  else
    base := compileForOutput(source, { dial, compiler })
    return [] unless base.ok
    base.output!

  // Bounded: past the budget a group is left unreported instead of being split
  // further, so a file with many load-bearing commas cannot cost a compile each.
  var compilesLeft = MAX_VERIFY_COMPILES
  verified := new Map<string, boolean>()
  isSafe := (subset: Candidate[]): boolean ->
    key := subset.map((item) -> item.pos).join(",")
    cached := verified.get(key)
    return cached if cached?
    return false if compilesLeft-- <= 0
    { output: candidate } := applyEdits(source, subset.map((item) -> item.fix))
    return false if candidate is source
    res := compileForOutput(candidate, { dial, compiler })
    safe := res.ok and res.output is baseline
    verified.set(key, safe)
    safe

  findSafe := (subset: Candidate[]): Candidate[] ->
    return [] if subset.length is 0
    return subset if isSafe(subset)
    return [] if subset.length is 1
    mid := Math.floor(subset.length / 2)
    [...findSafe(subset.slice(0, mid)), ...findSafe(subset.slice(mid))]

  // Groups that are safe alone can still interact; shrink until the union holds.
  var accepted = findSafe(candidates)
  compilesLeft = MAX_VERIFY_COMPILES
  while accepted.length > 0 and not isSafe(accepted)
    accepted = accepted.slice(0, Math.floor(accepted.length / 2))
  accepted

// A comma directly before a closing bracket, brace or paren separates nothing, so
// Civet does not need it -- a newline already delimits the entries:
//
//   o :=            f(          items := [
//     a: 1            a           1
//     b: 2            b           2
//                   )           ]
//
// Applies to object literals, arrays, argument lists, destructuring patterns and
// import clauses alike.
//
// Two constructs are never touched, because there the comma is load-bearing:
//   * regex literals -- `{5,}` ends in a comma before `}`, and removing it changes
//     "five or more" to "exactly five". Guarded by collectStringRanges.
//   * array elision -- `[1, 2,,]` has length 3, and `[a, , b]` skips a slot, so a
//     comma adjacent to another comma is left alone.
//   * a comma after a rest element (`(a, ...rest,)`) is a syntax error to re-add.
//
// Removing the comma is emitted verbatim by the compiler, so the rule declares a
// trailing-comma-style delta and the engine independently confirms that dropping the
// comma is the only difference in the emitted output.
export const noTrailingCommasRule: Rule = {
  id: "style/no-trailing-commas"
  meta: {
    description: "Disallow a trailing comma before a closing bracket, brace, or paren"
    fixable: true
    defaultSeverity: "error"
    defaultOptions: {
      // Also drop a comma that ends a line between list entries (`a: 1,` + newline
      // + `b: 2`). Off by default: it is a style choice rather than a redundancy
      // before a closer, it reports thousands of sites on a comma-separated
      // codebase, and each file costs a verification compile.
      lineEndings: false
    }
  }
  check: (ctx: RuleContext) ->
    source := ctx.source
    tree := ctx.syntax
    ignoredRanges := [...tree.commentRanges(), ...tree.stringRanges()]

    edits: { start: number, end: number, replacement: string }[] := []
    lineEndingCandidates: Candidate[] := []
    ctx.declareEquivalenceReference?.("trailing-comma-style", (input: string) ->
      return undefined unless edits.length > 0
      var out = input
      for edit of [...edits].sort((a, b) -> b.start - a.start)
        out = out.slice(0, edit.start) + edit.replacement + out.slice(edit.end)
      out
    )

    for let i = 0; i < source.length; i++
      continue unless source[i] is ","
      continue if intersectsRange(ignoredRanges, i, i + 1)

      // Only a comma whose next non-whitespace character closes the literal.
      var k = i + 1
      while k < source.length and /\s/.test(source[k])
        k++
      continue unless k < source.length and ")]}".includes(source[k])

      // Elision guard: `[1, 2,,]` and `[a, , b]` rely on the extra comma to hold a
      // slot, so a comma adjacent to another comma is never removed.
      var p = i - 1
      while p >= 0 and /\s/.test(source[p])
        p--
      continue if p >= 0 and source[p] is ","

      // Leave `(a, b,)`-style parameter lists that end in a rest element alone —
      // the comma after `...rest` is a syntax error to re-add, so never touch it.
      continue if /\.\.\.[A-Za-z0-9_$]*\s*$/.test(source.slice(Math.max(0, i - 40), i))

      edits.push({ start: i, end: i + 1, replacement: "" })
      ctx.report({
        ruleId: "style/no-trailing-commas"
        message: "Unnecessary trailing comma"
        pos: i
        fix: { start: i, end: i + 1, replacement: "" }
      })

    // Civet accepts newlines as separators in object, array, argument, parameter,
    // and import lists. A comma at the end of a line inside one of those lists
    // compiles the same without it. Collect every such comma, then let the compiler
    // reject ambiguous cases such as a comma operator or a multi-declaration head.
    for let i = 0; i < source.length; i++
      break unless ctx.options.lineEndings is true
      continue unless source[i] is ","
      continue if intersectsRange(ignoredRanges, i, i + 1)
      var k = i + 1
      while k < source.length and (source[k] is " " or source[k] is "\t")
        k++
      if source[k] is "\r"
        k++
      continue unless source[k] is "\n"
      k++
      while k < source.length and /\s/.test(source[k])
        k++
      continue if k >= source.length or source[k] is ")" or source[k] is "]" or source[k] is "}"

      var p = i - 1
      while p >= 0 and /\s/.test(source[p])
        p--
      continue if p >= 0 and source[p] is ","
      lineEndingCandidates.push({ pos: i, fix: { start: i, end: i + 1, replacement: "" } })

    safeLineEnds := safeLineEndingCommas(source, ctx.baselineOutput, ctx.parseOptions, ctx.compiler, lineEndingCandidates)
    for item of safeLineEnds
      edits.push(item.fix)
      ctx.report({
        ruleId: "style/no-trailing-commas"
        message: "Unnecessary comma at the end of a line"
        pos: item.pos
        fix: item.fix
      })
}
