import type { Rule, RuleContext } from "../types.civet"
import { shouldSkipCommentStyleRewrite } from "./comment-style.civet"

export const preferHashCommentsRule: Rule = {
  id: "style/prefer-hash-comments"
  meta: {
    description: "Prefer CoffeeScript-style '#' comments over '//' comments"
    fixable: true
    defaultSeverity: "error"
    allowFixesInsideComments: true
    capabilities: {
      requires: ["coffeeComment"]
    }
  }
  check: (ctx: RuleContext) ->
    source := ctx.source
    tree := ctx.syntax

    tree.visit "Comment", (comment) ->
      commentRange := tree.range(comment)
      return unless commentRange?
      pos := commentRange.start
      slice := source.slice(pos, commentRange.end)

      return unless slice.startsWith("//")
      return if slice.startsWith("///")
      return if shouldSkipCommentStyleRewrite(comment, slice, tree)

      ctx.report({
        ruleId: "style/prefer-hash-comments"
        message: "Prefer CoffeeScript-style '#' comment over '//' comment"
        pos
        fix: {
          start: pos
          end: pos + 2
          replacement: "#"
        }
      })
}
