import civet from "@danielx/civet"
import type { CompileDial, CompileOptions } from "./types.civet"

// Compiler/config adapter.
//
// Civet's `compile` accepts a top-level `CompileOptions` object whose `parseOptions`
// field carries the "dial" (Coffee/React/TS parsing flags). Clint consumes both
// layers: the dial drives raw-AST shape and rule applicability, while the remaining
// top-level options select the emitted-output pipeline (e.g. `js`). This adapter is
// the single place that constructs the `compile` argument, so the baseline and
// candidate compiles in the engine always run under identical options. A future
// stable Civet token/source-range API will still require a node-access adapter for
// rules and traversal utilities.
//
// Supported configuration boundary (Civet 0.11.15):
//   - dial keys: coffeeIsnt, coffeeEq, coffeeBooleans, coffeeNot, coffeeComment,
//     coffeeInterpolation, coffeeDo, coffeeLineContinuation, coffeePrototype,
//     coffeeRange, react, ts, autoLet, rewriteCivetImports, ...
//   - top-level: js, sourceMap, inlineMap, trace, ...
// Civet reserves the right to change any of these; Clint never interprets dial values
// beyond the truthiness checks declared in `RuleCapability.requires`.

// These options control Clint's execution mode or error handling and must not be
// overridden by project configuration. In particular, accepting `sync: false` would
// make a pending Promise look like a successful AST/output result, while accepting
// `ast` would make the equivalence path compare AST object identities instead of code.
const CONTROLLED_OPTIONS = new Set([
  "sync"
  "ast"
  "filename"
  "parseOptions"
  "errors"
])

export function pipelineOptions(options?: CompileOptions): CompileOptions
  retained: CompileOptions := {}
  for [key, value] of Object.entries(options or {})
    retained[key] = value unless CONTROLLED_OPTIONS.has(key)
  retained

// Keys present in project configuration that Clint refuses to forward to the
// compiler. Reported by `--print-config` so the resolved output never claims an
// option is active when the adapter strips it.
export function controlledOptionKeys(options?: CompileOptions): string[]
  Object.keys(options or {}).filter (key) -> CONTROLLED_OPTIONS.has(key)

export interface CompileDialOptions
  // The compiler dial (parseOptions).
  dial: CompileDial
  // Retained top-level CompileOptions outside parseOptions (e.g. js, trace).
  compileOptions?: CompileOptions
  filename?: string

export interface RawAstOptions extends CompileDialOptions
  // no extra fields; raw-AST parsing forces ast: "raw"

export interface CompileResult
  ok: boolean
  output?: string
  ast?: any
  error?: string
  line?: number
  column?: number
  offset?: number

// Parse a raw AST from source under the given dial. The `ast: "raw"` shape is Civet's
// intentionally unstable internal representation. This adapter isolates the compiler
// invocation; rules and traversal utilities still depend on raw node fields until
// Civet exposes a stable source-span/token API.
export function parseRawAst(source: string, options: RawAstOptions): CompileResult
  try
    retained := pipelineOptions(options.compileOptions)
    ast := civet.compile(source, {
      ...retained
      sync: true
      ast: "raw"
      filename: options.filename
      parseOptions: options.dial
    }) as any
    { ok: true, ast }
  catch err: any
    {
      ok: false
      error: err.message or String(err)
      line: err.line
      column: err.column
      offset: err.offset
    }

// Compile source to emitted output under the given dial. Used for the baseline and
// candidate equivalence checks. Both calls receive an identical options object built
// here, preserving the core invariant that an autofix is accepted only when baseline
// and candidate output are equivalent under the same compiler configuration.
export function compileForOutput(source: string, options: CompileDialOptions): CompileResult
  try
    retained := pipelineOptions(options.compileOptions)
    compiled := civet.compile(source, {
      ...retained
      sync: true
      ast: false
      filename: options.filename
      parseOptions: options.dial
    }) as any
    // `sourceMap: true` returns `{ code, sourceMap }`. Equivalence is about the
    // emitted program; the map is regenerated from the rewritten source and is
    // expected to contain different source locations/content.
    output := if typeof compiled is "string" then compiled else compiled?.code
    unless typeof output is "string"
      throw new Error("Civet compiler returned a non-text output")
    { ok: true, output }
  catch err: any
    {
      ok: false
      error: err.message or String(err)
      line: err.line
      column: err.column
      offset: err.offset
    }
