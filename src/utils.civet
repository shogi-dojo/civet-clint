import fs from "node:fs/promises"
import path from "node:path"
import type { Fix } from "./types.civet"

export function createLineColumnIndex(source: string)
  lineStarts: number[] := [0]
  for let i = 0; i < source.length; i++
    if source[i] is "\n"
      lineStarts.push(i + 1)

  (pos: number) ->
    if pos < 0
      return { line: 1, column: 1 }
    var low = 0
    var high = lineStarts.length - 1
    while low <= high
      mid := Math.floor((low + high) / 2)
      if lineStarts[mid] <= pos
        low = mid + 1
      else
        high = mid - 1
    lineIndex := high
    line := lineIndex + 1
    column := pos - lineStarts[lineIndex] + 1
    { line, column }

export function walkAst(ast: any, visitor: (node: any, parent: any) => void)
  visited := new Set<any>()

  traverse := (node: any, parent: any) ->
    return unless node? and typeof node is "object"
    return if visited.has(node)
    visited.add(node)

    visitor(node, parent)

    if Array.isArray(node)
      for child of node
        traverse(child, parent)
    else
      for key of Object.keys(node)
        continue if key is "parent"
        traverse(node[key], node)

  traverse(ast, null)

export function collectCommentRanges(ast: any): { start: number, end: number }[]
  ranges: { start: number, end: number }[] := []
  walkAst ast, (node) ->
    return unless node?.type is "Comment" and node.$loc
    ranges.push({ start: node.$loc.pos, end: node.$loc.pos + node.$loc.length })
  ranges.sort (a, b) -> a.start - b.start

// Source span of a node. String and template nodes often carry no `$loc` of their
// own — a `TemplateLiteral` holding CSS has its extent only in descendant tokens —
// so fall back to the min/max `$loc` across the subtree.
function nodeSpan(node: any): { start: number, end: number } | undefined
  if node.$loc
    return { start: node.$loc.pos, end: node.$loc.pos + (node.$loc.length or 0) }

  var lo = Infinity
  var hi = -Infinity
  walkAst node, (child) ->
    return unless child?.$loc
    lo = Math.min(lo, child.$loc.pos)
    hi = Math.max(hi, child.$loc.pos + (child.$loc.length or 0))

  return undefined unless hi > lo
  { start: lo, end: hi }

export function collectStringRanges(ast: any): { start: number, end: number }[]
  ranges: { start: number, end: number }[] := []
  walkAst ast, (node) ->
    return unless node? and typeof node is "object"
    // Regex literals are included because their contents look like code but are not.
    // A `{5,}` quantifier ends in a comma before `}`, which style/no-trailing-commas
    // would otherwise "fix" into `{5}` -- silently changing "5 or more" to "exactly
    // 5". Every rule that skips string ranges wants regex skipped for the same
    // reason, so it belongs here rather than in one rule.
    return unless node.type is "StringLiteral"
      or node.type is "TemplateLiteral"
      or node.type is "RegularExpressionLiteral"
    span := nodeSpan(node)
    ranges.push(span) if span
  ranges.sort (a, b) -> a.start - b.start

export function intersectsRange(ranges: { start: number, end: number }[], start: number, end: number): boolean
  // A zero-width insertion is only inside a comment when strictly within it.
  for range of ranges
    if start < range.end and (end > range.start or (start is end and start > range.start))
      return true
  false

export function applyEdits(source: string, edits: Fix[]): { output: string, appliedEdits: Fix[], conflicts: Fix[] }
  return { output: source, appliedEdits: [], conflicts: [] } if edits.length is 0

  sorted := [...edits].sort (a, b) -> a.start - b.start

  validEdits: Fix[] := []
  conflicts: Fix[] := []
  var lastEnd = -1

  for edit of sorted
    if edit.start < lastEnd
      conflicts.push(edit)
    else
      validEdits.push(edit)
      lastEnd = edit.end

  var result = source
  for let i = validEdits.length - 1; i >= 0; i--
    edit := validEdits[i]
    prefix := result.slice(0, edit.start)
    suffix := result.slice(edit.end)
    result = prefix + edit.replacement + suffix

  {
    output: result
    appliedEdits: validEdits
    conflicts
  }

export function detectLineEnding(source: string): string
  if source.includes("\r\n")
    "\r\n"
  else
    "\n"

export async function atomicWriteFile(filePath: string, content: string): Promise<void>
  dir := path.dirname(filePath)
  base := path.basename(filePath)
  tmpPath := path.join(dir, `.${base}.${Date.now()}.${Math.random().toString(36).slice(2)}.tmp`)
  stat := await fs.stat(filePath)
  try
    await fs.writeFile(tmpPath, content, { encoding: "utf8", mode: stat.mode })
    await fs.rename(tmpPath, filePath)
  catch err
    await fs.rm(tmpPath, { force: true })
    throw err

// Normalizes away semicolons that Civet passes straight through to emitted JS, so
// two compilations can be compared for real differences. Shared by the engine's
// "semicolon-style" output delta and by style/no-trailing-semicolons, which must
// agree exactly: a semicolon the rule believes is removable but the engine does
// not would be reported and then rejected by the equivalence gate.
//
// Only a `;` at end of line (or before a trailing comment) is stripped, and only
// at paren depth 0 so `for (;;)` headers survive.
export function normalizeSemicolonStyle(code: string): string
  var out = ""
  var i = 0
  var parenDepth = 0
  var braceDepth = 0
  while i < code.length
    ch := code[i]
    if ch is "{"
      braceDepth++
      out += ch
      i++
      continue
    if ch is "}"
      braceDepth = Math.max(0, braceDepth - 1)
      out += ch
      i++
      continue
    if ch is "/" and (code[i + 1] is "/" or code[i + 1] is "*")
      block := code[i + 1] is "*"
      end := block ? code.indexOf("*/", i + 2) : code.indexOf("\n", i + 2)
      stop := end < 0 ? code.length : (block ? end + 2 : end)
      out += code.slice(i, stop)
      i = stop
      continue
    if ch is "`"
      var j = i + 1
      while j < code.length
        break if code[j] is "`" and code[j - 1] isnt "\\"
        j++
      out += code.slice(i, Math.min(j + 1, code.length))
      i = j + 1
      continue
    if ch is '"' or ch is "'"
      quote := ch
      var j = i + 1
      var body = ""
      var closed = false
      while j < code.length
        c := code[j]
        if c is "\\"
          body += code.slice(j, j + 2)
          j += 2
          continue
        if c is quote
          closed = true
          break
        if c is "\n"
          break
        body += c
        j++
      if closed
        out += quote + body + quote
        i = j + 1
      else
        out += ch
        i++
      continue
    if ch is "("
      parenDepth++
      out += ch
      i++
      continue
    if ch is ")"
      parenDepth = Math.max(0, parenDepth - 1)
      out += ch
      i++
      continue
    // Line-final `;` inside a braced block is a statement terminator even when a
    // call's parens are still open (Civet emits callback bodies as
    // `filter((x) => { ... })`, so the whole body sits at paren depth >= 1). A
    // `for ( ;; )` separator, the one `;` that is load-bearing, never sits inside
    // braces -- there braceDepth is 0 and the guard below leaves it alone.
    if ch is ";" and (parenDepth is 0 or braceDepth > 0)
      var k = i + 1
      while k < code.length and (code[k] is " " or code[k] is "\t")
        k++
      if k >= code.length or code[k] is "\n" or code[k] is "\r"
        i = k
        continue
      if code[k] is "/" and (code[k + 1] is "/" or code[k + 1] is "*")
        i++
        if /[ \t]$/.test(out) and (code[i] is " " or code[i] is "\t")
          while i < code.length and (code[i] is " " or code[i] is "\t")
            i++
        continue
    if (ch is " " or ch is "\t") and parenDepth is 0
      var k = i + 1
      while k < code.length and (code[k] is " " or code[k] is "\t")
        k++
      if k >= code.length or code[k] is "\n" or code[k] is "\r"
        i = k
        continue
    out += ch
    i++
  out

// Normalize `const` to `let` in emitted output so a fix that only changes a
// declaration keyword can be verified. Bare `x = 1` compiles to `let x = 1` while
// `const x = 1` keeps `const`, so the byte-identical gate would otherwise reject
// every prefer-bare-assignment fix. Strings and comments are skipped, and the
// match is word-bounded, so `constant` and `"const"` are left alone.

// Index of the brace that closes the one at `open`, or -1. String and comment
// ranges are skipped, so the `}` inside a template literal's `${...}` is never
// mistaken for the closing brace of a statement block.
function findBlockClose(code: string, open: number): number
  var depth = 1
  var i = open
  while i < code.length
    ch := code[i]
    if ch is "/" and (code[i + 1] is "/" or code[i + 1] is "*")
      block := code[i + 1] is "*"
      end := block ? code.indexOf("*/", i + 2) : code.indexOf("\n", i + 2)
      return -1 if end < 0
      i = block ? end + 2 : end
      continue
    if ch is "`" or ch is '"' or ch is "'"
      quote := ch
      var j = i + 1
      while j < code.length
        if code[j] is "\\"
          j += 2
          continue
        break if code[j] is quote
        break if code[j] is "\n" and quote isnt "`"
        j++
      i = j + 1
      continue
    if ch is "{"
      depth++
    else if ch is "}"
      depth--
      return i if depth is 0
    i++
  -1

// True when `code` holds a brace, semicolon, or newline OUTSIDE string and comment
// ranges. Template-literal contents (including `${...}` expressions) count as
// inert: the scanner copies them verbatim, so a braced statement body wrapping
// `throw new Error(\`x ${y}\`)` is still provably brace-style-only.
function containsStructuralChar(code: string): boolean
  var i = 0
  while i < code.length
    ch := code[i]
    if ch is "/" and (code[i + 1] is "/" or code[i + 1] is "*")
      block := code[i + 1] is "*"
      end := block ? code.indexOf("*/", i + 2) : code.indexOf("\n", i + 2)
      return true if end < 0
      i = block ? end + 2 : end
      continue
    if ch is "`" or ch is '"' or ch is "'"
      quote := ch
      var j = i + 1
      while j < code.length
        if code[j] is "\\"
          j += 2
          continue
        break if code[j] is quote
        break if code[j] is "\n" and quote isnt "`"
        j++
      i = j + 1
      continue
    return true if ch is "{" or ch is "}" or ch is ";" or ch is "\n" or ch is "\r"
    i++
  false

export function normalizeBlockBraceStyle(code: string): string
  var out = ""
  var i = 0
  while i < code.length
    ch := code[i]
    if ch is "/" and (code[i + 1] is "/" or code[i + 1] is "*")
      block := code[i + 1] is "*"
      end := block ? code.indexOf("*/", i + 2) : code.indexOf("\n", i + 2)
      stop := end < 0 ? code.length : (block ? end + 2 : end)
      out += code.slice(i, stop)
      i = stop
      continue
    if ch is "`" or ch is '"' or ch is "'"
      quote := ch
      var j = i + 1
      while j < code.length
        if code[j] is "\\"
          j += 2
          continue
        break if code[j] is quote
        break if code[j] is "\n" and quote isnt "`"
        j++
      out += code.slice(i, Math.min(j + 1, code.length))
      i = j + 1
      continue
    if ch is "{" and /\)\s*$/.test(out)
      close := findBlockClose(code, i + 1)
      if close >= 0
        inner := code.slice(i + 1, close)
        if inner.trim().length > 0 and not containsStructuralChar(inner)
          out += inner.trim()
          i = close + 1
          continue
    out += ch
    i++
  out

// `(x: string | undefined)` vs `(x: (string | undefined))` -- Civet wraps optional
// types `T?` in parens when lowering to TypeScript `(T | undefined)`.
// Strips a paren pair whose contents hold a top-level `|` and no nested
// parens/braces/brackets, provided it is not adjacent to `&` or `[`.
//
// Consulted only for rules that declare the `type-paren-style` delta, so its
// blast radius is that rule's own edits.

export function normalizeWhitespaceStyle(code: string): string
  var out = ""
  var i = 0
  while i < code.length
    ch := code[i]
    if ch is "/" and (code[i + 1] is "/" or code[i + 1] is "*")
      block := code[i + 1] is "*"
      end := block ? code.indexOf("*/", i + 2) : code.indexOf("\n", i + 2)
      stop := end < 0 ? code.length : (block ? end + 2 : end)
      out += code.slice(i, stop)
      i = stop
      continue
    if ch is "`" or ch is '"' or ch is "'"
      quote := ch
      var j = i + 1
      while j < code.length
        if code[j] is "\\"
          j += 2
          continue
        break if code[j] is quote
        break if code[j] is "\n" and quote isnt "`"
        j++
      out += code.slice(i, Math.min(j + 1, code.length))
      i = j + 1
      continue
    if /\s/.test(ch)
      var k = i
      while k < code.length and /\s/.test(code[k])
        k++
      // Keep one space only where removing it would join two tokens.
      prev := out.slice(-1)
      next := code[k] ?? ""
      isWordChar := (c: string): boolean -> /[A-Za-z0-9_$]/.test(c)
      if isWordChar(prev) and isWordChar(next)
        out += " "
      i = k
      continue
    out += ch
    i++
  out

// `if (a) return` vs `if (a) { return }` -- the only difference between a Civet
// postfix conditional and its prefix form. Strips a brace pair that follows a `)`
// and wraps a single statement: no `;`, `{`, `}`, or newline inside.
//
// Consulted only for rules that declare the `block-brace-style` delta, so its
// blast radius is that rule's own edits. It is deliberately anchored on `) {`
// rather than any brace, so object literals keep theirs.
