import fs from "node:fs/promises"
import path from "node:path"
import type { Fix } from "./types.civet"

export function createLineColumnIndex(source: string)
  lineStarts: number[] := [0]
  for let i = 0; i < source.length; i++
    if source[i] is "\n"
      lineStarts.push(i + 1)

  (pos: number) ->
    if pos < 0
      return { line: 1, column: 1 }
    var low = 0
    var high = lineStarts.length - 1
    while low <= high
      mid := Math.floor((low + high) / 2)
      if lineStarts[mid] <= pos
        low = mid + 1
      else
        high = mid - 1
    lineIndex := high
    line := lineIndex + 1
    column := pos - lineStarts[lineIndex] + 1
    { line, column }

export function walkAst(ast: any, visitor: (node: any, parent: any) => void)
  visited := new Set<any>()

  traverse := (node: any, parent: any) ->
    return unless node? and typeof node is "object"
    return if visited.has(node)
    visited.add(node)

    visitor(node, parent)

    if Array.isArray(node)
      for child of node
        traverse(child, parent)
    else
      for key of Object.keys(node)
        continue if key is "parent"
        traverse(node[key], node)

  traverse(ast, null)

export function collectCommentRanges(ast: any): { start: number, end: number }[]
  ranges: { start: number, end: number }[] := []
  walkAst ast, (node) ->
    return unless node?.type is "Comment" and node.$loc
    ranges.push({ start: node.$loc.pos, end: node.$loc.pos + node.$loc.length })
  ranges.sort (a, b) -> a.start - b.start

// Source span of a node. String and template nodes often carry no `$loc` of their
// own — a `TemplateLiteral` holding CSS has its extent only in descendant tokens —
// so fall back to the min/max `$loc` across the subtree.
function nodeSpan(node: any): { start: number, end: number } | undefined
  if node.$loc
    return { start: node.$loc.pos, end: node.$loc.pos + (node.$loc.length or 0) }

  var lo = Infinity
  var hi = -Infinity
  walkAst node, (child) ->
    return unless child?.$loc
    lo = Math.min(lo, child.$loc.pos)
    hi = Math.max(hi, child.$loc.pos + (child.$loc.length or 0))

  return undefined unless hi > lo
  { start: lo, end: hi }

export function collectStringRanges(ast: any): { start: number, end: number }[]
  ranges: { start: number, end: number }[] := []
  walkAst ast, (node) ->
    return unless node? and typeof node is "object"
    // Regex literals are included because their contents look like code but are not.
    // A `{5,}` quantifier ends in a comma before `}`, which style/no-trailing-commas
    // would otherwise "fix" into `{5}` -- silently changing "5 or more" to "exactly
    // 5". Every rule that skips string ranges wants regex skipped for the same
    // reason, so it belongs here rather than in one rule.
    return unless node.type is "StringLiteral"
      or node.type is "TemplateLiteral"
      or node.type is "RegularExpressionLiteral"
    span := nodeSpan(node)
    ranges.push(span) if span
  ranges.sort (a, b) -> a.start - b.start

export function intersectsRange(ranges: { start: number, end: number }[], start: number, end: number): boolean
  // A zero-width insertion is only inside a comment when strictly within it.
  for range of ranges
    if start < range.end and (end > range.start or (start is end and start > range.start))
      return true
  false

export function applyEdits(source: string, edits: Fix[]): { output: string, appliedEdits: Fix[], conflicts: Fix[] }
  return { output: source, appliedEdits: [], conflicts: [] } if edits.length is 0

  sorted := [...edits].sort (a, b) -> a.start - b.start

  validEdits: Fix[] := []
  conflicts: Fix[] := []
  var lastEnd = -1

  for edit of sorted
    if edit.start < lastEnd
      conflicts.push(edit)
    else
      validEdits.push(edit)
      lastEnd = edit.end

  var result = source
  for let i = validEdits.length - 1; i >= 0; i--
    edit := validEdits[i]
    prefix := result.slice(0, edit.start)
    suffix := result.slice(edit.end)
    result = prefix + edit.replacement + suffix

  {
    output: result
    appliedEdits: validEdits
    conflicts
  }

export function detectLineEnding(source: string): string
  if source.includes("\r\n")
    "\r\n"
  else
    "\n"

export async function atomicWriteFile(filePath: string, content: string): Promise<void>
  dir := path.dirname(filePath)
  base := path.basename(filePath)
  tmpPath := path.join(dir, `.${base}.${Date.now()}.${Math.random().toString(36).slice(2)}.tmp`)
  stat := await fs.stat(filePath)
  try
    await fs.writeFile(tmpPath, content, { encoding: "utf8", mode: stat.mode })
    await fs.rename(tmpPath, filePath)
  catch err
    await fs.rm(tmpPath, { force: true })
    throw err

// Normalizes away semicolons that Civet passes straight through to emitted JS, so
// two compilations can be compared for real differences. Shared by the engine's
// "semicolon-style" output delta and by style/no-trailing-semicolons, which must
// agree exactly: a semicolon the rule believes is removable but the engine does
// not would be reported and then rejected by the equivalence gate.
//
// Only a `;` at end of line (or before a trailing comment) is stripped, and only
// at paren depth 0 so `for (;;)` headers survive.
export function normalizeSemicolonStyle(code: string): string
  var out = ""
  var i = 0
  var parenDepth = 0
  var braceDepth = 0
  while i < code.length
    ch := code[i]
    if ch is "{"
      braceDepth++
      out += ch
      i++
      continue
    if ch is "}"
      braceDepth = Math.max(0, braceDepth - 1)
      out += ch
      i++
      continue
    if ch is "/" and (code[i + 1] is "/" or code[i + 1] is "*")
      block := code[i + 1] is "*"
      end := block ? code.indexOf("*/", i + 2) : code.indexOf("\n", i + 2)
      stop := end < 0 ? code.length : (block ? end + 2 : end)
      out += code.slice(i, stop)
      i = stop
      continue
    if ch is "`"
      var j = i + 1
      while j < code.length
        break if code[j] is "`" and code[j - 1] isnt "\\"
        j++
      out += code.slice(i, Math.min(j + 1, code.length))
      i = j + 1
      continue
    if ch is '"' or ch is "'"
      quote := ch
      var j = i + 1
      var body = ""
      var closed = false
      while j < code.length
        c := code[j]
        if c is "\\"
          body += code.slice(j, j + 2)
          j += 2
          continue
        if c is quote
          closed = true
          break
        if c is "\n"
          break
        body += c
        j++
      if closed
        out += quote + body + quote
        i = j + 1
      else
        out += ch
        i++
      continue
    if ch is "("
      parenDepth++
      out += ch
      i++
      continue
    if ch is ")"
      parenDepth = Math.max(0, parenDepth - 1)
      out += ch
      i++
      continue
    // Line-final `;` inside a braced block is a statement terminator even when a
    // call's parens are still open (Civet emits callback bodies as
    // `filter((x) => { ... })`, so the whole body sits at paren depth >= 1). A
    // `for ( ;; )` separator, the one `;` that is load-bearing, never sits inside
    // braces -- there braceDepth is 0 and the guard below leaves it alone.
    if ch is ";" and (parenDepth is 0 or braceDepth > 0)
      var k = i + 1
      while k < code.length and (code[k] is " " or code[k] is "\t")
        k++
      if k >= code.length or code[k] is "\n" or code[k] is "\r"
        i = k
        continue
      if braceDepth > 0 and code[k] is "}"
        i++
        continue
      if code[k] is "/" and (code[k + 1] is "/" or code[k + 1] is "*")
        i++
        if /[ \t]$/.test(out) and (code[i] is " " or code[i] is "\t")
          while i < code.length and (code[i] is " " or code[i] is "\t")
            i++
        continue
    if (ch is " " or ch is "\t") and parenDepth is 0
      var k = i + 1
      while k < code.length and (code[k] is " " or code[k] is "\t")
        k++
      if k >= code.length or code[k] is "\n" or code[k] is "\r"
        i = k
        continue
    out += ch
    i++
  out

// Normalize `const` to `let` in emitted output so a fix that only changes a
// declaration keyword can be verified. Bare `x = 1` compiles to `let x = 1` while
// `const x = 1` keeps `const`, so the byte-identical gate would otherwise reject
// every prefer-bare-assignment fix. Strings and comments are skipped, and the
// match is word-bounded, so `constant` and `"const"` are left alone.

// Index of the brace that closes the one at `open`, or -1. String and comment
// ranges are skipped, so the `}` inside a template literal's `${...}` is never
// mistaken for the closing brace of a statement block.
function findBlockClose(code: string, open: number): number
  var depth = 1
  var i = open
  while i < code.length
    ch := code[i]
    if ch is "/" and (code[i + 1] is "/" or code[i + 1] is "*")
      block := code[i + 1] is "*"
      end := block ? code.indexOf("*/", i + 2) : code.indexOf("\n", i + 2)
      return -1 if end < 0
      i = block ? end + 2 : end
      continue
    if ch is "`" or ch is '"' or ch is "'"
      quote := ch
      var j = i + 1
      while j < code.length
        if code[j] is "\\"
          j += 2
          continue
        break if code[j] is quote
        break if code[j] is "\n" and quote isnt "`"
        j++
      i = j + 1
      continue
    if ch is "{"
      depth++
    else if ch is "}"
      depth--
      return i if depth is 0
    i++
  -1

// True when `code` holds a brace, semicolon, or newline OUTSIDE string and comment
// ranges. Template-literal contents (including `${...}` expressions) count as
// inert: the scanner copies them verbatim, so a braced statement body wrapping
// `throw new Error(\`x ${y}\`)` is still provably brace-style-only.
function containsStructuralChar(code: string): boolean
  var i = 0
  while i < code.length
    ch := code[i]
    if ch is "/" and (code[i + 1] is "/" or code[i + 1] is "*")
      block := code[i + 1] is "*"
      end := block ? code.indexOf("*/", i + 2) : code.indexOf("\n", i + 2)
      return true if end < 0
      i = block ? end + 2 : end
      continue
    if ch is "`" or ch is '"' or ch is "'"
      quote := ch
      var j = i + 1
      while j < code.length
        if code[j] is "\\"
          j += 2
          continue
        break if code[j] is quote
        break if code[j] is "\n" and quote isnt "`"
        j++
      i = j + 1
      continue
    return true if ch is "{" or ch is "}" or ch is ";" or ch is "\n" or ch is "\r"
    i++
  false

export function normalizeBlockBraceStyle(code: string): string
  var out = ""
  var i = 0
  while i < code.length
    ch := code[i]
    if ch is "/" and (code[i + 1] is "/" or code[i + 1] is "*")
      block := code[i + 1] is "*"
      end := block ? code.indexOf("*/", i + 2) : code.indexOf("\n", i + 2)
      stop := end < 0 ? code.length : (block ? end + 2 : end)
      out += code.slice(i, stop)
      i = stop
      continue
    if ch is "`" or ch is '"' or ch is "'"
      quote := ch
      var j = i + 1
      while j < code.length
        if code[j] is "\\"
          j += 2
          continue
        break if code[j] is quote
        break if code[j] is "\n" and quote isnt "`"
        j++
      out += code.slice(i, Math.min(j + 1, code.length))
      i = j + 1
      continue
    if ch is "{" and /(?:\)|\belse)\s*$/.test(out)
      close := findBlockClose(code, i + 1)
      if close >= 0
        inner := code.slice(i + 1, close)
        if inner.trim().length > 0 and not containsStructuralChar(inner)
          out += inner.trim()
          i = close + 1
          continue
    out += ch
    i++
  out

// `(x: string | undefined)` vs `(x: (string | undefined))` -- Civet wraps optional
// types `T?` in parens when lowering to TypeScript `(T | undefined)`.
// Strips a paren pair whose contents hold a top-level `|` and no nested
// parens/braces/brackets, provided it is not adjacent to `&` or `[`.
//
// Consulted only for rules that declare the `type-paren-style` delta, so its
// blast radius is that rule's own edits.

// Normalize a trailing comma from emitted code while leaving strings, comments,
// and array elisions untouched. Used when a source rewrite changes only whether
// Civet's layout emits the comma before a closing delimiter.
export function normalizeTrailingCommaStyle(code: string): string
  var out = ""
  var i = 0
  while i < code.length
    ch := code[i]
    if ch is "/" and (code[i + 1] is "/" or code[i + 1] is "*")
      block := code[i + 1] is "*"
      end := block ? code.indexOf("*/", i + 2) : code.indexOf("\n", i + 2)
      stop := end < 0 ? code.length : (block ? end + 2 : end)
      out += code.slice(i, stop)
      i = stop
      continue
    if ch is "`" or ch is '"' or ch is "'"
      quote := ch
      var j = i + 1
      while j < code.length
        if code[j] is "\\"
          j += 2
          continue
        break if code[j] is quote
        break if code[j] is "\n" and quote isnt "`"
        j++
      out += code.slice(i, Math.min(j + 1, code.length))
      i = j + 1
      continue
    if ch is ","
      var k = i + 1
      while k < code.length and /\s/.test(code[k])
        k++
      // Scan back by hand: trimming `out` here would copy the whole string once
      // per comma.
      var back = out.length - 1
      back-- while back >= 0 and /\s/.test(out[back])
      prevNonWs := back >= 0 ? out[back] : ""
      if k < code.length and ")]}".includes(code[k]) and prevNonWs isnt ","
        i++
        continue
    out += ch
    i++
  out

export function normalizeWhitespaceStyle(code: string): string
  var out = ""
  var i = 0
  while i < code.length
    ch := code[i]
    // Strings, templates, comments and REGEX literals are copied verbatim. Regexes
    // matter: `/```shot\n[^`]*```/g` holds seven backticks, which read as a template
    // literal flip the string state for the rest of the file and keep whitespace on
    // one side of a comparison that the other side had stripped.
    literalEnd := jsLiteralEnd(code, i)
    if literalEnd >= 0
      out += code.slice(i, literalEnd)
      i = literalEnd
      continue
    if /\s/.test(ch)
      var k = i
      while k < code.length and /\s/.test(code[k])
        k++
      // Keep one space only where removing it would join two tokens.
      prev := out.slice(-1)
      next := code[k] ?? ""
      isWordChar := (c: string): boolean -> /[A-Za-z0-9_$]/.test(c)
      if isWordChar(prev) and isWordChar(next)
        out += " "
      i = k
      continue
    out += ch
    i++
  out

// `x?` lowers to `(x != null)` where the comparison it replaces was written bare:
// `a := foo != null` emits `foo != null`, `a := foo?` emits `(foo != null)`. Strip
// that pair, but only where nothing outside it can bind tighter than `!=` -- so
// `b + (x != null)` and `y == (x != null)` keep theirs, and a rewrite that changed
// the grouping still fails the gate.
export function normalizeExistentialParenStyle(code: string): string
  code.replace(
    /(^|[(\[{,:?;]|&&|\|\||\?\?|[^=!<>]=|=>|\breturn)(\s*)\(([^()\n]+?) (!=|==) null\)(?=\s*(?:$|[)\]},;:?]|&&|\|\||\?\?))/gm
    (_whole, before, space, operand, operator) -> `${before}${space}${operand} ${operator} null`
  )

const REGEX_AFTER_KEYWORD = new Set(["return", "typeof", "case", "do", "else", "in", "of", "new", "delete", "void", "throw", "instanceof", "yield", "await"])

// Index just past the string, template, comment or regex literal that starts at
// `i`, or -1 when `i` does not start one. Template substitutions are scanned for
// their own matching brace so a backtick inside `${…}` does not end the literal.
function jsLiteralEnd(code: string, i: number): number
  ch := code[i]
  if ch is '"' or ch is "'"
    var j = i + 1
    while j < code.length
      if code[j] is "\\"
        j += 2
        continue
      return j + 1 if code[j] is ch or code[j] is "\n"
      j++
    return code.length
  if ch is "`"
    var j = i + 1
    while j < code.length
      if code[j] is "\\"
        j += 2
        continue
      return j + 1 if code[j] is "`"
      if code[j] is "$" and code[j + 1] is "{"
        close := jsMatchClose(code, j + 1)
        return code.length if close < 0
        j = close + 1
        continue
      j++
    return code.length
  if ch is "/"
    if code[i + 1] is "/"
      end := code.indexOf("\n", i + 2)
      return end < 0 ? code.length : end
    if code[i + 1] is "*"
      end := code.indexOf("*/", i + 2)
      return end < 0 ? code.length : end + 2
    // A slash starts a regex only where an operand is expected. Not after `<` or `}`
    // and not before `>`: in emitted JSX those are `</div>` and `<Foo a={b} />`.
    return -1 if code[i + 1] is ">"
    var back = i - 1
    back-- while back >= 0 and /\s/.test(code[back])
    unless back < 0 or "(,=:[!&|?{;+-*%>~^".includes(code[back])
      // After a word, a slash divides -- unless the word is a keyword that takes an
      // operand: `return /"/.test(s)` holds a regex, and reading its quote as a
      // string would flip the literal state for the rest of the file.
      var wordStart = back + 1
      wordStart-- while wordStart > 0 and /[\w$]/.test(code[wordStart - 1])
      word := code.slice(wordStart, back + 1)
      return -1 unless REGEX_AFTER_KEYWORD.has(word) and not /[.\w$]/.test(code[wordStart - 1] ?? "")
    var j = i + 1
    var inClass = false
    while j < code.length and code[j] isnt "\n"
      if code[j] is "\\"
        j += 2
        continue
      if code[j] is "[" then inClass = true
      else if code[j] is "]" then inClass = false
      else if code[j] is "/" and not inClass then return j + 1
      j++
  -1

// Index of the bracket that closes the one at `open`, or -1 when unbalanced.
function jsMatchClose(code: string, open: number): number
  var depth = 0
  var i = open
  while i < code.length
    end := jsLiteralEnd(code, i)
    if end >= 0
      i = end
      continue
    ch := code[i]
    if ch is "(" or ch is "[" or ch is "{"
      depth++
    else if ch is ")" or ch is "]" or ch is "}"
      depth--
      return i if depth is 0
    i++
  -1

// `code` with every literal and every bracketed group blanked to spaces, so a search
// for an operator sees only the ones at depth 0.
function topLevelText(code: string): string
  var out = ""
  var depth = 0
  var i = 0
  while i < code.length
    end := jsLiteralEnd(code, i)
    if end >= 0
      out += " ".repeat(end - i)
      i = end
      continue
    ch := code[i]
    if ch is "(" or ch is "[" or ch is "{"
      depth++
      out += " "
    else if ch is ")" or ch is "]" or ch is "}"
      depth--
      out += " "
    else
      out += depth is 0 ? ch : " "
    i++
  out

// `f => x` emits `f(() => x)`, but `f (=> x)` -- an implicit call whose argument is a
// parenthesised arrow -- emits `f((() => x))`. The extra pair is a parenthesised
// expression wrapped around a complete arrow, so dropping it cannot change what the
// program does. This delta licenses exactly that and nothing else: the wrapper must
// open at `((`, hold a single arrow (no top-level comma, or `((() => a, b))` would
// become two arguments), and be closed directly by the outer paren. Anything it
// cannot prove is left alone, which makes the engine's comparison fail rather than
// pass.
const ARROW_HEAD = /^(?:async\s+)?(?:\([^()]*\)|[A-Za-z_$][\w$]*)\s*=>/

export function normalizeArrowParenStyle(code: string): string
  var out = ""
  var i = 0
  while i < code.length
    lit := jsLiteralEnd(code, i)
    if lit >= 0
      out += code.slice(i, lit)
      i = lit
      continue
    if code[i] is "("
      var wrapper = i + 1
      wrapper++ while wrapper < code.length and /\s/.test(code[wrapper])
      if code[wrapper] is "("
        wrapperEnd := jsMatchClose(code, wrapper)
        if wrapperEnd > 0
          var outerEnd = wrapperEnd + 1
          outerEnd++ while outerEnd < code.length and /\s/.test(code[outerEnd])
          inner := code.slice(wrapper + 1, wrapperEnd).trim()
          if code[outerEnd] is ")" and ARROW_HEAD.test(inner) and not topLevelText(inner).includes(",")
            // Keep the layout around the wrapper (`f(\n  (() => x))` keeps its break);
            // only the pair itself, and any padding inside it, goes.
            out += code.slice(i, wrapper) + normalizeArrowParenStyle(inner) + code.slice(wrapperEnd + 1, outerEnd) + ")"
            i = outerEnd + 1
            continue
    out += code[i]
    i++
  out

// `return if c then a else b` emits `return (c? a : b)`; the same words as a
// function's last statement emit `if (c) { return a} else return b`. One program,
// two spellings, so the ternary is canonicalized to Civet's if/else layout -- but
// only a ternary this scan can split without doubt: one top-level `?` and `:` pair,
// a condition without an assignment or arrow (in `a = b ? c : d` the `?` belongs to
// the right-hand side), and an alternative without a comma (`c ? a : b, d` returns
// `d`). Anything else is copied as-is, so a rewrite it cannot prove fails the gate.
export function normalizeConditionalReturnStyle(code: string): string
  var out = ""
  var i = 0
  while i < code.length
    lit := jsLiteralEnd(code, i)
    if lit >= 0
      out += code.slice(i, lit)
      i = lit
      continue
    if code.startsWith("return (", i) and not /[\w$.]/.test(code[i - 1] ?? "")
      open := i + "return ".length
      close := jsMatchClose(code, open)
      parts := close > 0 ? splitTernary(code.slice(open + 1, close)) : undefined
      if parts?
        [test, consequent, alternate] := parts.map (part) -> normalizeConditionalReturnStyle(unwrapBranch(part.trim()))
        out += `if (${test}) { return ${consequent}} else return ${alternate}`
        i = close + 1
        continue
    out += code[i]
    i++
  out

// The ternary parenthesizes every branch that is not a bare name, call or literal
// (`c? (a || b) : (-d)`) unless the branch already is a parenthesized group; after
// `return` the same values are bare. That added pair is grouping only, so it goes --
// except around an object literal, which keeps its parens after `return` too.
function unwrapBranch(text: string): string
  return text unless fullyParenthesized(text)
  inner := text.slice(1, -1).trim()
  return text if inner.startsWith("{") or fullyParenthesized(inner)
  inner

function fullyParenthesized(text: string): boolean
  text.startsWith("(") and jsMatchClose(text, 0) is text.length - 1

// `[test, consequent, alternate]` of a ternary with exactly one top-level `?` and
// `:`, or undefined. `?.` (unless a digit follows) and `??` are not the operator.
function splitTernary(inner: string): string[] | undefined
  var depth = 0
  var question = -1
  var colon = -1
  var i = 0
  while i < inner.length
    lit := jsLiteralEnd(inner, i)
    if lit >= 0
      i = lit
      continue
    ch := inner[i]
    if "([{".includes(ch)
      depth++
    else if ")]}".includes(ch)
      depth--
    else if depth is 0
      if ch is "?"
        next := inner[i + 1] ?? ""
        if next is "?"
          i += 2
          continue
        unless next is "." and not /\d/.test(inner[i + 2] ?? "")
          return undefined if question >= 0
          question = i
      else if ch is ":"
        return undefined if question < 0 or colon >= 0
        colon = i
      else if ch is ","
        return undefined
      else if ch is "=" and question < 0
        // `==`, `===`, `!=`, `!==`, `<=`, `>=` compare; a lone `=` or `=>` does not.
        prev := inner[i - 1] ?? ""
        next := inner[i + 1] ?? ""
        return undefined if next is ">" or not ("=!<>".includes(prev) or next is "=")
    i++
  return undefined unless question > 0 and colon > question and colon < inner.length - 1
  test := inner.slice(0, question)
  return undefined if /^\s*$/.test(test) or /(?<![\w$])(?:yield|async)(?![\w$])/.test(test)
  [test, inner.slice(question + 1, colon), inner.slice(colon + 1)]

// Canonicalize the equivalent JS spellings `a !== b` and `!(a === b)`. This
// bounded delta is used only by prefer-unless for a whole-condition rewrite.
export function normalizeInequalityStyle(code: string): string
  code.replace(/!\(\s*([^()]*?)\s*===\s*([^()]*?)\s*\)/g, (_whole, left, right) -> `${left.trim()} !== ${right.trim()}`)

// Treat empty constructor call parentheses as syntax sugar while preserving
// grouping when a member/index access follows the constructed value.
export function normalizeNewCallStyle(code: string): string
  // The `(` must open a grouping, not a call's argument list: in `c ? f(new X) : y`
  // the `(new X)` is followed by `:` too, and unwrapping it would eat the callee.
  out := code.replace(/(?<![\w$)\]])\(new\s+([A-Za-z_$][\w$]*(?:\.[A-Za-z_$][\w$]*)*)\)(?=\s*(?:\.|\[|:))/g, "new $1()")
  out.replace(/\bnew\s+([A-Za-z_$][\w$]*(?:\.[A-Za-z_$][\w$]*)*)\(\)(?!\s*(?:\.|\[))/g, "new $1")

// Canonicalize only a one-parameter arrow whose body is a direct property chain,
// the exact shape that placeholder shorthand replaces. This is intentionally
// narrower than a general arrow/parameter normalizer.
export function normalizePlaceholderParamStyle(code: string): string
  code.replace(/(?:\(([A-Za-z_$][\w$]*)\)\s*=>\s*\1|\$\s*=>\s*\$)((?:\.[A-Za-z_$][\w$]*)+)/g, (_whole, _name, path) -> `$ => $${path}`)

// Civet range loops lower to a hidden counter plus a per-iteration binding. This
// narrow normalizer maps that generated wrapper back to the equivalent C-style
// loop header so guarded range rewrites can pass the compiler-output gate. The
// `;` after the alias is optional because `semicolon-style` runs first when
// several rules' deltas are combined, and has already removed it.
export function normalizeRangeLoopStyle(code: string): string
  lowered := code.replace(/for \(let ([A-Za-z_$][A-Za-z0-9_$]*) = ([^;]+); \1 (<=|>=|<|>) ([^;]+); (?:(?:\+\+|--)\1|\1(?:\+\+|--))\) \{const ([A-Za-z_$][A-Za-z0-9_$]*) = \1;?/g, (_whole, _counter, start, operator, bound, name) ->
    canonicalStart := start.trim().replace(/^\((.+) \+ 1\) \+ -1$/, "$1")
    step := if operator is "<" or operator is "<=" then "++" else "--"
    `for (let ${name} = ${canonicalStart}; ${name} ${operator} ${bound.trim()}; ${name}${step}) {`
  )
  renameUnusedLoopCounters(lowered)

// `for (let i = 0; i < n; i++) {…}` and `for (let _ = 0; _ < n; _++) {…}` are the same
// loop when the body never mentions the counter: only a name nobody reads changed.
// Both spellings are canonicalized to `_`, but only where the body mentions neither
// the counter nor `_` itself -- a body that reads either keeps its own name, so a
// rewrite that renamed a counter somebody uses still fails the gate.
function renameUnusedLoopCounters(code: string): string
  var out = ""
  var last = 0
  re := /for \(let ([A-Za-z_$][A-Za-z0-9_$]*) = ([^;]+); \1 (<=|>=|<|>) ([^;]+); ((?:\+\+|--)?)\1((?:\+\+|--)?)\) \{/g
  var match: RegExpExecArray | null = null
  while (match = re.exec(code)) !== null
    name := match[1]!
    continue if name is "_"
    close := findBlockClose(code, match.index + match[0].length)
    continue if close < 0
    mentions := (text: string, id: string): boolean ->
      new RegExp(`(?<![\\w$])${id.replace(/\$/g, "\\$")}(?![\\w$])`).test(text)
    body := code.slice(match.index + match[0].length, close)
    continue if mentions(body, name) or mentions(body, "_") or mentions(match[2]! + " " + match[4]!, "_")
    renamed := match[0].replace(new RegExp(`(?<![\\w$])${name.replace(/\$/g, "\\$")}(?![\\w$])`, "g"), () -> "_")
    out += code.slice(last, match.index) + renamed
    last = match.index + match[0].length
  out + code.slice(last)

// Canonicalize `const f = (...) => { ... }` as `function f(...) { ... }` only
// for the declaration shape that the guarded function-declaration rule proposes.
// Strings, comments, nested braces, and nested declarations are kept intact.
export function normalizeFunctionDeclarationStyle(code: string): string
  skipQuoted := (start: number): number ->
    quote := code[start]
    var i = start + 1
    while i < code.length
      if code[i] is "\\"
        i += 2
        continue
      if code[i] is quote
        return i + 1
      i++
    code.length

  skipComment := (start: number): number ->
    if code[start + 1] is "/"
      end := code.indexOf("\n", start + 2)
      return if end < 0 then code.length else end
    end := code.indexOf("*/", start + 2)
    if end < 0 then code.length else end + 2

  skipSpace := (start: number): number ->
    var i = start
    while i < code.length and /\s/.test(code[i])
      i++
    i

  readWord := (start: number): { value: string, end: number } | undefined ->
    return undefined unless /[A-Za-z_$]/.test(code[start] ?? "")
    var end = start + 1
    end++ while end < code.length and /[A-Za-z0-9_$]/.test(code[end])
    { value: code.slice(start, end), end }

  matching := (start: number, open: string, close: string): number ->
    var depth = 0
    var i = start
    while i < code.length
      ch := code[i]
      if ch is "'" or ch is "\"" or ch is "`"
        i = skipQuoted(i)
        continue
      if ch is "/" and (code[i + 1] is "/" or code[i + 1] is "*")
        i = skipComment(i)
        continue
      if ch is open
        depth++
      else if ch is close
        depth--
        return i if depth is 0
      i++
    -1

  parseArrowDeclaration := (constPos: number): any ->
    afterConst := constPos + 5
    return undefined if /[A-Za-z0-9_$]/.test(code[constPos - 1] ?? "") or /[A-Za-z0-9_$]/.test(code[afterConst] ?? "")
    nameStart := skipSpace(afterConst)
    namePart := readWord(nameStart)
    return undefined unless namePart?
    equalsPos := skipSpace(namePart.end)
    return undefined unless code[equalsPos] is "=" and code[equalsPos + 1] isnt "=" and code[equalsPos + 1] isnt ">"
    var paramsStart = skipSpace(equalsPos + 1)
    var asyncPrefix = ""
    asyncWord := readWord(paramsStart)
    if asyncWord?.value is "async"
      asyncPrefix = "async "
      paramsStart = skipSpace(asyncWord.end)
    var typeParameters = ""
    if code[paramsStart] is "<"
      typeParametersEnd := matching(paramsStart, "<", ">")
      return undefined if typeParametersEnd < 0
      typeParameters = code.slice(paramsStart, typeParametersEnd + 1)
      paramsStart = skipSpace(typeParametersEnd + 1)
    return undefined unless code[paramsStart] is "("
    paramsEnd := matching(paramsStart, "(", ")")
    return undefined if paramsEnd < 0
    var arrowPos = -1
    var roundDepth = 0
    var squareDepth = 0
    var braceDepth = 0
    var scan = paramsEnd + 1
    while scan < code.length
      ch := code[scan]
      if ch is "'" or ch is "\"" or ch is "`"
        scan = skipQuoted(scan)
        continue
      if ch is "/" and (code[scan + 1] is "/" or code[scan + 1] is "*")
        scan = skipComment(scan)
        continue
      if code.slice(scan, scan + 2) is "=>" and roundDepth is 0 and squareDepth is 0 and braceDepth is 0
        arrowPos = scan
        break
      if ch is "("
        roundDepth++
      else if ch is ")"
        roundDepth--
      else if ch is "["
        squareDepth++
      else if ch is "]"
        squareDepth--
      else if ch is "{"
        braceDepth++
      else if ch is "}"
        braceDepth--
      scan++
    return undefined if arrowPos < 0
    // Only a return type may sit between the parameter list and `=>`. Without
    // this, `const x = (a as T).b` reads as a parameter list and the scan runs on
    // to the next arrow in the file, however far away.
    between := code.slice(paramsEnd + 1, arrowPos).trim()
    return undefined unless between.length is 0 or (between.startsWith(":") and not /[;\n]/.test(between))
    bodyStart := skipSpace(arrowPos + 2)
    return undefined unless code[bodyStart] is "{"
    bodyEnd := matching(bodyStart, "{", "}")
    return undefined if bodyEnd < 0

    var declarationStart = constPos
    before := skipSpaceBackward(code, constPos)
    exportWord := findPreviousWord(code, before)
    var exportPrefix = ""
    if exportWord?.value is "export" and code.slice(exportWord.end, constPos).trim().length is 0
      declarationStart = exportWord.start
      exportPrefix = "export "

    body := normalizeFunctionDeclarationStyle(code.slice(bodyStart, bodyEnd + 1))
    returnType := code.slice(paramsEnd + 1, arrowPos).trim()
    returnTypeSpace := returnType.length > 0 and not returnType.startsWith(":") ? " " : ""
    canonicalTypeParameters := typeParameters.replace(/,\s*>$/, ">")
    replacement := `${exportPrefix}${asyncPrefix}function ${namePart.value}${canonicalTypeParameters}${code.slice(paramsStart, paramsEnd + 1)}${returnTypeSpace}${returnType} ${body}`
    { start: declarationStart, end: bodyEnd + 1, replacement }

  skipSpaceBackward := (value: string, end: number): number ->
    var i = end
    while i > 0 and /\s/.test(value[i - 1])
      i--
    i

  findPreviousWord := (value: string, end: number): any ->
    var start = end
    while start > 0 and /[A-Za-z0-9_$]/.test(value[start - 1])
      start--
    return undefined if start is end
    { value: value.slice(start, end), start, end }

  var out = ""
  var last = 0
  var i = 0
  while i < code.length
    ch := code[i]
    if ch is "'" or ch is "\"" or ch is "`"
      i = skipQuoted(i)
      continue
    if ch is "/" and (code[i + 1] is "/" or code[i + 1] is "*")
      i = skipComment(i)
      continue
    if code.startsWith("const", i)
      item := parseArrowDeclaration(i)
      if item?
        out += code.slice(last, item.start) + item.replacement
        last = item.end
        i = item.end
        continue
    i++
  out + code.slice(last)

// `if (a) return` vs `if (a) { return }` -- the only difference between a Civet
// postfix conditional and its prefix form. Strips a brace pair that follows a `)`
// and wraps a single statement: no `;`, `{`, `}`, or newline inside.
//
// Consulted only for rules that declare the `block-brace-style` delta, so its
// blast radius is that rule's own edits. It is deliberately anchored on `) {`
// rather than any brace, so object literals keep theirs.
